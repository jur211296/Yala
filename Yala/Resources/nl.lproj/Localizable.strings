// Tutorial step descriptions (re-expanded)
"tutorials.createAccount.step0.desc" = "In je profiel kies je de sectie Rekeningen en tik je om een nieuwe rekening aan te maken.";
"tutorials.createAccount.step1.desc" = "Je kunt ook direct vanaf het Paneel een rekening aanmaken via de kaart 'Nieuwe rekening toevoegen'.";
"tutorials.createAccount.step2.desc" = "Vul de gegevens van je nieuwe rekening in en tik op Opslaan.";
"tutorials.createCategories.step0.desc" = "In je profiel kies je de sectie Categorieën en maak je een nieuwe categorie aan.";
"tutorials.createCategories.step1.desc" = "Onthoud dat er altijd subcategorieën aan een categorie gekoppeld moeten zijn om hem aan te maken.";
"tutorials.createCategories.step2.desc" = "Subcategorieën maken werkt net zoals categorieën: geef hem een naam, selecteer de aard en pas optioneel het icoon aan.";
"tutorials.createCategories.step3.desc" = "Pas het icoon en de kleur van je categorie aan zoals jij wilt, wanneer je maar wilt.";
"tutorials.createTags.step0.desc" = "In je profiel kies je de sectie Labels en maak je een nieuw label aan.";
"tutorials.createTags.step1.desc" = "Pas je label aan naar jouw smaak: geef het een naam, icoon en kleur.";
"tutorials.createRecord.step0.desc" = "Tik op het paneel op de +-knop. Als je Yala Pro hebt, kies je Handmatig.";
"tutorials.createRecord.step1.desc" = "Je kunt uitgaven, inkomsten en zelfs overschrijvingen tussen rekeningen boeken. Wisselkoersen worden automatisch en in realtime berekend.";
"tutorials.createRecord.step2.desc" = "Vul de verplichte velden in: bedrag, rekening en subcategorie. Je kunt ook een omschrijving en labels toevoegen.";
"tutorials.createRecord.step3.desc" = "Gebruik snelle shortcuts: @ voor rekening, ! voor categorie en # voor label. Begin met typen om je zoekopdracht binnen elke shortcut te verfijnen.";
"tutorials.importData.step0.desc" = "In je profiel kies je de sectie Gegevens importeren.";
"tutorials.importData.step1.desc" = "Je kunt zo vaak je wilt CSV of Excel importeren met het standaardsjabloon, dat je daar kunt downloaden. Bij gegevens in meerdere valuta's vraagt de app je per valuta een rekening te kiezen.";
"tutorials.createBudgets.step0.desc" = "In het menu kies je Planning en zorg je dat je op het tabblad Budgetten staat. Gebruik de +-knop om er een nieuw aan te maken.";
"tutorials.createBudgets.step1.desc" = "Geef hem een naam, bedrag en bepaal de periode: dagelijks, maandelijks, jaarlijks of eenmalig (voor een reis, evenement, enz.). Pas aan welke rekeningen, categorieën, labels en aarden je wilt volgen. Zet meldingen aan voor waarschuwingen bij bepaalde drempels.";
"tutorials.createBudgets.step2.desc" = "Je kunt budgetten aan favorieten toevoegen om ze in de Paneel-widget te tonen. Kies maximaal 3 in jouw voorkeursvolgorde.";
"tutorials.createBudgets.step3.desc" = "Onthoud dat je altijd kunt terugkomen om je budget te bewerken door erop te tikken.";
"tutorials.createScheduledPayments.step0.desc" = "In het menu kies je Planning en zorg je dat je op het tabblad Geplande betalingen staat. Gebruik de +-knop om er een nieuwe aan te maken.";
"tutorials.createScheduledPayments.step1.desc" = "Vul de naam van je betaling, het bedrag, een notitie (optioneel), de rekening, subcategorie en labels (optioneel) in.";
"tutorials.createScheduledPayments.step2.desc" = "Selecteer de betaaldag en de frequentie. Kies wanneer de eerste betaling valt en zet meldingen aan als je op dezelfde dag of een aantal dagen vooraf gemeld wilt worden.";
"tutorials.createScheduledPayments.step3.desc" = "Vergeet de abonnementsschakelaar niet aan te zetten als het een terugkerend abonnement is.";
"tutorials.createScheduledPayments.step4.desc" = "Door op een geplande betaling te tikken zie je aankomende en al uitgevoerde betalingen, en kun je hem altijd bewerken.";
"tutorials.createFavorites.step0.desc" = "Ga naar het scherm Nieuwe transactie en tik bovenin op de ster om een nieuwe favoriet te maken.";
"tutorials.createFavorites.step1.desc" = "Vul de velden in die je vooraf ingevuld wilt hebben. De volgende keer tik je op de favoriet en zie je alle velden automatisch invullen.";
"tutorials.editPanel.step0.desc" = "Ga naar het hoofdscherm waar je je uitgavenoverzicht ziet met alle beschikbare widgets.";
"tutorials.editPanel.step1.desc" = "Je kunt aanpassen welke widgets je ziet en in welke volgorde door op de aanpasknop op het paneel te tikken.";
"tutorials.editPanel.step2.desc" = "Onthoud dat je altijd kunt terugkeren naar de standaardvolgorde door binnen 'Aanpassen' op \"Reset\" te tikken.";
"tutorials.panelFiltering.step0.desc" = "Haal het beste uit Yala's interactieve grafieken. Bijna alle panelen zijn filterbaar per categorie, aard en meer. Speel ermee en vind wat voor jou werkt.";
"tutorials.panelFiltering.step1.desc" = "Je hebt een filterbalk waarin je alle toegepaste filters ziet. Je kunt ze individueel of allemaal tegelijk verwijderen wanneer je wilt.";
"tutorials.panelFiltering.step2.desc" = "In de verschillende weergaven van de app zie je dat je naar wens kunt filteren met de grafieken.";
"tutorials.panelFiltering.step3.desc" = "Filters worden gelijkmatig op alle weergaven toegepast, zodat je allerlei statistieken ziet voor wat je ook wilt filteren.";
