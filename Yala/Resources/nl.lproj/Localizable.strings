// MARK: - FAQ
"faq.subtitle" = "Antwoorden op de meest gestelde vragen";
"faq.section.general" = "Algemeen";
"faq.section.data" = "Je gegevens";
"faq.section.pro" = "Yala Pro";
"faq.whatIsYala.q" = "Wat is Yala?";
"faq.whatIsYala.a" = "Yala is je app voor persoonlijke financiën. Hij helpt je uitgaven en inkomsten bijhouden, je geld ordenen op categorie en label, budgetten maken en duidelijke rapporten zien van hoe je financiën ervoor staan.";
"faq.howToRecord.q" = "Hoe boek ik een uitgave?";
"faq.howToRecord.a" = "Tik op de +-knop op het hoofdscherm. Je kunt het bedrag handmatig typen, dicteren met je stem of een bonnetje scannen met de camera. Yala vult de details voor je in.";
"faq.multiCurrency.q" = "Kan ik meerdere valuta's gebruiken?";
"faq.multiCurrency.a" = "Ja. Yala ondersteunt 7 valuta's (PEN, USD, EUR, MXN, COP, BRL, GBP). Stel je hoofdvaluta in en voeg secundaire valuta's toe via Instellingen > Valuta.";
"faq.changeCategory.q" = "Hoe wijzig ik de categorie van een uitgave?";
"faq.changeCategory.a" = "Open de uitgave en tik op de categorie om die te wijzigen. Voor meerdere tegelijk gebruik je bulk-bewerken: houd een boeking ingedrukt en selecteer de boekingen die je wilt aanpassen.";
"faq.importData.q" = "Kan ik mijn gegevens importeren?";
"faq.importData.a" = "Ja. Ga naar Instellingen > Importeren en upload een CSV- of Excel-bestand. Yala detecteert automatisch de kolommen en laat je rekeningen per valuta toewijzen.";
"faq.exportData.q" = "Hoe exporteer ik mijn gegevens?";
"faq.exportData.a" = "Ga naar Instellingen > Exporteren en kies CSV of Excel. Je kunt al je boekingen downloaden voor analyse in een spreadsheet of als backup.";
"faq.deleteData.q" = "Kan ik al mijn gegevens verwijderen?";
"faq.deleteData.a" = "Ja. Via Instellingen > Gegevens wissen kun je al je gegevens verwijderen. Deze actie kan niet ongedaan worden gemaakt — we raden aan eerst een backup te exporteren.";
"faq.whatIsPro.q" = "Wat zit er in Yala Pro?";
"faq.whatIsPro.a" = "Yala Pro ontgrendelt premium-functies zoals spraakinvoer, bonnetjes scannen, exclusieve thema's en meer. Bekijk alle voordelen via Instellingen > Abonnement.";
"faq.cancelSub.q" = "Hoe zeg ik mijn abonnement op?";
"faq.cancelSub.a" = "Je kunt je abonnement altijd beheren of opzeggen via Instellingen > Abonnement > Beheer in App Store. Je Pro-toegang loopt door tot het einde van de betaalde periode.";

