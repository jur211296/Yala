// MARK: - FAQ
"faq.subtitle" = "Answers naar de most common questions";
"faq.section.general" = "General";
"faq.section.data" = "Je data";
"faq.section.pro" = "Yala Pro";
"faq.whatIsYala.q" = "What is Yala?";
"faq.whatIsYala.a" = "Yala is je personal finance app. It helps je track uitgaven en inkomsten, organize je money by categorieën en labels, create budgets, en see clear reports van how je finances zijn doing.";
"faq.howToRecord.q" = "How do I boeking an uitgave?";
"faq.howToRecord.a" = "Tap de + button on de main screen. Je can type de bedrag manually, dictate by voice, van scan a receipt with de camera. Yala fills in de details voor je.";
"faq.multiCurrency.q" = "Can I use multiple currencies?";
"faq.multiCurrency.a" = "Ja. Yala supports 7 currencies (PEN, USD, EUR, MXN, COP, BRL, GBP). Set je main valuta en add secondary currencies in Instellingen > Valuta.";
"faq.changeCategory.q" = "How do I change an uitgave's categorie?";
"faq.changeCategory.a" = "Open de uitgave en tap de categorie naar change it. To change multiple at once, use bulk bewerk: long-press a boeking en selecteer de ones je want naar modify.";
"faq.importData.q" = "Can I importeer my data?";
"faq.importData.a" = "Ja. Go naar Instellingen > Importeer en upload a CSV van Excel file. Yala detects de columns automatically en lets je assign rekeningen by valuta.";
"faq.exportData.q" = "How do I exporteer my data?";
"faq.exportData.a" = "Go naar Instellingen > Exporteer en choose CSV van Excel format. Je can download all je boekingen naar analyze in a spreadsheet van keep as a backup.";
"faq.deleteData.q" = "Can I verwijder all my data?";
"faq.deleteData.a" = "Ja. In Instellingen > Wipe Data je can verwijder all je information. This action cannot be undone, so we recommend exporting a backup first.";
"faq.whatIsPro.q" = "What does Yala Pro include?";
"faq.whatIsPro.a" = "Yala Pro unlocks premium features like voice input, receipt scanning with camera, exclusive themes, en more. Je can see all benefits in Instellingen > Abonnement.";
"faq.cancelSub.q" = "How do I annuleer my abonnement?";
"faq.cancelSub.a" = "Je can manage van annuleer je abonnement anytime from Instellingen > Abonnement > Manage in App Store. Je Pro access continues until de end van de paid period.";

