<plist version="1.0">
<dict>
	<key>account.deleteConfirmMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Deze rekening heeft %d boeking. Die wordt niet verwijderd: hij blijft in Boekingen, zonder rekening. Wil je de rekening alleen niet meer zien, archiveer haar dan. Dit kan niet ongedaan worden gemaakt.</string>
			<key>other</key>
			<string>Deze rekening heeft %d boekingen. Ze worden niet verwijderd: ze blijven in Boekingen, zonder rekening. Wil je de rekening alleen niet meer zien, archiveer haar dan. Dit kan niet ongedaan worden gemaakt.</string>
		</dict>
	</dict>
	<key>category.cannotDeleteMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Deze categorie heeft een subcategorie met %d transactie. Verwijder of verplaats eerst die transactie uit de subcategorie om deze categorie te kunnen verwijderen.</string>
			<key>other</key>
			<string>Deze categorie heeft subcategorieën met %d transacties. Verwijder of verplaats eerst de transacties uit elke subcategorie om deze categorie te kunnen verwijderen.</string>
		</dict>
	</dict>
