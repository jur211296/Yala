"tutorials.createRecord.step0.desc" = "在面板上点击 + 按钮。如果你是 Yala Pro 用户,选择「手动」。";
"tutorials.createRecord.step1.desc" = "你可以记录支出、收入,甚至账户间转账。汇率会实时自动计算。";
"tutorials.createRecord.step2.desc" = "填写必填字段:金额、账户、子类别。你也可以添加描述和任意标签。";
"tutorials.createRecord.step3.desc" = "使用快捷键:@ 是账户、! 是类别、# 是标签。开始输入即可在每个快捷范围内细化搜索。";
"tutorials.importData.step0.desc" = "在你的个人资料中,选择「导入数据」版块。";
"tutorials.importData.step1.desc" = "你可以按默认模板多次导入 CSV 或 Excel,模板可以在那里下载。如果数据涉及多种货币,会请你为每种货币选择账户。";
"tutorials.createBudgets.step0.desc" = "在菜单选择「计划」并切到「预算」标签。用 + 按钮创建一个新预算。";
"tutorials.createBudgets.step1.desc" = "为它命名、设金额并定义周期:每日、每月、每年或一次性(用于旅行、活动等)。自定义要跟踪的账户、类别、标签和需求。如果想在某些进度获得提醒,打开通知。";
"tutorials.createBudgets.step2.desc" = "你可以把预算加到「收藏」并显示在面板小组件中。按你喜欢的顺序选择最多 3 个。";
"tutorials.createBudgets.step3.desc" = "记住你随时可以点击预算回来编辑。";
"tutorials.createScheduledPayments.step0.desc" = "在菜单选择「计划」并切到「计划付款」标签。用 + 按钮创建一个新付款。";
"tutorials.createScheduledPayments.step1.desc" = "填写付款名称、金额、备注(可选)、账户、子类别和标签(可选)。";
"tutorials.createScheduledPayments.step2.desc" = "选择付款日和频率。选择第一次付款时间,如果想在当天或前几天通知,打开通知。";
"tutorials.createScheduledPayments.step3.desc" = "如果是周期性订阅,别忘了打开「订阅」开关。";
"tutorials.createScheduledPayments.step4.desc" = "点击一笔计划付款可查看即将到来的付款、已付款,以及随时编辑。";
"tutorials.createFavorites.step0.desc" = "前往新交易页面,点击顶部的星标创建一个新收藏。";
"tutorials.createFavorites.step1.desc" = "填写你想预填的字段。下次只需点击收藏即可看到所有字段自动填好。";
"tutorials.editPanel.step0.desc" = "前往主屏幕,看到所有可用小组件的支出摘要。";
"tutorials.editPanel.step1.desc" = "点击面板上的自定义按钮即可修改要显示的小组件及其顺序。";
"tutorials.editPanel.step2.desc" = "记住:在自定义中点击「重置」即可恢复默认顺序。";
"tutorials.panelFiltering.step0.desc" = "充分利用 Yala 的交互式图表。几乎所有面板都可按类别、需求等筛选。多多尝试,找到最适合你的。";
"tutorials.panelFiltering.step1.desc" = "你有一个筛选栏显示所有已应用的筛选。你随时可以单个移除或一次清除全部。";
"tutorials.panelFiltering.step2.desc" = "在应用的不同视图中,你都可以通过图表按你的喜好筛选。";
"tutorials.panelFiltering.step3.desc" = "筛选会等同地传递到所有视图,因此你可以为任意筛选目标看到各种指标。";
"tutorials.panelFiltering.step4.desc" = "在某些视图中,顶部还会有一个筛选版块,让你按喜好筛选或一键清除全部。";
"tutorials.inboxApproval.step0.desc" = "如果你是 Yala Pro 用户,用语音或图片记录时会自动跳转到草稿。使用 Apple Pay 记录快捷指令时也是。";
"tutorials.inboxApproval.step1.desc" = "只需填写必填字段并审批。交易将正常创建。";
"tutorials.inboxApproval.step2.desc" = "你也可以用语音或图片记录多笔交易。它会告诉你创建了多少草稿,并引导你到收件箱查看。";
"tutorials.inboxApproval.step3.desc" = "在收件箱中你可以审批交易、选择「稍后审批」延后查看,或直接拒绝。";
"tutorials.applePay.step0.desc" = "打开「快捷指令」应用,前往「自动化」版块。";
"tutorials.applePay.step1.desc" = "点击「新建自动化」,选择 Wallet 选项,选择要使用的卡片,然后选择「立即运行」。";
"tutorials.applePay.step2.desc" = "选择「创建新快捷指令」,在最底部搜索 Yala。在 Yala 中选择「Apple Pay 记录」快捷指令。";
"tutorials.applePay.step3.desc" = "金额选择「快捷指令输入」然后选择「金额」。商家和名称分别同样处理。关闭「运行时显示」开关。";

"tutorials.applePay.completion.title" = "Apple Pay 已连接!";
"tutorials.applePay.completion.desc" = "这样,每次用所选卡片使用 Apple Pay 都会自动记录。每笔付款都会在你的收件箱创建一个草稿。";

