// MARK: - FAQ
"faq.subtitle" = "Answers to the most common questions";
"faq.section.general" = "General";
"faq.section.data" = "你的 data";
"faq.section.pro" = "Yala Pro";
"faq.whatIsYala.q" = "What is Yala?";
"faq.whatIsYala.a" = "Yala is 你的 personal finance app. It helps 你 track expenses and 收入, organize 你的 money by categories and tags, create budgets, and see clear reports of how 你的 finances are doing.";
"faq.howToRecord.q" = "How do I 记录 an 支出?";
"faq.howToRecord.a" = "Tap the + button on the main screen. 你 can type the amount manually, dictate by voice, or scan a receipt with the camera. Yala fills in the details for 你.";
"faq.multiCurrency.q" = "Can I use multiple currencies?";
"faq.multiCurrency.a" = "Yes. Yala supports 7 currencies (PEN, USD, EUR, MXN, COP, BRL, GBP). Set 你的 main currency and add secondary currencies in 设置 > 货币.";
"faq.changeCategory.q" = "How do I change an 支出's 类别?";
"faq.changeCategory.a" = "Open the 支出 and tap the 类别 to change it. To change multiple at once, use bulk 编辑: long-press a 记录 and select the ones 你 want to modify.";
"faq.importData.q" = "Can I import my data?";
"faq.importData.a" = "Yes. Go to 设置 > Import and upload a CSV or Excel file. Yala detects the columns automatically and lets 你 assign accounts by currency.";
"faq.exportData.q" = "How do I export my data?";
"faq.exportData.a" = "Go to 设置 > Export and choose CSV or Excel format. 你 can download all 你的 records to analyze in a spreadsheet or keep as a backup.";
"faq.deleteData.q" = "Can I 删除 all my data?";
"faq.deleteData.a" = "Yes. In 设置 > Wipe Data 你 can 删除 all 你的 information. This action cannot be undone, so we recommend exporting a backup first.";
"faq.whatIsPro.q" = "What does Yala Pro include?";
"faq.whatIsPro.a" = "Yala Pro unlocks premium features like voice input, receipt scanning with camera, exclusive themes, and more. 你 can see all benefits in 设置 > 订阅.";
"faq.cancelSub.q" = "How do I 取消 my subscription?";
"faq.cancelSub.a" = "你 can manage or 取消 你的 subscription anytime from 设置 > 订阅 > Manage in App Store. 你的 Pro access continues until the end of the paid period.";

