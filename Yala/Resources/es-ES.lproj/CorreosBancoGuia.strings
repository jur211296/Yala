/*
  CorreosBancoGuia.strings
  Yala

  Guía de «Correo del banco» para quien nunca configuró un reenvío (23-nov-2026): cada paso dice dónde entrar, qué
  tocar y qué se va a ver. Más el «Volver a este paso» de `YalaStepGuide`. Tabla propia, leída con el idioma de la app
  (`L10n.CorreosBancoGuia`). Los nombres de los botones de Gmail, Outlook e iCloud son los de ESA app en este idioma.
*/

"correosGuia.guideLine" = "Se hace una sola vez, desde Safari: la app de tu correo no tiene esta opción. Toma unos minutos.";
"correosGuia.findBank" = "Antes de empezar, busca la dirección de tu banco: abre un aviso que te haya mandado y mira quién lo envía, en «De» (por ejemplo, notificaciones@tubanco.com).";

"correosGuia.copy.title" = "Copia tu dirección de Yala";
"correosGuia.copy.detail" = "Toca «Copiar dirección». No vas a ver ningún cambio: la dirección queda guardada para pegarla en tu correo. Si la pierdes, arriba, junto a tu dirección, tienes otro botón para copiarla.";

"correosGuia.gmail.add.title" = "Añade tu dirección de Yala en Gmail";
"correosGuia.gmail.add.detail" = "1. Toca «Abrir Gmail». Se abre Gmail en Safari, en la sección de reenvío. Si te lo pide, inicia sesión.\n2. Si ves la versión para móvil, toca el botón de la barra de direcciones de Safari y elige «Solicitar sitio web de escritorio».\n3. Toca «Añadir una dirección de reenvío».\n4. Mantén el dedo en el recuadro, toca «Pegar» y luego «Siguiente».\n5. Se abre una ventana: toca «Continuar» y después «Aceptar».\nNo marques «Reenviar una copia del correo entrante»: así se mandaría todo tu correo. Lo del banco lo separa el filtro del paso 4.";
"correosGuia.gmail.confirm.title" = "Confirma con el código de Gmail";
"correosGuia.gmail.confirm.waiting" = "Gmail acaba de mandar un código a tu dirección de Yala, y Yala lo recibe por ti: no tienes que buscarlo en tu correo.\n1. Espera un minuto y toca «Buscar el código».\n2. Cuando llegue, lo verás aquí mismo.";
"correosGuia.gmail.confirm.code" = "Tu código de Gmail es %@.\n1. Toca «Copiar código».\n2. Vuelve a Gmail, a la misma pantalla de reenvío.\n3. Pega el código en el recuadro de confirmación y toca «Verificar». Si no ves el recuadro, recarga la página.";
"correosGuia.gmail.filter.title" = "Crea un filtro para los avisos de tu banco";
"correosGuia.gmail.filter.detail" = "1. En Gmail, en Safari, escribe la dirección de tu banco en la barra de búsqueda de arriba.\n2. Toca el botón de opciones, a la derecha de la búsqueda, y luego «Crear filtro».\n3. Marca «Reenviarlo a» y elige tu dirección de Yala.\n4. Toca «Crear filtro».\nSi tu banco te escribe desde varias direcciones, repite estos pasos con cada una.";

"correosGuia.rule.title" = "Crea una regla para los avisos de tu banco";
"correosGuia.outlook.rule.detail" = "1. Toca «Abrir Outlook». Se abre Outlook en Safari, en la sección de reglas. Si te lo pide, inicia sesión.\n2. Toca «Agregar nueva regla» y ponle un nombre, por ejemplo «Yala».\n3. En la condición, elige «De» y escribe la dirección de tu banco.\n4. En la acción, elige «Reenviar a» y pega tu dirección de Yala.\n5. Toca «Guardar».";
"correosGuia.icloud.rule.detail" = "1. Toca «Abrir iCloud Mail». Se abre iCloud.com en Safari. Si te lo pide, inicia sesión con tu cuenta de Apple.\n2. Toca el botón de ajustes (el engranaje) y elige «Reglas».\n3. Toca «Añadir una regla».\n4. En «Si un mensaje», elige «es de» y escribe la dirección de tu banco.\n5. En «Entonces», elige «Reenviar a» y pega tu dirección de Yala.\n6. Toca «Listo».";

"correosGuia.wait.title" = "Listo: espera el próximo aviso";
"correosGuia.wait.detail" = "No tienes que hacer nada más. Cuando tu banco te mande su siguiente aviso, el movimiento llega a tu Bandeja para que lo confirmes. Si pasa un día y no llega nada, revisa que el filtro o la regla usen la misma dirección desde la que te escribe tu banco.";

"correosGuia.stepGuide.reopen" = "Volver a este paso";
"correosGuia.stepGuide.reopenHint" = "Vuelve a abrir este paso para repetirlo o terminar lo que faltó.";
