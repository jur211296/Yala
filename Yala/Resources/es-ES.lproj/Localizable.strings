"tutorials.inboxApproval.step0.desc" = "Si eres usuario Yala Pro, cuando hagas un registro por voz o imagen, automáticamente te llevará al borrador. Lo mismo si usaste el atajo «Registrar pago de Apple Pay».";
"tutorials.inboxApproval.step0.title" = "Registra con voz o imagen";
