"tutorials.createFavorites.title" = "Pagos favoritos";
"tutorials.createRecord.completion.desc" = "Registrar gastos al momento es la clave. Cuanto más registres, mejores serán tus análisis y reportes para entender tus finanzas.";
"tutorials.createRecord.completion.title" = "¡Gasto registrado!";
"tutorials.createRecord.intro.desc" = "Cada gasto que registras te ayuda a entender mejor tus finanzas.";
"tutorials.createRecord.intro.title" = "Registro manual";
"tutorials.createRecord.step0.desc" = "En el Panel, toca Nuevo registro. Para dictar o leer un recibo, toca Voz o Foto.";
"tutorials.createRecord.step0.title" = "Toca Nuevo registro";
"tutorials.createRecord.step1.desc" = "Puedes registrar gastos, ingresos e inclusive transferencias entre cuentas. Los tipos de cambio se calculan automáticamente en tiempo real.";
"tutorials.createRecord.step1.title" = "Elige el tipo de registro";
"tutorials.createRecord.step2.desc" = "Completa los campos obligatorios: monto, cuenta y subcategoría. También puedes agregar una descripción y las etiquetas que quieras.";
"tutorials.createRecord.step2.title" = "Completa los campos";
"tutorials.createRecord.step3.desc" = "Usa los atajos rápidos: @ para cuenta, ! para categoría y # para etiqueta. Empieza a escribir para afinar la búsqueda dentro de cada atajo.";
"tutorials.createRecord.step3.title" = "Usa atajos rápidos";
"tutorials.createRecord.title" = "Registrar un gasto";
