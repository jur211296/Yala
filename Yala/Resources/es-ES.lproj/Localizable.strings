"tutorials.createAccount.title" = "Crear una cuenta";
"tutorials.createBudgets.completion.desc" = "Ahora verás en tiempo real cómo va tu consumo y podrás decidir mejor si seguir haciendo esos gastos o no. Revísalo seguido para mantener el control.";
"tutorials.createBudgets.completion.title" = "¡Presupuesto activo!";
"tutorials.createBudgets.intro.desc" = "Pon límites de gasto y recibe alertas cuando estés cerca.";
"tutorials.createBudgets.intro.title" = "¿Qué es un presupuesto?";
"tutorials.createBudgets.step0.desc" = "En el menú selecciona Planificación y asegúrate de estar en la pestaña de Presupuestos. Usa el botón + para crear uno nuevo.";
"tutorials.createBudgets.step0.title" = "Abre Planificación";
"tutorials.createBudgets.step1.desc" = "Ponle nombre, monto y define el periodo: diario, mensual, anual o único (para un viaje, evento, etc). Personaliza qué cuentas, categorías, etiquetas y naturalezas quieres trackear. Activa las notificaciones si quieres avisos en ciertos umbrales.";
"tutorials.createBudgets.step1.title" = "Configura tu presupuesto";
"tutorials.createBudgets.step2.desc" = "Puedes añadir presupuestos a Favoritos para visualizarlos en el widget del Panel. Elige hasta 3 en el orden que prefieras.";
"tutorials.createBudgets.step2.title" = "Añádelo a Favoritos";
"tutorials.createBudgets.step3.desc" = "Recuerda que siempre podrás volver para editar tu presupuesto tocándolo.";
"tutorials.createBudgets.step3.title" = "Edítalo cuando quieras";
"tutorials.createBudgets.title" = "Crear presupuestos";
"tutorials.createCategories.completion.desc" = "Unas buenas categorías hacen que tus reportes sean mucho más útiles. Puedes editarlas o agregar más en cualquier momento.";
"tutorials.createCategories.completion.title" = "¡Categoría creada!";
"tutorials.createCategories.intro.desc" = "Organiza tus gastos por tipo para ver a dónde va tu dinero.";
"tutorials.createCategories.intro.title" = "¿Qué son las categorías?";
"tutorials.createCategories.step0.desc" = "En tu perfil, selecciona la sección de Categorías y crea una nueva categoría.";
"tutorials.createCategories.step0.title" = "Ve a Categorías";
"tutorials.createCategories.step1.desc" = "Recuerda que siempre debe haber subcategorías asociadas a una categoría para poder crearla.";
"tutorials.createCategories.step1.title" = "Agrega subcategorías";
"tutorials.createCategories.step2.desc" = "Crear subcategorías es tan fácil como crear categorías: ponle nombre, selecciona su naturaleza y si quieres modifica su icono.";
"tutorials.createCategories.step2.title" = "Crea subcategorías";
"tutorials.createCategories.step3.desc" = "Personaliza a tu gusto el icono y color de tu categoría cuando quieras.";
"tutorials.createCategories.step3.title" = "Personaliza tu categoría";
"tutorials.createCategories.title" = "Crear categorías";
"tutorials.createFavorites.completion.desc" = "Los favoritos te ahorran tiempo en gastos repetitivos. Puedes tener tantos como quieras y editarlos cuando necesites.";
"tutorials.createFavorites.completion.title" = "¡Favorito guardado!";
"tutorials.createFavorites.intro.desc" = "Guarda gastos frecuentes como atajos y regístralos con un toque.";
