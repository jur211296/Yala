<dict>
	<key>account.deleteConfirmMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Esta conta tem %d registo. Ele não é apagado: fica em Registos, sem conta. Se só queres deixar de a ver, arquiva-a. Não é possível desfazer.</string>
			<key>other</key>
			<string>Esta conta tem %d registos. Eles não são apagados: ficam em Registos, sem conta. Se só queres deixar de a ver, arquiva-a. Não é possível desfazer.</string>
		</dict>
	</dict>
	<key>category.cannotDeleteMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Esta categoria tem uma subcategoria com %d registo. Para a eliminar, primeiro elimina esse registo ou move-o para outra subcategoria.</string>
			<key>other</key>
			<string>Esta categoria tem subcategorias com %d registos. Para a eliminar, primeiro elimina esses registos ou move-os para outra subcategoria.</string>
		</dict>
	</dict>
