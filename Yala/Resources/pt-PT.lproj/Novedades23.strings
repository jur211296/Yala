"novedades23.duo.title" = "Feito para o iPhone Duo";
"novedades23.duo.description" = "Aberto, aproveitas o ecrã grande, com listas e detalhes lado a lado. Fechado, a Yala adapta-se ao ecrã exterior.";
"novedades23.cards.title" = "As tuas contas como cartões";
"novedades23.cards.description" = "Cria o cartão de cada conta com modelos, cores e os teus 4 últimos dígitos. Toca nele no Painel para ver o saldo, o que já foi faturado e quando pagar.";
"novedades23.groups.title" = "Grupos mais fáceis";
"novedades23.groups.description" = "Divide um recibo com uma foto ou com a voz, salda dívidas com menos pagamentos e traz os teus grupos do Splitwise ou Tricount com os mesmos saldos.";
"novedades23.records.title" = "Registos mais ágeis";
"novedades23.records.description" = "Filtra por conta ou categoria com um toque, salta de mês no calendário e transforma qualquer registo num pagamento recorrente.";
"novedades23.health.title" = "A tua nota de saúde, mais completa";
"novedades23.health.description" = "Agora também olha quanto te sobra do que entra. Toca nela no Painel para ver o que mais a faz mexer este mês.";
"novedades23.planning.title" = "Quanto podes gastar hoje";
"novedades23.planning.description" = "Cada orçamento diz-te quanto podes gastar hoje, e a Yala sugere as subscrições que encontra nos teus registos.";
"novedades23.ant.title" = "Gastos formiga";
"novedades23.ant.description" = "Vê quanto somam as tuas compras pequenas e, com «Ver projeção», como o teu mês pode terminar.";
"novedades23.hide.title" = "Oculta os teus valores";
"novedades23.hide.description" = "Toca no olho do Painel e os teus números desaparecem: ideal quando alguém está a olhar para o teu ecrã.";
