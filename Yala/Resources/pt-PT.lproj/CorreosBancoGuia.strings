/*
  CorreosBancoGuia.strings
  Yala

  Guía de «Correo del banco» para quien nunca configuró un reenvío (23-nov-2026): cada paso dice dónde entrar, qué
  tocar y qué se va a ver. Más el «Volver a este paso» de `YalaStepGuide`. Tabla propia, leída con el idioma de la app
  (`L10n.CorreosBancoGuia`). Los nombres de los botones de Gmail, Outlook e iCloud son los de ESA app en este idioma.
*/

"correosGuia.guideLine" = "Configura-se uma só vez, no Safari: a app do seu e-mail não tem essa opção. Demora poucos minutos.";
"correosGuia.findBank" = "Antes de começar, encontre o endereço do seu banco: abra um aviso que ele lhe enviou e veja quem mandou, em “De” (por exemplo, avisos@seubanco.com.br).";

"correosGuia.copy.title" = "Copie seu endereço do Yala";
"correosGuia.copy.detail" = "Toque em “Copiar endereço”. Não vai ver nenhuma alteração: o endereço fica guardado para a colar no seu e-mail. Se a perder, tem outro botão para a copiar no topo, ao lado do seu endereço.";

"correosGuia.gmail.add.title" = "Adicione seu endereço do Yala no Gmail";
"correosGuia.gmail.add.detail" = "1. Toque em “Abrir o Gmail”. O Gmail abre no Safari, na seção de encaminhamento. Se pedir, inicie sessão.\n2. Se aparecer a versão para telemóvel, toque no botão da barra de endereços do Safari e escolha “Pedir site para computador”.\n3. Toque em “Adicionar um endereço de encaminhamento”.\n4. Mantenha o dedo na caixa, toque em “Colar” e depois em “Próxima”.\n5. Abre-se uma janela: toque em “Continuar” e depois em “OK”.\nNão marque “Encaminhar uma cópia dos e-mails recebidos”: assim todo o seu e-mail seria enviado. Os avisos do banco são separados pelo filtro do passo 4.";
"correosGuia.gmail.confirm.title" = "Confirma o teu endereço do Yala no Gmail";
"correosGuia.gmail.confirm.waiting" = "O Gmail enviou uma ligação de confirmação para o teu endereço do Yala, e o Yala procura-a por ti a cada poucos segundos. Se quiseres, toca em “Procurar agora”. Quando chegar, toca em “Confirmar na Google”.";
"correosGuia.gmail.confirm.code" = "Seu código do Gmail é %@.\n1. Toque em “Copiar código”.\n2. Volte ao Gmail, no mesmo ecrã de encaminhamento.\n3. Cole o código na caixa de confirmação e toque em “Verificar”. Se não vir a caixa, recarregue a página.";
"correosGuia.gmail.confirm.link" = "Chegou a ligação de confirmação do Gmail.\n1. Toca em “Confirmar na Google”. Abre-se uma página da Google; se te pedir para confirmar, toca em “Confirmar”.\n2. Volta ao Yala para o passo seguinte.";
"correosGuia.gmail.filter.title" = "Crie um filtro para os avisos do seu banco";
"correosGuia.gmail.filter.detail" = "1. No Gmail, no Safari, escreva o endereço do seu banco na barra de pesquisa no topo.\n2. Toque no botão de opções, à direita da pesquisa, e depois em “Criar filtro”.\n3. Marque “Encaminhar para” e escolha seu endereço do Yala.\n4. Toque em “Criar filtro”.\nSe o seu banco lhe escreve de vários endereços, repita esses passos para cada um.";

"correosGuia.rule.title" = "Crie uma regra para os avisos do seu banco";
"correosGuia.outlook.rule.detail" = "1. Toque em “Abrir o Outlook”. O Outlook abre no Safari, na seção de regras. Se pedir, inicie sessão.\n2. Toque em “Adicionar nova regra” e dê-lhe um nome, por exemplo “Yala”.\n3. Na condição, escolha “De” e escreva o endereço do seu banco.\n4. Na ação, escolha “Encaminhar para” e cole seu endereço do Yala.\n5. Toque em “Salvar”.";
"correosGuia.icloud.rule.detail" = "1. Toque em “Abrir o iCloud Mail”. O iCloud.com abre no Safari. Se pedir, inicie sessão com sua Conta Apple.\n2. Toque no botão de ajustes (a engrenagem) e escolha “Regras”.\n3. Toque em “Adicionar uma regra”.\n4. Em “Se uma mensagem”, escolha “é de” e escreva o endereço do seu banco.\n5. Em “Então”, escolha “Encaminhar para” e cole seu endereço do Yala.\n6. Toque em “OK”.";

"correosGuia.wait.title" = "Pronto: espere o próximo aviso";
"correosGuia.wait.detail" = "Não precisa de fazer mais nada. Quando o seu banco mandar o próximo aviso, o movimento chega à sua Caixa de Entrada para o confirmar. Se passar um dia e não chegar nada, confira se o filtro ou a regra usa o mesmo endereço de onde o seu banco lhe escreve.";

"correosGuia.stepGuide.reopen" = "Voltar a este passo";
"correosGuia.stepGuide.reopenHint" = "Abre este passo de novo para o repetir ou terminar o que faltou.";
