/*
  CorreosBancoGuia.strings
  Yala

  Guía de «Correo del banco» para quien nunca configuró un reenvío (23-nov-2026): cada paso dice dónde entrar, qué
  tocar y qué se va a ver. Más el «Volver a este paso» de `YalaStepGuide`. Tabla propia, leída con el idioma de la app
  (`L10n.CorreosBancoGuia`). Los nombres de los botones de Gmail, Outlook e iCloud son los de ESA app en este idioma.
*/

"correosGuia.guideLine" = "Si imposta una sola volta, da Safari: l’app della tua posta non ha questa opzione. Ci vogliono pochi minuti.";
"correosGuia.findBank" = "Prima di iniziare, trova l’indirizzo della tua banca: apri un avviso che ti ha mandato e guarda chi lo invia, in «Da» (per esempio, avvisi@latuabanca.it).";

"correosGuia.copy.title" = "Copia il tuo indirizzo Yala";
"correosGuia.copy.detail" = "Tocca «Copia indirizzo». Non vedrai nessun cambiamento: l’indirizzo resta salvato per incollarlo nella tua posta. Se lo perdi, in alto, accanto al tuo indirizzo, c’è un altro pulsante per copiarlo.";

"correosGuia.gmail.add.title" = "Aggiungi il tuo indirizzo Yala in Gmail";
"correosGuia.gmail.add.detail" = "1. Tocca «Apri Gmail». Gmail si apre in Safari, nella sezione dell’inoltro. Se te lo chiede, accedi.\n2. Se vedi la versione per cellulare, tocca il pulsante della barra degli indirizzi di Safari e scegli «Richiedi sito desktop».\n3. Tocca «Aggiungi un indirizzo di inoltro».\n4. Tieni premuto nel riquadro, tocca «Incolla» e poi «Avanti».\n5. Si apre una finestra: tocca «Procedi» e poi «OK».\nNon selezionare «Inoltra una copia della posta in arrivo»: verrebbe inviata tutta la tua posta. Gli avvisi della banca li separa il filtro del passaggio 4.";
"correosGuia.gmail.confirm.title" = "Conferma il tuo indirizzo Yala in Gmail";
"correosGuia.gmail.confirm.waiting" = "Gmail ha inviato un link di conferma al tuo indirizzo Yala, e Yala lo cerca per te ogni pochi secondi. Se vuoi, tocca «Cerca ora». Quando arriva, tocca «Conferma su Google».";
"correosGuia.gmail.confirm.code" = "Il tuo codice Gmail è %@.\n1. Tocca «Copia codice».\n2. Torna su Gmail, nella stessa schermata dell’inoltro.\n3. Incolla il codice nel riquadro di conferma e tocca «Verifica». Se non vedi il riquadro, ricarica la pagina.";
"correosGuia.gmail.confirm.link" = "È arrivato il link di conferma di Gmail.\n1. Tocca «Conferma su Google». Si apre una pagina di Google; se ti chiede di confermare, tocca «Conferma».\n2. Torna su Yala per il passaggio successivo.";
"correosGuia.gmail.filter.title" = "Crea un filtro per gli avvisi della tua banca";
"correosGuia.gmail.filter.detail" = "1. In Gmail, in Safari, scrivi l’indirizzo della tua banca nella barra di ricerca in alto.\n2. Tocca il pulsante delle opzioni, a destra della ricerca, e poi «Crea filtro».\n3. Seleziona «Inoltra a» e scegli il tuo indirizzo Yala.\n4. Tocca «Crea filtro».\nSe la tua banca ti scrive da più indirizzi, ripeti questi passaggi per ognuno.";

"correosGuia.rule.title" = "Crea una regola per gli avvisi della tua banca";
"correosGuia.outlook.rule.detail" = "1. Tocca «Apri Outlook». Outlook si apre in Safari, nella sezione delle regole. Se te lo chiede, accedi.\n2. Tocca «Aggiungi nuova regola» e dalle un nome, per esempio «Yala».\n3. Nella condizione, scegli «Da» e scrivi l’indirizzo della tua banca.\n4. Nell’azione, scegli «Inoltra a» e incolla il tuo indirizzo Yala.\n5. Tocca «Salva».";
"correosGuia.icloud.rule.detail" = "1. Tocca «Apri iCloud Mail». iCloud.com si apre in Safari. Se te lo chiede, accedi con il tuo Account Apple.\n2. Tocca il pulsante delle impostazioni (l’ingranaggio) e scegli «Regole».\n3. Tocca «Aggiungi una regola».\n4. In «Se un messaggio», scegli «è da» e scrivi l’indirizzo della tua banca.\n5. In «Allora», scegli «Inoltra a» e incolla il tuo indirizzo Yala.\n6. Tocca «Fine».";

"correosGuia.wait.title" = "Fatto: aspetta il prossimo avviso";
"correosGuia.wait.detail" = "Non devi fare altro. Quando la tua banca manderà il prossimo avviso, il movimento arriverà nella tua Posta in arrivo perché tu lo confermi. Se passa un giorno e non arriva niente, controlla che il filtro o la regola usino lo stesso indirizzo da cui ti scrive la banca.";

"correosGuia.stepGuide.reopen" = "Torna a questo passaggio";
"correosGuia.stepGuide.reopenHint" = "Riapre questo passaggio per ripeterlo o finire ciò che mancava.";
