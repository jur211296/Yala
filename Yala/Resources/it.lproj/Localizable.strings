// MARK: - FAQ
"faq.subtitle" = "Risposte alle domande più comuni";
"faq.section.general" = "Generale";
"faq.section.data" = "I tuoi dati";
"faq.section.pro" = "Yala Pro";
"faq.whatIsYala.q" = "Cos'è Yala?";
"faq.whatIsYala.a" = "Yala è la tua app di finanze personali. Ti aiuta a registrare spese e entrate, organizzare i tuoi soldi per categorie ed etichette, creare budget e vedere report chiari delle tue finanze.";
"faq.howToRecord.q" = "Come registro una spesa?";
"faq.howToRecord.a" = "Nella Home, tocca Nuovo registro per inserire l'importo, oppure Voce o Foto per dettarlo o leggere una ricevuta. Yala completa i dettagli per te.";
"faq.multiCurrency.q" = "Posso usare più valute?";
"faq.multiCurrency.a" = "Sì. Yala ha 54 valute. Ogni conto è nella sua e Yala converte i totali nella tua valuta principale. Scegli la principale, e fino a 2 secondarie da confrontare, in Impostazioni > Valuta e cambio.";
"faq.changeCategory.q" = "Come cambio la categoria di una spesa?";
"faq.changeCategory.a" = "Apri la registrazione, tocca «Modifica» e cambia la categoria. Più veloce: tieni premuta la registrazione nell’elenco e scegli «Cambia categoria». Per cambiarne più di una insieme, tocca ··· in Registrazioni, scegli «Seleziona», segna quelle che vuoi e tocca la matita.";
"faq.importData.q" = "Posso importare i miei dati?";
"faq.importData.a" = "Sì. Vai in Impostazioni > Importa file e carica un file CSV o Excel. Yala rileva le colonne automaticamente e ti permette di assegnare conti per valuta.";
"faq.exportData.q" = "Come esporto i miei dati?";
"faq.exportData.a" = "Vai in Impostazioni > Esporta registrazioni e scegli il formato CSV o Excel. Puoi scaricare tutte le tue registrazioni per analizzarle in un foglio di calcolo o conservarle come backup.";
"faq.deleteData.q" = "Posso cancellare tutti i miei dati?";
"faq.deleteData.a" = "Sì. In Impostazioni > Cancella dati puoi eliminare tutte le informazioni. Questa azione non può essere annullata, quindi ti consigliamo di esportare un backup prima.";
"faq.whatIsPro.q" = "Cosa include Yala Pro?";
"faq.whatIsPro.a" = "Yala Pro ti permette di registrare parlando e con una foto, chiedere a Yala IA, avere conti e budget illimitati, e usare temi e icone. Trovi tutto in Impostazioni > Yala Pro.";
"faq.cancelSub.q" = "Come cancello il mio abbonamento?";
"faq.cancelSub.a" = "Puoi gestire o annullare il tuo abbonamento quando vuoi in Impostazioni > Yala Pro > Gestisci o annulla. Mantieni Pro fino alla fine del periodo pagato.";

