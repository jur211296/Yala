"l15.faq.whereData.q" = "Dove vengono salvati i miei dati?";
"l15.faq.whereData.a" = "Se hai scelto il tuo iCloud privato, sul tuo dispositivo e nel tuo iCloud: Yala non li vede. Se hai un account nel cloud, sui server di Yala, e accedi da un altro dispositivo con Apple o Google. Quello che registri in un gruppo si salva nel cloud perché il gruppo lo veda.";
"l15.faq.faceID.q" = "Posso proteggere Yala con Face ID?";
"l15.faq.faceID.a" = "Sì, con il blocco di iOS: tieni premuta l’icona di Yala nella schermata Home e tocca «Richiedi Face ID». Yala non vede mai il tuo volto: lo verifica iOS. Trovi la guida in Impostazioni > Proteggi con Face ID.";
"l15.faq.widgets.q" = "Come aggiungo un widget di Yala?";
"l15.faq.widgets.a" = "Tieni premuto uno spazio vuoto nella schermata Home, tocca «Modifica» > «Aggiungi widget» e cerca Yala. Ci sono widget di saldo, spese, categorie, riepilogo del mese e ultime registrazioni, e anche per la schermata di blocco.";
"l15.support.sendFooter" = "Si apre la tua posta per inviarlo a %@. Include la versione di Yala e di iOS, il modello del tuo dispositivo, il tema e la lingua, per aiutarti meglio.";
