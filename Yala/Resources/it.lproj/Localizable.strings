// Tutorial step descriptions (re-expanded)
"tutorials.createAccount.step0.desc" = "In Impostazioni, apri Conti e tocca + per crearne uno nuovo.";
"tutorials.createAccount.step1.desc" = "Nella Home, in Le tue finanze, scorri i tuoi conti fino alla fine e tocca Aggiungi.";
"tutorials.createAccount.step2.desc" = "Completa i dati per il tuo nuovo conto e tocca Salva.";
"tutorials.createCategories.step0.desc" = "In Impostazioni, apri Categorie e tocca + per crearne una nuova.";
"tutorials.createCategories.step1.desc" = "Ricorda che devono sempre esserci sottocategorie associate a una categoria per poterla creare.";
"tutorials.createCategories.step2.desc" = "Creare sottocategorie è facile come creare categorie: dagli un nome, scegli la sua necessità e se vuoi modifica la sua icona.";
"tutorials.createCategories.step3.desc" = "Personalizza a tuo piacimento l'icona e il colore della tua categoria quando vuoi.";
"tutorials.createTags.step0.desc" = "In Impostazioni, apri Etichette e tocca + per crearne una nuova.";
"tutorials.createTags.step1.desc" = "Personalizza a tuo piacimento il tag: dagli un nome, icona e colore.";
"tutorials.createRecord.step0.desc" = "Nella Home, tocca Nuovo registro. Per dettare o leggere una ricevuta, tocca Voce o Foto.";
"tutorials.createRecord.step1.desc" = "Puoi registrare spese, entrate e anche trasferimenti tra conti. I tassi di cambio vengono calcolati automaticamente in tempo reale.";
"tutorials.createRecord.step2.desc" = "Completa i campi obbligatori: importo, conto e sottocategoria. Puoi anche aggiungere una descrizione e i tag che vuoi.";
"tutorials.createRecord.step3.desc" = "Usa le scorciatoie rapide: @ per conto, ! per categoria e # per tag. Inizia a digitare per affinare la ricerca all'interno di ogni scorciatoia.";
"tutorials.importData.step0.desc" = "In Impostazioni, in Dati, tocca Importa file.";
"tutorials.importData.step1.desc" = "Puoi importare CSV o Excel quante volte vuoi seguendo il modello predefinito, che puoi scaricare lì stesso. Se ci sono dati in diverse valute, ti chiederà di selezionare i conti per ciascuna.";
"tutorials.createBudgets.step0.desc" = "Nel menu seleziona Pianificazione e assicurati di essere nella scheda Budget. Usa il pulsante + per crearne uno nuovo.";
"tutorials.createBudgets.step1.desc" = "Dagli un nome, importo e definisci il periodo: giornaliero, mensile, annuale o unico (per un viaggio, evento, ecc). Scegli quali conti, categorie, tag e necessità vuoi seguire. Attiva le notifiche se vuoi avvisi a determinate soglie.";
"tutorials.createBudgets.step2.desc" = "Attiva «Mostra nel widget» per vederlo nel widget Budget della Home.";
"tutorials.createBudgets.step3.desc" = "Ricorda che potrai sempre tornare per modificare il tuo budget toccandolo.";
"tutorials.createScheduledPayments.step0.desc" = "Nel menu seleziona Pianificazione e assicurati di essere nella scheda Pagamenti Pianificati. Usa il pulsante + per crearne uno nuovo.";
"tutorials.createScheduledPayments.step1.desc" = "Completa il nome del tuo pagamento, importo, nota (opzionale), conto, sottocategoria e tag (opzionale).";
"tutorials.createScheduledPayments.step2.desc" = "Seleziona il giorno del pagamento e la periodicità. Scegli quando sarà il primo pagamento e attiva le notifiche se vuoi essere avvisato lo stesso giorno o giorni prima.";
"tutorials.createScheduledPayments.step3.desc" = "In «Altre opzioni», attiva «E' un abbonamento?» se lo è.";
"tutorials.createScheduledPayments.step4.desc" = "Toccando un pagamento pianificato potrai vedere i pagamenti futuri, quelli già effettuati e modificarlo quando vuoi.";
"tutorials.createFavorites.step0.desc" = "In Nuova registrazione, tocca «Preferito», sotto l'importo, per salvare come preferito ciò che hai inserito finora.";
"tutorials.createFavorites.step1.desc" = "La prossima volta, tocca il preferito nella riga in alto del modulo: i campi che hai salvato si compilano da soli.";
"tutorials.editPanel.step0.desc" = "Vai alla schermata principale dove vedi il riepilogo delle spese con tutti i widget disponibili.";
"tutorials.editPanel.step1.desc" = "Tocca il pulsante a quadratini accanto a ogni sezione della Home per scegliere quali widget vedere e in che ordine.";
"tutorials.editPanel.step2.desc" = "Ricorda che puoi sempre tornare all'ordine predefinito toccando \"Ripristina\" all'interno della personalizzazione.";
"tutorials.panelFiltering.step0.desc" = "Sfrutta al massimo i grafici interattivi di Yala. Quasi tutti i pannelli sono filtrabili per categoria, necessità, tra gli altri. Gioca con loro e trova ciò che ti serve di più.";
"tutorials.panelFiltering.step1.desc" = "Hai una barra dei filtri dove vedrai tutti i filtri applicati. Puoi rimuoverli individualmente o tutti insieme quando vuoi.";
"tutorials.panelFiltering.step2.desc" = "Nelle diverse viste dell'applicazione vedrai che puoi filtrare a tuo piacimento con i grafici.";
"tutorials.panelFiltering.step3.desc" = "I filtri si propagano a tutte le viste allo stesso modo, così puoi vedere tutti i tipi di metriche per qualsiasi cosa tu voglia filtrare.";
"tutorials.panelFiltering.step4.desc" = "In alcune viste avrai anche una sezione di filtri nella parte superiore per filtrare a tuo piacimento o rimuoverli tutti con un solo pulsante.";
"tutorials.inboxApproval.step0.desc" = "In Posta in arrivo arriva quello che Yala ha registrato per te: ciò che detti o fotografi, i pagamenti Apple Pay che registra il comando rapido e i pagamenti pianificati in scadenza. Restano bozze finché non li controlli.";
"tutorials.inboxApproval.step1.desc" = "Completa semplicemente i campi obbligatori e approva. Verrà creata la registrazione normalmente.";
"tutorials.inboxApproval.step2.desc" = "Se più bozze sono già complete, tocca «Salva i pronti» e passano tutte insieme alle tue registrazioni.";
"tutorials.inboxApproval.step3.desc" = "Scorri una bozza per scartarla, oppure aprila per completarla e approvarla quando vuoi.";
"tutorials.applePay.step0.desc" = "Apri l'app Comandi Rapidi e vai in Automazione. Se non la vedi in basso, è in Libreria.";
"tutorials.applePay.step1.desc" = "Tocca +, scegli Wallet e seleziona le carte che usi. Se compare, scegli Esegui immediatamente.";
"tutorials.applePay.step2.desc" = "Se richiesto, tocca Crea nuovo comando rapido. Cerca Yala e scegli il comando rapido «Registra pagamento Apple Pay».";
"tutorials.applePay.step3.desc" = "In Importo seleziona Input del comando rapido e poi Quantità. Fai lo stesso per Esercente e Nome rispettivamente. Se compare «Mostra durante l'esecuzione», disattivalo.";
"tutorials.applePay.completion.title" = "Apple Pay connesso!";
"tutorials.applePay.completion.desc" = "Con questo avrai registrazioni automatiche ogni volta che usi Apple Pay con le carte selezionate. Ogni pagamento creerà una bozza nella tua casella in arrivo.";
