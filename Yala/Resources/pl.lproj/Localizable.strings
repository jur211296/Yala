// MARK: - FAQ
"faq.subtitle" = "Answers to most common questions";
"faq.section.general" = "General";
"faq.section.data" = "Twoje data";
"faq.section.pro" = "Yala Pro";
"faq.whatIsYala.q" = "What jest Yala?";
"faq.whatIsYala.a" = "Yala jest twoje personal finance app. It helps ty track wydatki i dochód, organize twoje money by kategorie i tags, create budgets, i see clear reports z how twoje finances są doing.";
"faq.howToRecord.q" = "How do I wpis an wydatek?";
"faq.howToRecord.a" = "Tap + button on main screen. Ty can type kwota manually, dictate by voice, lub scan a receipt with camera. Yala fills w details dla ty.";
"faq.multiCurrency.q" = "Can I use multiple currencies?";
"faq.multiCurrency.a" = "Tak. Yala supports 7 currencies (PEN, USD, EUR, MXN, COP, BRL, GBP). Set twoje main currency i dodaj secondary currencies w Ustawienia > Waluta.";
"faq.changeCategory.q" = "How do I change an wydatek's kategoria?";
"faq.changeCategory.a" = "Open wydatek i tap kategoria to change it. To change multiple at once, use bulk edytuj: long-press a wpis i select ones ty want to modify.";
"faq.importData.q" = "Can I import my data?";
"faq.importData.a" = "Tak. Go to Ustawienia > Importuj i upload a CSV lub Excel file. Yala detects columns automatically i lets ty assign konta by currency.";
"faq.exportData.q" = "How do I export my data?";
"faq.exportData.a" = "Go to Ustawienia > Eksportuj i choose CSV lub Excel format. Ty can download all twoje wpisy to analyze w a spreadsheet lub keep as a backup.";
"faq.deleteData.q" = "Can I usuń all my data?";
"faq.deleteData.a" = "Tak. W Ustawienia > Wipe Data ty can usuń all twoje information. This action cannot be undone, so we recommend exporting a backup first.";
"faq.whatIsPro.q" = "What does Yala Pro include?";
"faq.whatIsPro.a" = "Yala Pro unlocks premium features like voice input, receipt scanning with camera, exclusive themes, i more. Ty can see all benefits w Ustawienia > Subskrypcja.";
"faq.cancelSub.q" = "How do I anuluj my subscription?";
"faq.cancelSub.a" = "Ty can manage lub anuluj twoje subscription anytime from Ustawienia > Subskrypcja > Manage w App Store. Twoje Pro access continues until end z paid period.";

