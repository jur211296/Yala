// MARK: - FAQ
"faq.subtitle" = "Odpowiedzi na najczęstsze pytania";
"faq.section.general" = "Ogólne";
"faq.section.data" = "Twoje dane";
"faq.section.pro" = "Yala Pro";
"faq.whatIsYala.q" = "Czym jest Yala?";
"faq.whatIsYala.a" = "Yala to twoja osobista aplikacja finansowa. Pomaga śledzić wydatki i dochody, organizować pieniądze według kategorii i etykiet, tworzyć budżety i widzieć przejrzyste raporty o twoich finansach.";
"faq.howToRecord.q" = "Jak zapisać wydatek?";
"faq.howToRecord.a" = "Stuknij przycisk + na ekranie głównym. Możesz wpisać kwotę ręcznie, podyktować głosem lub zeskanować paragon aparatem. Yala wypełni szczegóły za ciebie.";
"faq.multiCurrency.q" = "Czy mogę używać kilku walut?";
"faq.multiCurrency.a" = "Tak. Yala wspiera 7 walut (PEN, USD, EUR, MXN, COP, BRL, GBP). Ustaw główną walutę i dodaj dodatkowe w Ustawienia > Waluta.";
"faq.changeCategory.q" = "Jak zmienić kategorię wydatku?";
"faq.changeCategory.a" = "Otwórz wydatek i dotknij kategorii, aby ją zmienić. Aby zmienić kilka naraz, użyj edycji zbiorczej: przytrzymaj wpis i wybierz te, które chcesz zmodyfikować.";
"faq.importData.q" = "Czy mogę zaimportować dane?";
"faq.importData.a" = "Tak. Przejdź do Ustawienia > Import i prześlij plik CSV lub Excel. Yala wykryje kolumny automatycznie i pozwoli przypisać konta według waluty.";
"faq.exportData.q" = "Jak wyeksportować dane?";
"faq.exportData.a" = "Przejdź do Ustawienia > Eksport i wybierz format CSV lub Excel. Możesz pobrać wszystkie wpisy do analizy w arkuszu lub jako kopię zapasową.";
"faq.deleteData.q" = "Czy mogę usunąć wszystkie dane?";
"faq.deleteData.a" = "Tak. W Ustawienia > Wyczyść dane możesz usunąć wszystkie informacje. Tej operacji nie można cofnąć, więc zalecamy najpierw eksport kopii.";
"faq.whatIsPro.q" = "Co zawiera Yala Pro?";
"faq.whatIsPro.a" = "Yala Pro odblokowuje funkcje premium, takie jak wprowadzanie głosowe, skanowanie paragonów aparatem, ekskluzywne motywy i więcej. Wszystkie korzyści zobaczysz w Ustawienia > Subskrypcja.";
"faq.cancelSub.q" = "Jak anulować subskrypcję?";
"faq.cancelSub.a" = "Możesz zarządzać lub anulować subskrypcję w każdej chwili w Ustawienia > Subskrypcja > Zarządzaj w App Store. Dostęp Pro trwa do końca opłaconego okresu.";

