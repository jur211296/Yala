// Tutorial step descriptions (re-expanded)
"tutorials.createAccount.step0.desc" = "W profilu wybierz sekcję Konta i stuknij, aby utworzyć nowe konto.";
"tutorials.createAccount.step1.desc" = "Możesz utworzyć konto bezpośrednio z Panelu, dotykając karty Dodaj nowe konto.";
"tutorials.createAccount.step2.desc" = "Wypełnij szczegóły nowego konta i stuknij Zapisz.";
"tutorials.createCategories.step0.desc" = "W profilu wybierz sekcję Kategorie i utwórz nową.";
"tutorials.createCategories.step1.desc" = "Pamiętaj, że kategoria musi mieć przypisane podkategorie, aby można było ją utworzyć.";
"tutorials.createCategories.step2.desc" = "Tworzenie podkategorii jest tak proste jak tworzenie kategorii: nadaj nazwę, wybierz rodzaj i opcjonalnie zmień ikonę.";
"tutorials.createCategories.step3.desc" = "Dostosuj ikonę i kolor kategorii, kiedy tylko chcesz.";
"tutorials.createTags.step0.desc" = "W profilu wybierz sekcję Etykiety i utwórz nową.";
"tutorials.createTags.step1.desc" = "Dostosuj etykietę: nadaj nazwę, ikonę i kolor.";
"tutorials.createRecord.step0.desc" = "Na panelu stuknij przycisk +. Jeśli jesteś użytkownikiem Yala Pro, wybierz Ręcznie.";
"tutorials.createRecord.step1.desc" = "Możesz zapisywać wydatki, dochody, a nawet transfery między kontami. Kursy wymiany są obliczane automatycznie w czasie rzeczywistym.";
"tutorials.createRecord.step2.desc" = "Wypełnij wymagane pola: kwota, konto i podkategoria. Możesz też dodać opis i etykiety.";
"tutorials.createRecord.step3.desc" = "Używaj szybkich skrótów: @ dla konta, ! dla kategorii i # dla etykiety. Zacznij pisać, aby doprecyzować wyszukiwanie.";
"tutorials.importData.step0.desc" = "W profilu wybierz sekcję Importuj dane.";
"tutorials.importData.step1.desc" = "Możesz importować CSV lub Excel ile razy chcesz, korzystając z domyślnego szablonu, który pobierzesz na miejscu. Jeśli dane są w kilku walutach, poprosimy cię o wybranie kont dla każdej z nich.";
"tutorials.createBudgets.step0.desc" = "W menu wybierz Planowanie i upewnij się, że jesteś w zakładce Budżety. Użyj przycisku +, aby utworzyć nowy.";
"tutorials.createBudgets.step1.desc" = "Nadaj nazwę, kwotę i zdefiniuj okres: dzienny, miesięczny, roczny lub jednorazowy (np. podróż, wydarzenie). Dostosuj konta, kategorie, etykiety i rodzaje, które chcesz śledzić. Włącz powiadomienia, jeśli chcesz alertów przy określonych progach.";
"tutorials.createBudgets.step2.desc" = "Możesz dodać budżety do Ulubionych, aby pokazać je w widżecie panelu. Wybierz do 3 w preferowanej kolejności.";
"tutorials.createBudgets.step3.desc" = "Pamiętaj, że zawsze możesz wrócić, by edytować budżet, dotykając go.";
"tutorials.createScheduledPayments.step0.desc" = "W menu wybierz Planowanie i upewnij się, że jesteś w zakładce Zaplanowane płatności. Użyj przycisku +, aby utworzyć nową.";
"tutorials.createScheduledPayments.step1.desc" = "Wpisz nazwę płatności, kwotę, notatkę (opcjonalnie), konto, podkategorię i etykiety (opcjonalnie).";
"tutorials.createScheduledPayments.step2.desc" = "Wybierz dzień płatności i częstotliwość. Wybierz, kiedy nastąpi pierwsza płatność, i włącz powiadomienia, jeśli chcesz przypomnienia tego samego dnia lub kilka dni wcześniej.";
"tutorials.createScheduledPayments.step3.desc" = "Nie zapomnij włączyć przełącznika subskrypcji, jeśli to subskrypcja cykliczna.";
"tutorials.createScheduledPayments.step4.desc" = "Stukając zaplanowaną płatność, zobaczysz nadchodzące płatności, te już zrealizowane, i będziesz mógł ją edytować w każdej chwili.";
"tutorials.createFavorites.step0.desc" = "Przejdź do ekranu nowej transakcji i stuknij gwiazdkę u góry, aby utworzyć nową ulubioną.";
"tutorials.createFavorites.step1.desc" = "Wypełnij pola, które mają być wstępnie wpisane. Następnym razem stuknij ulubioną, a wszystkie pola wypełnią się automatycznie.";
"tutorials.editPanel.step0.desc" = "Przejdź na ekran główny, gdzie widzisz podsumowanie wydatków ze wszystkimi dostępnymi widżetami.";
"tutorials.editPanel.step1.desc" = "Możesz zmieniać, które widżety zobaczyć i w jakiej kolejności, dotykając przycisku personalizacji w panelu.";
"tutorials.editPanel.step2.desc" = "Pamiętaj, że zawsze możesz wrócić do domyślnej kolejności, dotykając „Reset” w personalizacji.";
"tutorials.panelFiltering.step0.desc" = "Wykorzystaj w pełni interaktywne wykresy Yala. Niemal wszystkie panele można filtrować po kategorii, rodzaju i innych. Pobaw się nimi i znajdź to, co działa najlepiej.";
"tutorials.panelFiltering.step1.desc" = "Masz pasek filtrów, gdzie zobaczysz wszystkie zastosowane. Możesz je usuwać pojedynczo lub wszystkie naraz w każdej chwili.";
"tutorials.panelFiltering.step2.desc" = "W różnych widokach aplikacji zobaczysz, że możesz filtrować po swojemu poprzez wykresy.";
"tutorials.panelFiltering.step3.desc" = "Filtry propagują się do wszystkich widoków, więc widzisz wszelkie wskaźniki dla tego, co chcesz filtrować.";
"tutorials.panelFiltering.step4.desc" = "W niektórych widokach masz też sekcję filtrów u góry, dzięki czemu filtrujesz po swojemu lub czyścisz wszystko jednym przyciskiem.";
"tutorials.inboxApproval.step0.desc" = "Jeśli jesteś użytkownikiem Yala Pro, podczas zapisu głosem lub obrazem zostaniesz automatycznie przeniesiony do szkicu. Tak samo, jeśli używałeś skrótu Zapis Apple Pay.";
"tutorials.inboxApproval.step1.desc" = "Wypełnij wymagane pola i zatwierdź. Transakcja zostanie utworzona normalnie.";
"tutorials.inboxApproval.step2.desc" = "Możesz też tworzyć wpisy głosowe lub z obrazów z wieloma transakcjami. Powiemy, ile szkiców powstało, i poprowadzimy do skrzynki, by je przejrzeć.";
"tutorials.inboxApproval.step3.desc" = "W skrzynce możesz zatwierdzać transakcje, wybrać Zatwierdź później lub odrzucać je bezpośrednio.";
"tutorials.applePay.step0.desc" = "Otwórz aplikację Skróty i przejdź do sekcji Automatyzacje.";
"tutorials.applePay.step1.desc" = "Stuknij Nowa automatyzacja, wybierz opcję Wallet, wybierz karty, których chcesz używać, i wybierz Uruchom natychmiast.";
"tutorials.applePay.step2.desc" = "Wybierz Utwórz nowy skrót i wyszukaj Yala na samym dole. W Yala wybierz skrót Zapis Apple Pay.";
"tutorials.applePay.step3.desc" = "Dla pola Kwota wybierz Wejście skrótu, a następnie Kwota. Zrób to samo dla Sprzedawca i Nazwa. Wyłącz przełącznik „Pokaż przy uruchomieniu”.";

"tutorials.applePay.completion.title" = "Apple Pay połączone!";
"tutorials.applePay.completion.desc" = "Od teraz przy każdej płatności Apple Pay wybranymi kartami powstanie automatyczny wpis. Każda płatność utworzy szkic w skrzynce.";

