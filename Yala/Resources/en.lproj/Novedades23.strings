"novedades23.duo.title" = "Made for iPhone Duo";
"novedades23.duo.description" = "Open it to make the most of the big screen, with your lists and their details side by side. Close it and Yala fits the outer screen.";
"novedades23.cards.title" = "Your accounts, as cards";
"novedades23.cards.description" = "Design each account's card with templates, colors and your last 4 digits. Tap it on the Panel to see its balance, what's billed and when to pay.";
"novedades23.groups.title" = "Easier Groups";
"novedades23.groups.description" = "Split a receipt with a photo or your voice, settle debts in fewer payments and bring your groups from Splitwise or Tricount with the same balances.";
"novedades23.records.title" = "Faster Records";
"novedades23.records.description" = "Filter by account or category in one tap, jump between months in the calendar and turn any record into a repeating payment.";
"novedades23.health.title" = "A fuller health score";
"novedades23.health.description" = "It now also looks at how much of what comes in you keep. Tap it on the Panel to see what moves it most this month.";
"novedades23.planning.title" = "What you can spend today";
"novedades23.planning.description" = "Each budget tells you how much you can spend today, and Yala suggests the subscriptions it finds in your records.";
"novedades23.ant.title" = "Small recurring spending";
"novedades23.ant.description" = "See how your small purchases add up and, with “Show projection”, how your month could end.";
"novedades23.hide.title" = "Hide your amounts";
"novedades23.hide.description" = "Tap the eye on the Panel and your figures disappear: perfect when someone is looking at your screen.";
