<plist version="1.0">
<dict>
	<key>account.deleteConfirmMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Das Konto hat %d Datensatz. Er wird nicht gelöscht: Er bleibt in Datensätze, ohne Konto. Wenn du das Konto nur nicht mehr sehen willst, archiviere es. Das kann nicht rückgängig gemacht werden.</string>
			<key>other</key>
			<string>Das Konto hat %d Datensätze. Sie werden nicht gelöscht: Sie bleiben in Datensätze, ohne Konto. Wenn du das Konto nur nicht mehr sehen willst, archiviere es. Das kann nicht rückgängig gemacht werden.</string>
		</dict>
	</dict>
	<key>category.cannotDeleteMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Diese Kategorie hat eine Unterkategorie mit %d Transaktion. Um sie zu löschen, lösche oder übertrage zuerst diese Transaktion aus ihrer Unterkategorie.</string>
			<key>other</key>
			<string>Diese Kategorie hat Unterkategorien mit %d Transaktionen. Um sie zu löschen, lösche oder übertrage zuerst die Transaktionen aus jeder Unterkategorie.</string>
		</dict>
	</dict>
	<key>subcategory.deleteTransactionsConfirmMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d Transaktion wird dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden.</string>
			<key>other</key>
			<string>%d Transaktionen werden dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden.</string>
		</dict>
	</dict>
	<key>subcategory.transferDescription</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
