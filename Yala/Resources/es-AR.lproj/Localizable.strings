"tutorials.createAccount.completion.desc" = "Mantener tus cuentas ordenadas y bien separadas es fundamental para organizar tus finanzas. Cada cuenta te permite filtrar tus datos y visualizar mejor tus tendencias. Podés editarlas cuando quieras y modificar su saldo inicial o hacer un ajuste del saldo actual.";
"tutorials.createCategories.completion.desc" = "Unas buenas categorías hacen que tus reportes sean mucho más útiles. Podés editarlas o agregar más en cualquier momento.";
"tutorials.createFavorites.completion.desc" = "Los favoritos te ahorran tiempo en gastos repetitivos. Podés tener tantos como quieras y editarlos cuando necesites.";
"tutorials.editPanel.step2.title" = "Restablece si querés";
"tutorials.editPanel.completion.desc" = "Tu panel ahora muestra exactamente lo que necesitas. Podés cambiarlo en cualquier momento para adaptarlo a tu forma de gestionar.";
"tutorials.createAccount.step1.desc" = "Podés crear una cuenta directamente desde el Panel tocando la caja de Agregar nueva cuenta.";
"tutorials.createCategories.step2.desc" = "Crear subcategorías es tan fácil como crear categorías: ponle nombre, selecciona su naturaleza y si querés modifica su icono.";
"tutorials.createRecord.step0.desc" = "En el panel, toca el botón +. Si sos usuario Yala Pro, selecciona Manual.";
"tutorials.createRecord.step1.desc" = "Podés registrar gastos, ingresos e inclusive transferencias entre cuentas. Los tipos de cambio se calculan automáticamente en tiempo real.";
"tutorials.createRecord.step2.desc" = "Completa los campos obligatorios: monto, cuenta y subcategoría. También podés agregar una descripción y las etiquetas que quieras.";
"tutorials.importData.step1.desc" = "Podés importar CSV o Excel cuantas veces quieras siguiendo la plantilla predeterminada, que podés descargar ahí mismo. Si hay datos en diversas divisas, te pedirá seleccionar las cuentas para cada una.";
"tutorials.createBudgets.step1.desc" = "Ponle nombre, monto y define el periodo: diario, mensual, anual o único (para un viaje, evento, etc). Personaliza qué cuentas, categorías, etiquetas y naturalezas querés trackear. Activa las notificaciones si querés avisos en ciertos umbrales.";
"tutorials.createBudgets.step2.desc" = "Podés añadir presupuestos a Favoritos para visualizarlos en el widget del Panel. Elige hasta 3 en el orden que prefieras.";
"tutorials.createScheduledPayments.step2.desc" = "Selecciona el día del pago y la periodicidad. Elige cuándo será el primer pago y activa las notificaciones si querés que te avise el mismo día o días antes.";
"tutorials.editPanel.step1.desc" = "Podés modificar qué widgets ver y en qué orden tocando el botón de personalización en el panel.";
"tutorials.editPanel.step2.desc" = "Recuerda que siempre podés volver al orden predeterminado tocando \"Restablecer\" dentro de la personalización.";
"tutorials.panelFiltering.step1.desc" = "Cuentas con una barra de filtros donde irás viendo todos los filtros aplicados. Podés removerlos individualmente o todos a la vez cuando quieras.";
"tutorials.panelFiltering.step2.desc" = "En las distintas vistas de la aplicación verás que podés ir filtrando a tu gusto con los gráficos.";
"tutorials.panelFiltering.step3.desc" = "Los filtros se propagan a todas las vistas por igual, así podés ver todo tipo de métricas para lo que sea que quieras filtrar.";
"tutorials.inboxApproval.step0.desc" = "Si sos usuario Yala Pro, cuando hagas un registro por voz o imagen, automáticamente te llevará al borrador. Lo mismo si usaste el atajo de Registro Apple Pay.";
"tutorials.inboxApproval.step2.desc" = "También podés hacer registros de voz o imagen con múltiples transacciones. Te dirá cuántos borradores se crearon y te guiará a la bandeja para revisarlos.";
"faq.howToRecord.a" = "Toca el botón + en la pantalla principal. Podés escribir el monto manualmente, dictar por voz o escanear un recibo con la cámara. Yala completa los detalles por ti.";
"faq.changeCategory.a" = "Abre el gasto y toca la categoría para cambiarla. Si querés cambiar varios a la vez, usa la edición masiva: mantén presionado un registro y selecciona los que quieras modificar.";
"faq.exportData.a" = "Ve a Ajustes > Exportar y elige formato CSV o Excel. Podés descargar todos tus registros para analizarlos en una hoja de cálculo o guardarlos como respaldo.";
"faq.deleteData.a" = "Sí. En Ajustes > Vaciar datos podés eliminar toda tu información. Esta acción no se puede deshacer, así que te recomendamos exportar un respaldo antes.";
"faq.whatIsPro.a" = "Yala Pro desbloquea funciones premium como entrada por voz, escaneo de recibos con cámara, temas exclusivos y más. Podés ver todos los beneficios en Ajustes > Suscripción.";
"faq.cancelSub.a" = "Podés administrar o cancelar tu suscripción en cualquier momento desde Ajustes > Suscripción > Administrar en App Store. Tu acceso Pro continúa hasta el final del periodo pagado.";
