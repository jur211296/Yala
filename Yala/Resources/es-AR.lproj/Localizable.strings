"l15.faq.whereData.q" = "¿Dónde se guardan mis datos?";
"l15.faq.whereData.a" = "Si elegiste tu iCloud privado, en tu dispositivo y en tu iCloud: Yala no los ve. Si tenés una cuenta en la nube, en los servidores de Yala, y entrás desde otro dispositivo con Apple o Google. Lo que anotás en un grupo se guarda en la nube para que el grupo lo vea.";
"l15.faq.faceID.q" = "¿Puedo proteger Yala con Face ID?";
"l15.faq.faceID.a" = "Sí, con el bloqueo de iOS: mantené presionado el ícono de Yala en tu pantalla de inicio y tocá «Requerir Face ID». Yala nunca ve tu rostro: lo comprueba iOS. Tenés la guía en Ajustes > Proteger con Face ID.";
"l15.faq.widgets.q" = "¿Cómo agrego un widget de Yala?";
"l15.faq.widgets.a" = "Mantené presionado un espacio vacío de tu pantalla de inicio, tocá «Editar» > «Agregar widget» y buscá Yala. Hay widgets de saldo, gastos, categorías, resumen del mes y últimos registros, y también para la pantalla bloqueada.";
"l15.support.sendFooter" = "Se abre tu correo para enviarlo a %@. Va con la versión de Yala y de iOS, el modelo de tu dispositivo, el tema y el idioma, para ayudarte mejor.";
