"novedades23.duo.title" = "Hecha para el iPhone Duo";
"novedades23.duo.description" = "Abrilo y aprovechás la pantalla grande, con tus listas y su detalle lado a lado. Cerralo y Yala se acomoda a la pantalla exterior.";
"novedades23.cards.title" = "Tus cuentas, como tarjetas";
"novedades23.cards.description" = "Diseñá la tarjeta de cada cuenta con plantillas, colores y tus últimos 4 dígitos. Tocala en el Panel y ves su saldo, lo facturado y cuándo pagar.";
"novedades23.groups.title" = "Grupos más fáciles";
"novedades23.groups.description" = "Repartí un recibo con una foto o con tu voz, saldá las deudas en menos pagos y traé tus grupos de Splitwise o Tricount con los mismos saldos.";
"novedades23.records.title" = "Registros más ágiles";
"novedades23.records.description" = "Filtrá por cuenta o categoría en un toque, saltá de mes en el calendario y convertí cualquier registro en un pago que se repite.";
"novedades23.health.title" = "Tu nota de salud, más completa";
"novedades23.health.description" = "Ahora también mira cuánto te queda de lo que entra. Tocala en el Panel y te dice qué la mueve más este mes.";
"novedades23.planning.title" = "Cuánto podés gastar hoy";
"novedades23.planning.description" = "Cada presupuesto te dice cuánto podés gastar hoy, y Yala te propone las suscripciones que encuentra en tus registros.";
"novedades23.ant.title" = "Tus gastos hormiga";
"novedades23.ant.description" = "Mirá cuánto suman tus compras chicas y, con «Ver proyectado», cómo cerraría tu mes.";
"novedades23.hide.title" = "Ocultá tus montos";
"novedades23.hide.description" = "Tocá el ojo del Panel y tus cifras se esconden: ideal cuando alguien mira tu pantalla.";
