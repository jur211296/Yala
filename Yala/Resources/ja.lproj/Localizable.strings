"faq.subtitle" = "Answers to the most common questions";
"faq.section.general" = "General";
"faq.section.data" = "あなたの data";
"faq.section.pro" = "Yala Pro";
"faq.whatIsYala.q" = "What is Yala?";
"faq.whatIsYala.a" = "Yala is あなたの personal finance app. It helps あなた track expenses and 収入, organize あなたの money by categories and tags, create budgets, and see clear reports of how あなたの finances are doing.";
"faq.howToRecord.q" = "How do I 記録 an 支出?";
"faq.howToRecord.a" = "Tap the + button on the main screen. あなた can type the amount manually, dictate by voice, or scan a receipt with the camera. Yala fills in the details for あなた.";
"faq.multiCurrency.q" = "Can I use multiple currencies?";
"faq.multiCurrency.a" = "Yes. Yala supports 7 currencies (PEN, USD, EUR, MXN, COP, BRL, GBP). Set あなたの main currency and 追加 secondary currencies in 設定 > 通貨.";
"faq.changeCategory.q" = "How do I change an 支出's カテゴリー?";
"faq.changeCategory.a" = "Open the 支出 and tap the カテゴリー to change it. To change multiple at once, use bulk 編集: long-press a 記録 and select the ones あなた want to modify.";
"faq.importData.q" = "Can I import my data?";
"faq.importData.a" = "Yes. Go to 設定 > Import and upload a CSV or Excel file. Yala detects the columns automatically and lets あなた assign accounts by currency.";
"faq.exportData.q" = "How do I export my data?";
"faq.exportData.a" = "Go to 設定 > Export and choose CSV or Excel format. あなた can download all あなたの records to analyze in a spreadsheet or keep as a backup.";
"faq.deleteData.q" = "Can I 削除 all my data?";
"faq.deleteData.a" = "Yes. In 設定 > Wipe Data あなた can 削除 all あなたの information. This action cannot be undone, so we recommend exporting a backup first.";
"faq.whatIsPro.q" = "What does Yala Pro include?";
"faq.whatIsPro.a" = "Yala Pro unlocks premium features like voice input, receipt scanning with camera, exclusive themes, and more. あなた can see all benefits in 設定 > サブスクリプション.";
"faq.cancelSub.q" = "How do I キャンセル my subscription?";
"faq.cancelSub.a" = "あなた can manage or キャンセル あなたの subscription anytime from 設定 > サブスクリプション > Manage in App Store. あなたの Pro access continues until the end of the paid period.";

