// Tutorial step descriptions (re-expanded)
"tutorials.createAccount.step0.desc" = "En Ajustes, entra en Cuentas y toca + para crear una nueva.";
"tutorials.createAccount.step1.desc" = "En el Panel, dentro de Tus finanzas, desliza tus cuentas hasta el final y toca Agregar.";
"tutorials.createAccount.step2.desc" = "Completa los datos para tu nueva cuenta y toca Guardar.";
"tutorials.createCategories.step0.desc" = "En Ajustes, entra en Categorías y toca + para crear una nueva.";
"tutorials.createCategories.step1.desc" = "Recuerda que siempre debe haber subcategorías asociadas a una categoría para poder crearla.";
"tutorials.createCategories.step2.desc" = "Crear subcategorías es tan fácil como crear categorías: ponle nombre, elige su necesidad y si quieres modifica su icono.";
"tutorials.createCategories.step3.desc" = "Personaliza a tu gusto el icono y color de tu categoría cuando quieras.";
"tutorials.createTags.step0.desc" = "En Ajustes, entra en Etiquetas y toca + para crear una nueva.";
"tutorials.createTags.step1.desc" = "Personaliza a tu gusto la etiqueta: ponle nombre, icono y color.";
"tutorials.createRecord.step0.desc" = "En el Panel, toca Nuevo registro. Para dictar o leer un recibo, toca Voz o Foto.";
"tutorials.createRecord.step1.desc" = "Puedes registrar gastos, ingresos e inclusive transferencias entre cuentas. Los tipos de cambio se calculan automáticamente en tiempo real.";
"tutorials.createRecord.step2.desc" = "Completa los campos obligatorios: monto, cuenta y subcategoría. También puedes agregar una descripción y las etiquetas que quieras.";
"tutorials.createRecord.step3.desc" = "Usa los atajos rápidos: @ para cuenta, ! para categoría y # para etiqueta. Empieza a escribir para afinar la búsqueda dentro de cada atajo.";
"tutorials.importData.step0.desc" = "En Ajustes, dentro de Datos, toca Importar archivo.";
"tutorials.importData.step1.desc" = "Puedes importar CSV o Excel cuantas veces quieras siguiendo la plantilla predeterminada, que puedes descargar ahí mismo. Si hay datos en varias monedas, te pedirá seleccionar las cuentas para cada una.";
"tutorials.createBudgets.step0.desc" = "En el menú selecciona Planificación y asegúrate de estar en la pestaña de Presupuestos. Usa el botón + para crear uno nuevo.";
"tutorials.createBudgets.step1.desc" = "Ponle nombre, monto y define el periodo: diario, mensual, anual o único (para un viaje, evento, etc). Elige qué cuentas, categorías, etiquetas y necesidades quieres seguir. Activa las notificaciones si quieres avisos en ciertos umbrales.";
"tutorials.createBudgets.step2.desc" = "Activa «Mostrar en el widget» para verlo en el widget de Presupuestos del Panel.";
"tutorials.createBudgets.step3.desc" = "Recuerda que siempre podrás volver para editar tu presupuesto tocándolo.";
"tutorials.createScheduledPayments.step0.desc" = "En el menú selecciona Planificación y asegúrate de estar en la pestaña de Pagos Planificados. Usa el botón + para crear uno nuevo.";
"tutorials.createScheduledPayments.step1.desc" = "Completa el nombre de tu pago, monto, nota (opcional), cuenta, subcategoría y etiquetas (opcional).";
"tutorials.createScheduledPayments.step2.desc" = "Selecciona el día del pago y la periodicidad. Elige cuándo será el primer pago y activa las notificaciones si quieres que te avise el mismo día o días antes.";
"tutorials.createScheduledPayments.step3.desc" = "En «Más opciones», activa «¿Es una suscripción?» si lo es.";
"tutorials.createScheduledPayments.step4.desc" = "Al tocar un pago planificado podrás ver los futuros pagos, los ya realizados y editarlo cuando quieras.";
"tutorials.createFavorites.step0.desc" = "En Nuevo registro, toca «Favorito», debajo del monto, para guardar como favorito lo que llevas escrito.";
"tutorials.createFavorites.step1.desc" = "La próxima vez, toca el favorito en la fila de arriba del formulario: los campos que guardaste se completan solos.";
"tutorials.editPanel.step0.desc" = "Ve a la pantalla principal donde ves tu resumen de gastos con todos los widgets disponibles.";
"tutorials.editPanel.step1.desc" = "Toca el botón de cuadritos junto a cada sección del Panel para elegir qué widgets ver y en qué orden.";
"tutorials.editPanel.step2.desc" = "Recuerda que siempre puedes volver al orden predeterminado tocando \"Restablecer\" dentro de la personalización.";
"tutorials.panelFiltering.step0.desc" = "Saca el máximo provecho a los gráficos interactivos de Yala. Casi todos los paneles son filtrables por categoría, necesidad, entre otros. Juega con ellos y encuentra lo que más te sirva.";
"tutorials.panelFiltering.step1.desc" = "Cuentas con una barra de filtros donde irás viendo todos los filtros aplicados. Puedes removerlos individualmente o todos a la vez cuando quieras.";
"tutorials.panelFiltering.step2.desc" = "En las distintas vistas de la aplicación verás que puedes ir filtrando a tu gusto con los gráficos.";
"tutorials.panelFiltering.step3.desc" = "Los filtros se propagan a todas las vistas por igual, así puedes ver todo tipo de métricas para lo que sea que quieras filtrar.";
"tutorials.panelFiltering.step4.desc" = "En algunas vistas también contarás con una sección de filtros en la parte superior para que filtres a tu gusto o remuevas todos con un solo botón.";
"tutorials.inboxApproval.step0.desc" = "A la Bandeja llega lo que Yala apuntó por ti: lo que dictas o fotografías, los pagos de Apple Pay que registra el atajo y los pagos planificados que vencen. Quedan como borradores hasta que los revisas.";
"tutorials.inboxApproval.step1.desc" = "Simplemente completa los campos obligatorios y aprueba. Se creará el registro con normalidad.";
"tutorials.inboxApproval.step2.desc" = "Si varios borradores ya tienen todo, toca «Guardar los listos» y pasan a tus registros de una vez.";
"tutorials.inboxApproval.step3.desc" = "Desliza un borrador para descartarlo, o ábrelo para completarlo y aprobarlo cuando quieras.";
"tutorials.applePay.step0.desc" = "Abre la app Atajos y entra en Automatización. Si no la ves abajo, está en Biblioteca.";
"tutorials.applePay.step1.desc" = "Toca +, elige Wallet y marca las tarjetas que usas. Si te lo ofrece, elige Ejecutar de inmediato.";
"tutorials.applePay.step2.desc" = "Si te lo pide, toca Crear nuevo atajo. Busca Yala y elige el atajo «Registrar pago de Apple Pay».";
"tutorials.applePay.step3.desc" = "En Cantidad selecciona Entrada de atajo y luego Cantidad. Haz lo mismo para Comercio y Nombre respectivamente. Si aparece «Mostrar al ejecutar», desactívalo.";
"tutorials.applePay.completion.title" = "¡Apple Pay conectado!";
"tutorials.applePay.completion.desc" = "Con esto ya tendrás registros automáticos cada vez que uses Apple Pay con las tarjetas seleccionadas. Cada pago creará un borrador en tu bandeja de entrada.";

// MARK: - FAQ
"faq.subtitle" = "Respuestas a las dudas más comunes";
"faq.section.general" = "General";
"faq.section.data" = "Tus datos";
"faq.section.pro" = "Yala Pro";
"faq.whatIsYala.q" = "¿Qué es Yala?";
"faq.whatIsYala.a" = "Yala es tu app de finanzas personales. Te ayuda a registrar gastos e ingresos, organizar tu dinero por categorías y etiquetas, crear presupuestos y ver reportes claros de cómo va tu economía.";
"faq.howToRecord.q" = "¿Cómo registro un gasto?";
"faq.howToRecord.a" = "En el Panel, toca Nuevo registro para escribir el monto, o Voz o Foto para dictarlo o leer un recibo. Yala completa los detalles por ti.";
"faq.multiCurrency.q" = "¿Puedo usar varias monedas?";
"faq.multiCurrency.a" = "Sí. Yala tiene 54 monedas. Cada cuenta va en la suya y Yala convierte los totales a tu moneda principal. Eliges la principal, y hasta 2 secundarias para comparar, en Ajustes > Moneda y tipo de cambio.";
"faq.changeCategory.q" = "¿Cómo cambio la categoría de un gasto?";
"faq.changeCategory.a" = "Abre el registro, toca «Editar» y cambia la categoría. Más rápido: mantén presionado el registro en la lista y elige «Cambiar categoría». Para cambiar varios a la vez, toca ··· en Registros, elige «Seleccionar», marca los que quieras y toca el lápiz.";
"faq.importData.q" = "¿Puedo importar mis datos?";
"faq.importData.a" = "Sí. Ve a Ajustes > Importar archivo y sube un archivo CSV o Excel. Yala detecta las columnas automáticamente y te deja asignar cuentas por moneda.";
"faq.exportData.q" = "¿Cómo exporto mis datos?";
"faq.exportData.a" = "Ve a Ajustes > Exportar registros y elige formato CSV o Excel. Puedes descargar todos tus registros para analizarlos en una hoja de cálculo o guardarlos como respaldo.";
"faq.deleteData.q" = "¿Puedo borrar todos mis datos?";
"faq.deleteData.a" = "Sí. En Ajustes > Vaciar datos puedes eliminar toda tu información. Esta acción no se puede deshacer, así que te recomendamos exportar un respaldo antes.";
"faq.whatIsPro.q" = "¿Qué incluye Yala Pro?";
"faq.whatIsPro.a" = "Yala Pro te deja apuntar hablando y con una foto, preguntarle a Yala IA, tener cuentas y presupuestos sin límite, y usar temas e iconos. Lo ves todo en Ajustes > Yala Pro.";
"faq.cancelSub.q" = "¿Cómo cancelo mi suscripción?";
"faq.cancelSub.a" = "Puedes gestionar o cancelar tu suscripción cuando quieras en Ajustes > Yala Pro > Gestionar o cancelar. Sigues con Pro hasta el final del período pagado.";

