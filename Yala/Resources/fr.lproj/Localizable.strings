// MARK: - FAQ
"faq.subtitle" = "Réponses aux questions les plus courantes";
"faq.section.general" = "Général";
"faq.section.data" = "Tes données";
"faq.section.pro" = "Yala Pro";
"faq.whatIsYala.q" = "Qu'est-ce que Yala ?";
"faq.whatIsYala.a" = "Yala est ton app de finances personnelles. Elle t'aide à suivre dépenses et revenus, organiser ton argent par catégories et étiquettes, créer des budgets et voir des rapports clairs de tes finances.";
"faq.howToRecord.q" = "Comment enregistrer une dépense ?";
"faq.howToRecord.a" = "Sur le Panel, touche Nouvel enregistrement pour saisir le montant, ou Voix ou Photo pour le dicter ou lire un reçu. Yala remplit les détails pour toi.";
"faq.multiCurrency.q" = "Puis-je utiliser plusieurs devises ?";
"faq.multiCurrency.a" = "Oui. Yala propose 54 devises. Chaque compte est dans la sienne et Yala convertit les totaux dans ta devise principale. Tu choisis la principale, et jusqu’à 2 secondaires pour comparer, dans Réglages > Devise et change.";
"faq.changeCategory.q" = "Comment changer la catégorie d'une dépense ?";
"faq.changeCategory.a" = "Ouvre l’enregistrement, appuie sur « Modifier » et change la catégorie. Plus rapide : maintiens l’enregistrement dans la liste et choisis « Changer de catégorie ». Pour en modifier plusieurs à la fois, appuie sur ··· dans Enregistrements, choisis « Sélectionner », coche ceux que tu veux et appuie sur le crayon.";
"faq.importData.q" = "Puis-je importer mes données ?";
"faq.importData.a" = "Oui. Va dans Réglages > Importer un fichier et envoie un fichier CSV ou Excel. Yala détecte les colonnes automatiquement et te permet d’assigner des comptes par devise.";
"faq.exportData.q" = "Comment exporter mes données ?";
"faq.exportData.a" = "Va dans Réglages > Exporter les enregistrements et choisis le format CSV ou Excel. Tu peux télécharger tous tes enregistrements pour les analyser dans un tableur ou les garder en sauvegarde.";
"faq.deleteData.q" = "Puis-je supprimer toutes mes données ?";
"faq.deleteData.a" = "Oui. Dans Réglages > Effacer les données tu peux tout supprimer. Cette action est irréversible, nous te recommandons d'exporter une sauvegarde avant.";
"faq.whatIsPro.q" = "Que comprend Yala Pro ?";
"faq.whatIsPro.a" = "Yala Pro te permet de noter en parlant et avec une photo, de poser tes questions à Yala IA, d’avoir des comptes et des budgets illimités, et d’utiliser des thèmes et des icônes. Tu vois tout dans Réglages > Yala Pro.";
"faq.cancelSub.q" = "Comment annuler mon abonnement ?";
"faq.cancelSub.a" = "Tu peux gérer ou annuler ton abonnement quand tu veux dans Réglages > Yala Pro > Gérer ou annuler. Tu gardes Pro jusqu’à la fin de la période payée.";

