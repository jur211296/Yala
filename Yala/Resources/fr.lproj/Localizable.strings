"tutorials.createAccount.step0.desc" = "Dans Réglages, ouvre Comptes et touche + pour en créer un nouveau.";
"tutorials.createAccount.step1.desc" = "Sur le Panel, dans Tes finances, fais défiler tes comptes jusqu’au bout et touche Ajouter.";
"tutorials.createAccount.step2.desc" = "Complète les informations pour ton nouveau compte et touche Enregistrer.";
"tutorials.createCategories.step0.desc" = "Dans Réglages, ouvre Catégories et touche + pour en créer une nouvelle.";
"tutorials.createCategories.step1.desc" = "N'oublie pas qu'il doit toujours y avoir des sous-catégories associées à une catégorie pour pouvoir la créer.";
"tutorials.createCategories.step2.desc" = "Créer des sous-catégories est aussi facile que créer des catégories : donne-lui un nom, choisis son besoin et modifie son icône si tu veux.";
"tutorials.createCategories.step3.desc" = "Personnalise l'icône et la couleur de ta catégorie comme tu veux quand tu veux.";
"tutorials.createTags.step0.desc" = "Dans Réglages, ouvre Étiquettes et touche + pour en créer une nouvelle.";
"tutorials.createTags.step1.desc" = "Personnalise l'étiquette comme tu veux : donne-lui un nom, une icône et une couleur.";
"tutorials.createRecord.step0.desc" = "Sur le Panel, touche Nouvel enregistrement. Pour dicter ou lire un reçu, touche Voix ou Photo.";
"tutorials.createRecord.step1.desc" = "Tu peux enregistrer des dépenses, des revenus et même des transferts entre comptes. Les taux de change se calculent automatiquement en temps réel.";
"tutorials.createRecord.step2.desc" = "Complète les champs obligatoires : montant, compte et sous-catégorie. Tu peux aussi ajouter une description et les étiquettes que tu veux.";
"tutorials.createRecord.step3.desc" = "Utilise les raccourcis rapides : @ pour compte, ! pour catégorie et # pour étiquette. Commence à écrire pour affiner la recherche dans chaque raccourci.";
"tutorials.importData.step0.desc" = "Dans Réglages, sous Données, touche Importer un fichier.";
"tutorials.importData.step1.desc" = "Tu peux importer CSV ou Excel autant de fois que tu veux en suivant le modèle prédéfini, que tu peux télécharger directement là. S'il y a des données dans différentes devises, il te demandera de sélectionner les comptes pour chacune.";
"tutorials.createBudgets.step0.desc" = "Dans le menu sélectionne Planification et assure-toi d'être dans l'onglet Budgets. Utilise le bouton + pour en créer un nouveau.";
"tutorials.createBudgets.step1.desc" = "Donne-lui un nom, un montant et définis la période : hebdomadaire, mensuel, annuel ou unique (pour un voyage, événement, etc). Choisis quels comptes, catégories, étiquettes et besoins tu veux suivre. Active les notifications si tu veux des alertes à certains seuils.";
"tutorials.createBudgets.step2.desc" = "Active « Afficher dans le widget » pour le voir dans le widget Budgets du Panel.";
"tutorials.createBudgets.step3.desc" = "N'oublie pas que tu pourras toujours revenir pour modifier ton budget en le touchant.";
"tutorials.createScheduledPayments.step0.desc" = "Dans le menu sélectionne Planification et assure-toi d'être dans l'onglet Paiements planifiés. Utilise le bouton + pour en créer un nouveau.";
"tutorials.createScheduledPayments.step1.desc" = "Complète le nom de ton paiement, montant, note (optionnel), compte, sous-catégorie et étiquettes (optionnel).";
"tutorials.createScheduledPayments.step2.desc" = "Sélectionne le jour du paiement et la périodicité. Choisis quand sera le premier paiement et active les notifications si tu veux être averti le jour même ou quelques jours avant.";
"tutorials.createScheduledPayments.step3.desc" = "Dans « Plus d’options », active « Est-ce un abonnement? » si c'en est un.";
"tutorials.createScheduledPayments.step4.desc" = "En touchant un paiement planifié tu pourras voir les futurs paiements, ceux déjà effectués et le modifier quand tu veux.";
"tutorials.createFavorites.step0.desc" = "Dans Nouvel enregistrement, touche « Favori », sous le montant, pour enregistrer comme favori ce que tu as déjà saisi.";
"tutorials.createFavorites.step1.desc" = "La prochaine fois, touche le favori dans la rangée en haut du formulaire : les champs enregistrés se remplissent tout seuls.";
"tutorials.editPanel.step0.desc" = "Va à l'écran principal où tu vois ton résumé de dépenses avec tous les widgets disponibles.";
"tutorials.editPanel.step1.desc" = "Touche le bouton à petits carrés à côté de chaque section du Panel pour choisir quels widgets voir et dans quel ordre.";
"tutorials.editPanel.step2.desc" = "N'oublie pas que tu peux toujours revenir à l'ordre par défaut en touchant « Réinitialiser la disposition » dans la personnalisation.";
"tutorials.panelFiltering.step0.desc" = "Tire le meilleur parti des graphiques interactifs de Yala. Presque tous les panneaux sont filtrables par catégorie, besoin, entre autres. Joue avec eux et trouve ce qui te sert le mieux.";
"tutorials.panelFiltering.step1.desc" = "Tu as une barre de filtres où tu verras tous les filtres appliqués. Tu peux les retirer individuellement ou tous à la fois quand tu veux.";
"tutorials.panelFiltering.step2.desc" = "Dans les différentes vues de l'application tu verras que tu peux filtrer comme tu veux avec les graphiques.";
"tutorials.panelFiltering.step3.desc" = "Les filtres se propagent à toutes les vues de la même façon, ainsi tu peux voir toutes sortes de métriques pour ce que tu veux filtrer.";
"tutorials.panelFiltering.step4.desc" = "Dans certaines vues tu auras aussi une section de filtres en haut pour filtrer comme tu veux ou tout retirer avec un seul bouton.";
"tutorials.inboxApproval.step0.desc" = "Dans la Boîte de réception arrive ce que Yala a noté pour toi : ce que tu dictes ou prends en photo, les paiements Apple Pay que le raccourci enregistre et les paiements planifiés arrivés à échéance. Ils restent en brouillon jusqu'à ce que tu les vérifies.";
"tutorials.inboxApproval.step1.desc" = "Complète simplement les champs obligatoires et approuve. L'enregistrement se créera normalement.";
"tutorials.inboxApproval.step2.desc" = "Si plusieurs brouillons sont déjà complets, touche « Enregistrer les prêts » et ils passent dans tes enregistrements d'un coup.";
"tutorials.inboxApproval.step3.desc" = "Balaie un brouillon pour le rejeter, ou ouvre-le pour le compléter et l'approuver quand tu veux.";
"tutorials.applePay.step0.desc" = "Ouvre l'app Raccourcis et va dans Automatisation. Si tu ne la vois pas en bas, elle est dans Bibliothèque.";
"tutorials.applePay.step1.desc" = "Touche +, choisis Wallet et sélectionne les cartes que tu utilises. Si c'est proposé, choisis Exécuter immédiatement.";
"tutorials.applePay.step2.desc" = "Si on te le demande, touche Créer un raccourci. Cherche Yala et choisis le raccourci « Enregistrer un paiement Apple Pay ».";
"tutorials.applePay.step3.desc" = "Dans Montant sélectionne Entrée du raccourci puis Quantité. Fais la même chose pour Commerçant et Nom respectivement. Si « Afficher à l'exécution » apparaît, désactive-le.";
"tutorials.applePay.completion.title" = "Apple Pay connecté !";
"tutorials.applePay.completion.desc" = "Avec ça tu auras maintenant des enregistrements automatiques chaque fois que tu utilises Apple Pay avec les cartes sélectionnées. Chaque paiement créera un brouillon dans ta boîte de réception.";
