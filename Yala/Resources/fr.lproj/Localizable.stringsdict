<dict>
	<key>account.deleteConfirmMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Ce compte a %d enregistrement. Il n'est pas supprimé : il reste dans Enregistrements, sans compte. Si vous voulez seulement ne plus voir le compte, archivez-le. Cette action est irréversible.</string>
			<key>other</key>
			<string>Ce compte a %d enregistrements. Ils ne sont pas supprimés : ils restent dans Enregistrements, sans compte. Si vous voulez seulement ne plus voir le compte, archivez-le. Cette action est irréversible.</string>
		</dict>
	</dict>
	<key>category.cannotDeleteMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Cette catégorie a une sous-catégorie avec %d transaction. Pour la supprimer, supprimez ou transférez d'abord cette transaction de sa sous-catégorie.</string>
			<key>other</key>
			<string>Cette categorie a des sous-categories avec %d transactions. Pour la supprimer, supprimez ou transferez d'abord les transactions de chaque sous-categorie.</string>
		</dict>
	</dict>
