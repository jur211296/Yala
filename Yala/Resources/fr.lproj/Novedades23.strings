"novedades23.duo.title" = "Conçu pour l'iPhone Duo";
"novedades23.duo.description" = "Ouvert, profite du grand écran avec tes listes et leur détail côte à côte. Fermé, Yala s'adapte à l'écran extérieur.";
"novedades23.cards.title" = "Tes comptes, comme des cartes";
"novedades23.cards.description" = "Crée la carte de chaque compte avec des modèles, des couleurs et tes 4 derniers chiffres. Touche-la dans le Panel pour voir son solde, ce qui est facturé et quand payer.";
"novedades23.groups.title" = "Des groupes plus simples";
"novedades23.groups.description" = "Partage un ticket avec une photo ou ta voix, règle les dettes en moins de paiements et importe tes groupes de Splitwise ou Tricount avec les mêmes soldes.";
"novedades23.records.title" = "Des enregistrements plus rapides";
"novedades23.records.description" = "Filtre par compte ou catégorie en un geste, passe d'un mois à l'autre dans le calendrier et transforme n'importe quel enregistrement en paiement récurrent.";
"novedades23.health.title" = "Ta note de santé, plus complète";
"novedades23.health.description" = "Elle regarde maintenant aussi ce qu'il te reste de ce qui entre. Touche-la dans le Panel pour voir ce qui la fait le plus bouger ce mois-ci.";
"novedades23.planning.title" = "Ce que tu peux dépenser aujourd'hui";
"novedades23.planning.description" = "Chaque budget te dit combien tu peux dépenser aujourd'hui, et Yala te propose les abonnements qu'il trouve dans tes enregistrements.";
"novedades23.ant.title" = "Petites dépenses récurrentes";
"novedades23.ant.description" = "Vois ce que coûtent tes petits achats mis bout à bout et, avec « Voir la projection », comment ton mois pourrait se terminer.";
"novedades23.hide.title" = "Masque tes montants";
"novedades23.hide.description" = "Touche l'œil du Panel et tes chiffres disparaissent : idéal quand quelqu'un regarde ton écran.";
