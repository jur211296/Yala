/*
  CorreosBancoGuia.strings
  Yala

  Guía de «Correo del banco» para quien nunca configuró un reenvío (23-nov-2026): cada paso dice dónde entrar, qué
  tocar y qué se va a ver. Más el «Volver a este paso» de `YalaStepGuide`. Tabla propia, leída con el idioma de la app
  (`L10n.CorreosBancoGuia`). Los nombres de los botones de Gmail, Outlook e iCloud son los de ESA app en este idioma.
*/

"correosGuia.guideLine" = "Ça se règle une seule fois, dans Safari : l’app de ta messagerie n’a pas cette option. Ça prend quelques minutes.";
"correosGuia.findBank" = "Avant de commencer, trouve l’adresse de ta banque : ouvre une alerte qu’elle t’a envoyée et regarde qui l’envoie, dans « De » (par exemple, alertes@tabanque.fr).";

"correosGuia.copy.title" = "Copie ton adresse Yala";
"correosGuia.copy.detail" = "Touche « Copier l’adresse ». Tu ne verras aucun changement : l’adresse est gardée pour que tu la colles dans ta messagerie. Si tu la perds, il y a un autre bouton pour la copier en haut, à côté de ton adresse.";

"correosGuia.gmail.add.title" = "Ajoute ton adresse Yala dans Gmail";
"correosGuia.gmail.add.detail" = "1. Touche « Ouvrir Gmail ». Gmail s’ouvre dans Safari, dans la section du transfert. Connecte-toi si on te le demande.\n2. Si tu vois la version mobile, touche le bouton de la barre d’adresse de Safari et choisis « Demander le site web pour ordinateur ».\n3. Touche « Ajouter une adresse de transfert ».\n4. Garde le doigt dans le champ, touche « Coller » puis « Suivant ».\n5. Une fenêtre s’ouvre : touche « Continuer » puis « OK ».\nNe coche pas « Transférer une copie des messages entrants » : tout ton courrier serait envoyé. Le filtre de l’étape 4 trie les alertes de ta banque.";
"correosGuia.gmail.confirm.title" = "Confirme ton adresse Yala dans Gmail";
"correosGuia.gmail.confirm.waiting" = "Gmail a envoyé un lien de confirmation à ton adresse Yala, et Yala le cherche pour toi toutes les quelques secondes. Si tu veux, touche « Chercher maintenant ». Quand il arrive, touche « Confirmer sur Google ».";
"correosGuia.gmail.confirm.code" = "Ton code Gmail est %@.\n1. Touche « Copier le code ».\n2. Retourne dans Gmail, sur le même écran de transfert.\n3. Colle le code dans le champ de confirmation et touche « Valider ». Si tu ne vois pas le champ, recharge la page.";
"correosGuia.gmail.confirm.link" = "Le lien de confirmation de Gmail est arrivé.\n1. Touche « Confirmer sur Google ». Une page Google s’ouvre ; si elle te demande de confirmer, touche « Confirmer ».\n2. Reviens dans Yala pour l’étape suivante.";
"correosGuia.gmail.filter.title" = "Crée un filtre pour les alertes de ta banque";
"correosGuia.gmail.filter.detail" = "1. Dans Gmail, dans Safari, écris l’adresse de ta banque dans la barre de recherche en haut.\n2. Touche le bouton des options, à droite de la recherche, puis « Créer un filtre ».\n3. Coche « Transférer à » et choisis ton adresse Yala.\n4. Touche « Créer un filtre ».\nSi ta banque t’écrit depuis plusieurs adresses, refais ces étapes pour chacune.";

"correosGuia.rule.title" = "Crée une règle pour les alertes de ta banque";
"correosGuia.outlook.rule.detail" = "1. Touche « Ouvrir Outlook ». Outlook s’ouvre dans Safari, dans la section des règles. Connecte-toi si on te le demande.\n2. Touche « Ajouter une nouvelle règle » et donne-lui un nom, par exemple « Yala ».\n3. Pour la condition, choisis « De » et écris l’adresse de ta banque.\n4. Pour l’action, choisis « Transférer à » et colle ton adresse Yala.\n5. Touche « Enregistrer ».";
"correosGuia.icloud.rule.detail" = "1. Touche « Ouvrir iCloud Mail ». iCloud.com s’ouvre dans Safari. Connecte-toi avec ton compte Apple si on te le demande.\n2. Touche le bouton des réglages (la roue dentée) et choisis « Règles ».\n3. Touche « Ajouter une règle ».\n4. Sous « Si un message », choisis « provient de » et écris l’adresse de ta banque.\n5. Sous « Alors », choisis « Transférer à » et colle ton adresse Yala.\n6. Touche « OK ».";

"correosGuia.wait.title" = "C’est fait : attends la prochaine alerte";
"correosGuia.wait.detail" = "Tu n’as plus rien à faire. Quand ta banque enverra sa prochaine alerte, l’opération arrivera dans ta Boîte de réception pour que tu la confirmes. Si rien n’arrive au bout d’un jour, vérifie que le filtre ou la règle utilise la même adresse que celle d’où t’écrit ta banque.";

"correosGuia.stepGuide.reopen" = "Revenir à cette étape";
"correosGuia.stepGuide.reopenHint" = "Rouvre cette étape pour la refaire ou terminer ce qui manquait.";
