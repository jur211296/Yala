/*
  CorreosBancoGuia.strings
  Yala

  Guía de «Correo del banco» para quien nunca configuró un reenvío (23-nov-2026): cada paso dice dónde entrar, qué
  tocar y qué se va a ver. Más el «Volver a este paso» de `YalaStepGuide`. Tabla propia, leída con el idioma de la app
  (`L10n.CorreosBancoGuia`). Los nombres de los botones de Gmail, Outlook e iCloud son los de ESA app en este idioma.
*/

"correosGuia.guideLine" = "Você configura uma vez só, no Safari: o app do seu e-mail não tem essa opção. Leva poucos minutos.";
"correosGuia.findBank" = "Antes de começar, encontre o endereço do seu banco: abra um aviso que ele enviou e veja quem mandou, em “De” (por exemplo, avisos@seubanco.com.br).";

"correosGuia.copy.title" = "Copie seu endereço do Yala";
"correosGuia.copy.detail" = "Toque em “Copiar endereço”. Você não vai ver nenhuma mudança: o endereço fica guardado para colar no seu e-mail. Se perder, tem outro botão para copiá-lo lá em cima, ao lado do seu endereço.";

"correosGuia.gmail.add.title" = "Adicione seu endereço do Yala no Gmail";
"correosGuia.gmail.add.detail" = "1. Toque em “Abrir o Gmail”. O Gmail abre no Safari, na seção de encaminhamento. Se pedir, faça login.\n2. Se aparecer a versão para celular, toque no botão da barra de endereços do Safari e escolha “Solicitar Site para Computador”.\n3. Toque em “Adicionar um endereço de encaminhamento”.\n4. Mantenha o dedo no campo, toque em “Colar” e depois em “Próxima”.\n5. Abre uma janela: toque em “Continuar” e depois em “OK”.\nNão marque “Encaminhar uma cópia dos e-mails recebidos”: assim todo o seu e-mail seria enviado. Os avisos do banco são separados pelo filtro do passo 4.";
"correosGuia.gmail.confirm.title" = "Confirme seu endereço do Yala no Gmail";
"correosGuia.gmail.confirm.waiting" = "O Gmail enviou um link de confirmação para o seu endereço do Yala, e o Yala procura por você a cada poucos segundos. Se quiser, toque em “Buscar agora”. Quando chegar, toque em “Confirmar no Google”.";
"correosGuia.gmail.confirm.code" = "Seu código do Gmail é %@.\n1. Toque em “Copiar código”.\n2. Volte ao Gmail, na mesma tela de encaminhamento.\n3. Cole o código no campo de confirmação e toque em “Verificar”. Se não vir o campo, recarregue a página.";
"correosGuia.gmail.confirm.link" = "O link de confirmação do Gmail chegou.\n1. Toque em “Confirmar no Google”. Abre uma página do Google; se pedir para confirmar, toque em “Confirmar”.\n2. Volte ao Yala para o próximo passo.";
"correosGuia.gmail.filter.title" = "Crie um filtro para os avisos do seu banco";
"correosGuia.gmail.filter.detail" = "1. No Gmail, no Safari, digite o endereço do seu banco na barra de pesquisa lá em cima.\n2. Toque no botão de opções, à direita da pesquisa, e depois em “Criar filtro”.\n3. Marque “Encaminhar para” e escolha seu endereço do Yala.\n4. Toque em “Criar filtro”.\nSe o seu banco escreve de vários endereços, repita esses passos para cada um.";

"correosGuia.rule.title" = "Crie uma regra para os avisos do seu banco";
"correosGuia.outlook.rule.detail" = "1. Toque em “Abrir o Outlook”. O Outlook abre no Safari, na seção de regras. Se pedir, faça login.\n2. Toque em “Adicionar nova regra” e dê um nome, por exemplo “Yala”.\n3. Na condição, escolha “De” e digite o endereço do seu banco.\n4. Na ação, escolha “Encaminhar para” e cole seu endereço do Yala.\n5. Toque em “Salvar”.";
"correosGuia.icloud.rule.detail" = "1. Toque em “Abrir o iCloud Mail”. O iCloud.com abre no Safari. Se pedir, faça login com sua Conta Apple.\n2. Toque no botão de ajustes (a engrenagem) e escolha “Regras”.\n3. Toque em “Adicionar uma regra”.\n4. Em “Se uma mensagem”, escolha “é de” e digite o endereço do seu banco.\n5. Em “Então”, escolha “Encaminhar para” e cole seu endereço do Yala.\n6. Toque em “OK”.";

"correosGuia.wait.title" = "Pronto: espere o próximo aviso";
"correosGuia.wait.detail" = "Não precisa fazer mais nada. Quando o seu banco mandar o próximo aviso, a transação chega na sua Caixa de Entrada para você confirmar. Se passar um dia e não chegar nada, confira se o filtro ou a regra usa o mesmo endereço de onde o seu banco escreve.";

"correosGuia.stepGuide.reopen" = "Voltar a este passo";
"correosGuia.stepGuide.reopenHint" = "Abre este passo de novo para repeti-lo ou terminar o que faltou.";
