"tutorials.createScheduledPayments.step1.desc" = "Preencha o nome do seu pagamento, valor, nota (opcional), conta, subcategoria e etiquetas (opcional).";
"tutorials.createScheduledPayments.step2.desc" = "Selecione o dia do pagamento e a periodicidade. Escolha quando será o primeiro pagamento e ative as notificações se quiser receber um aviso no mesmo dia ou dias antes.";
"tutorials.createScheduledPayments.step3.desc" = "Não se esqueça de ativar o botão de assinatura se for uma assinatura recorrente.";
"tutorials.createScheduledPayments.step4.desc" = "Ao tocar em um pagamento agendado, você poderá ver os pagamentos futuros, os já realizados e editá-lo quando quiser.";
"tutorials.createFavorites.step0.desc" = "Vá para a tela de nova transação e toque na estrela na parte superior para criar um novo favorito.";
"tutorials.createFavorites.step1.desc" = "Preencha os campos que você quer que sejam pré-preenchidos. Da próxima vez, simplesmente toque no favorito e você verá como todos os campos se completam automaticamente.";
"tutorials.editPanel.step0.desc" = "Vá para a tela principal, onde você vê seu resumo de despesas com todos os widgets disponíveis.";
"tutorials.editPanel.step1.desc" = "Você pode modificar quais widgets ver e em que ordem tocando no botão de personalização no painel.";
"tutorials.editPanel.step2.desc" = "Lembre-se de que você sempre pode voltar à ordem padrão tocando em \"Restabelecer\" dentro da personalização.";
"tutorials.panelFiltering.step0.desc" = "Tire o máximo proveito dos gráficos interativos do Yala. Quase todos os painéis são filtráveis por categoria, natureza, entre outros. Brinque com eles e encontre o que mais te servir.";
"tutorials.panelFiltering.step1.desc" = "Você conta com uma barra de filtros onde vai ver todos os filtros aplicados. Você pode removê-los individualmente ou todos de uma vez quando quiser.";
"tutorials.panelFiltering.step2.desc" = "Nas diferentes telas do app, você verá que pode ir filtrando do seu jeito com os gráficos.";
"tutorials.panelFiltering.step3.desc" = "Os filtros se aplicam a todas as telas por igual, assim você pode ver todo tipo de métrica para o que quiser filtrar.";
"tutorials.panelFiltering.step4.desc" = "Em algumas telas você também contará com uma seção de filtros na parte superior para filtrar do seu jeito ou remover todos com um único botão.";
"tutorials.inboxApproval.step0.desc" = "Se você é usuário Yala Pro, quando fizer um registro por voz ou imagem, o app vai te levar automaticamente ao rascunho. O mesmo vale se você usou o atalho Registrar pagamento Apple Pay.";
"tutorials.inboxApproval.step1.desc" = "Basta preencher os campos obrigatórios e aprovar. A transação será criada normalmente.";
"tutorials.inboxApproval.step2.desc" = "Você também pode fazer registros de voz ou imagem com múltiplas transações. O app vai te dizer quantos rascunhos foram criados e te levar à caixa para revisá-los.";
"tutorials.inboxApproval.step3.desc" = "Na sua caixa, você pode aprovar transações, selecionar Aprovar depois para vê-las mais tarde ou rejeitá-las diretamente.";
"tutorials.applePay.step0.desc" = "Abra o app Atalhos e vá para a seção Automação.";
"tutorials.applePay.step1.desc" = "Toque em Nova Automação, selecione a opção Wallet, escolha os cartões que você quer usar e selecione Executar Imediatamente.";
"tutorials.applePay.step2.desc" = "Selecione Criar Novo Atalho e procure Yala bem no final da lista. No Yala, selecione o atalho Registrar pagamento Apple Pay.";
"tutorials.applePay.step3.desc" = "Em Valor selecione Entrada do Atalho e depois Quantidade. Faça o mesmo para Comerciante e Nome, respectivamente. Desative o botão \"Mostrar ao Executar\".";

