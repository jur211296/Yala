-- supabase-staging.ddl — snapshot-contract of the Modo Nube staging schema (project fostjbbwstyuunmmefuk).
-- Generated by qa/cloud/dump-schema.sh from the live schema. Offline mold cross-checked by
-- CloudCapabilityManifestParityTests (manifest <-> this snapshot). Append-only; regenerate on any schema change.
-- Every syncable table also has: CREATE INDEX (user_id, server_seq); BEFORE INSERT OR UPDATE trigger stamp_server_seq();
--   ENABLE ROW LEVEL SECURITY + 4 per-command policies USING/WITH CHECK ((select auth.uid()) = user_id);
--   GRANT SELECT,INSERT,UPDATE TO authenticated; REVOKE DELETE FROM authenticated, anon (tombstone = UPDATE deleted=true).

-- ============ per-user server_seq axis (E2E-S3+S4) ============
CREATE TABLE sync_seq_counters (user_id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE, seq BIGINT NOT NULL DEFAULT 0);
CREATE FUNCTION stamp_server_seq() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
BEGIN INSERT INTO sync_seq_counters (user_id, seq) VALUES (NEW.user_id, 1)
  ON CONFLICT (user_id) DO UPDATE SET seq = sync_seq_counters.seq + 1 RETURNING seq INTO NEW.server_seq; RETURN NEW; END; $$;

-- ============ 16 domain entities ============
CREATE TABLE accounts (
  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  sync_id UUID NOT NULL,
  name TEXT,
  currency_code TEXT,
  color_hex TEXT,
  icon_name TEXT,
  type TEXT,
  account_number TEXT,
  adjustment_mode TEXT,
  exclude_from_statistics BOOLEAN,
  is_archived BOOLEAN,
  is_system_account BOOLEAN,
  credit_card_payment_reminder BOOLEAN,
  credit_card_payment_day INTEGER,
  field_hlcs JSONB,
  hlc TEXT NOT NULL,
  deleted BOOLEAN NOT NULL DEFAULT false,
  deleted_hlc TEXT,
  server_seq BIGINT NOT NULL,
  schema_version INTEGER NOT NULL DEFAULT 1,
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  PRIMARY KEY (user_id, sync_id)
);

