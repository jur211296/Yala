-- ============ #18 user_preferences (KV, syncable; PK on key; no field_hlcs/deleted/schema_version) ============
CREATE TABLE user_preferences (
  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  key TEXT NOT NULL,
  value TEXT,
  hlc TEXT NOT NULL,
  server_seq BIGINT NOT NULL,
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  PRIMARY KEY (user_id, key)
);   -- + stamp_server_seq trigger (17th on the axis)

-- ============ #17 attest_keys (identity, NOT syncable; logical form — real home is Cloudflare D1) ============
CREATE TABLE attest_keys (
  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  key_id TEXT NOT NULL,
  public_key BYTEA,
  attestation_type TEXT NOT NULL DEFAULT 'app_attest',
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  last_seen_at TIMESTAMPTZ,
  PRIMARY KEY (user_id, key_id)
);
CREATE UNIQUE INDEX attest_keys_keyid_unique ON attest_keys (attestation_type, key_id);

-- ============ report_claims (A3 per-day server-side report dedup) ============
CREATE TABLE report_claims (
  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  report_type TEXT NOT NULL,
  local_day DATE NOT NULL,
  claimed_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  PRIMARY KEY (user_id, report_type, local_day)
);
CREATE FUNCTION claim_report(p_report_type TEXT, p_local_day DATE) RETURNS boolean
  LANGUAGE plpgsql SECURITY INVOKER SET search_path = public AS $$
BEGIN INSERT INTO report_claims (user_id, report_type, local_day)
  VALUES ((select auth.uid()), p_report_type, p_local_day)
  ON CONFLICT (user_id, report_type, local_day) DO NOTHING; RETURN FOUND; END; $$;
