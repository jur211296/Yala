{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "yala-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Web",
        "run",
        "dev"
      ],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "yala-screenshots",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "screenshots-appstore/generator",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}