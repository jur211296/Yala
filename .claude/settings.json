{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Task",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Bash(git push origin --delete:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune)",
      "Bash(tmutil deletelocalsnapshots:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-/Users/jur/Yala}\" && bash qa/scripts/disk-report.sh --guard 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Comprobando espacio en disco..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -q 'git commit' && echo '[commit detectado — recuerda pushear al final]' || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "if git diff --cached --name-only | grep -qE '\\.(env|pem|key)$'; then echo 'BLOCKED: Archivo sensible detectado' && exit 1; fi"
          },
          {
            "type": "command",
            "command": "bash qa/scripts/precommit-gate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date -Iseconds)] Sesion terminada\" >> .claude/sessions/activity.log"
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-/Users/jur/Yala}\" && git log @{u}..HEAD --oneline 2>/dev/null | grep -q . && git push origin HEAD 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Pushing unpushed commits..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "agent": "frank"
}
