+//
+//  SetupOfferMockups.swift
+//  Yala
+//
+//  MAQUETA DESCARTABLE (sesión de diseño del 2026-11-20, oferta Pro al final de Primeros pasos). No se commitea:
+//  viaja como parche en ~/Claude/entregas. `-mockOffer A|B|C` cambia el cuerpo de la oferta y `-mockOfferAll` abre
+//  «Qué incluye Yala Pro» empujada. Los textos van literales a propósito: son propuesta, no producto.
+//
+
+#if DEBUG
+import SwiftUI
+
+enum OfferMock {
+    static var variant: String? {
+        let args = ProcessInfo.processInfo.arguments
+        guard let i = args.firstIndex(of: "-mockOffer"), i + 1 < args.count else { return nil }
+        return args[i + 1]
+    }
+    static var startsOnAll: Bool { ProcessInfo.processInfo.arguments.contains("-mockOfferAll") }
+
+    /// Lo que mide la maqueta, a un fichero que se lee con `simctl get_app_container`.
+    @MainActor static var measures: [String: CGFloat] = [:]
+    @MainActor static func record(_ key: String, _ value: CGFloat) {
+        measures[key] = value
+        let text = measures.sorted { $0.key < $1.key }.map { "\($0.key)=\(Int($0.value.rounded()))" }.joined(separator: "\n")
+        let url = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("offer-measure.txt")
+        do { try text.write(to: url, atomically: true, encoding: .utf8) } catch { print("OfferMock: \(error)") }
+    }
+}
+
+extension View {
+    /// Apunta dónde acaba esta pieza dentro del scroll (el borde de abajo, en puntos desde arriba del contenido).
+    func mockMeasureBottom(_ key: String) -> some View {
+        onGeometryChange(for: CGFloat.self) { $0.frame(in: .global).maxY } action: { OfferMock.record(key, $0) }
+    }
+    /// Dónde empieza el botón fijo, en la pantalla.
+    func mockMeasureTop(_ key: String) -> some View {
+        onGeometryChange(for: CGFloat.self) { $0.frame(in: .global).minY } action: { OfferMock.record(key, $0) }
+    }
+}
+
+extension View {
+    /// Alto visible del scroll (sin barras) y alto del contenido.
+    func mockMeasureScroll() -> some View {
+        onScrollGeometryChange(for: [CGFloat].self) { geo in
+            [geo.containerSize.height, geo.contentInsets.top, geo.contentInsets.bottom, geo.contentSize.height,
+             geo.contentOffset.y]
+        } action: { _, v in
+            OfferMock.record("containerH", v[0])
+            OfferMock.record("insetTop", v[1])
+            OfferMock.record("insetBottom", v[2])
+            OfferMock.record("contentHeight", v[3])
+            OfferMock.record("offsetY", v[4])
+        }
+    }
+}
