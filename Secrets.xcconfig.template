// Secrets.xcconfig.template
// Copy this file to Secrets.xcconfig and fill in your API keys.
// Secrets.xcconfig is ignored by git and should NEVER be committed.

// OpenAI API Key (required for voice transcription)
// Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY = sk-your-api-key-here

// Exchange Rate API Key (required for currency conversion)
// Get your key at: https://exchangerate.host/
EXCHANGE_RATE_API_KEY = your-exchange-rate-api-key-here

// Sentry DSN (avisos de errores y caídas, proyecto `yala-ios`). Vacío = el SDK no arranca.
// En un .xcconfig `//` abre un comentario: escribe el DSN con `$()` entre las dos barras.
// Sentry → Settings → Projects → yala-ios → Client Keys (DSN). Ejemplo:
//   SENTRY_DSN = https:/$()/<key>@<org>.ingest.us.sentry.io/<proyecto>
// Vacío a propósito: el CI copia esta plantilla y no debe mandar avisos.
SENTRY_DSN =
