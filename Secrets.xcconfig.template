// Secrets.xcconfig.template
// Copy this file to Secrets.xcconfig and fill in your API keys.
// Secrets.xcconfig is ignored by git and should NEVER be committed.

// OpenAI API Key (required for voice transcription)
// Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY = sk-your-api-key-here

// Exchange Rate API Key (required for currency conversion)
// Get your key at: https://exchangerate.host/
EXCHANGE_RATE_API_KEY = your-exchange-rate-api-key-here
