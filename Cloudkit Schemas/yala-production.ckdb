        CD_needOverride              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_preferredCurrencyCode     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_scheduledPaymentID        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_splitDivisor              DOUBLE,
        CD_splitExpenseID            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_splitGroupZoneID          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_splitMyValue              DOUBLE,
        CD_splitSettlementID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_splitTotalAmount          DOUBLE QUERYABLE SORTABLE,
        CD_splitType                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_subcategory               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_syncID                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_tagIDs                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_transferPairID            STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"              TIMESTAMP,
        "___createdBy"               REFERENCE,
        "___etag"                    STRING,
        "___modTime"                 TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"              REFERENCE,
        "___recordID"                REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
