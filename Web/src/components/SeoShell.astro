---
// Marco común de las páginas de funciones y de preguntas frecuentes (es / en): cabecera con migas,
// enlace al otro idioma, contenido y pie. Mismo estilo que Ayuda (SupportPage).
import { ui, seoPaths, type SeoLang } from '../content/seo';

interface Props {
  lang: SeoLang;
  /** Migas: la última es la página actual (sin href). */
  crumbs: { label: string; href?: string }[];
  /** La misma página en el otro idioma. */
  otherLangHref: string;
}

const { lang, crumbs, otherLangHref } = Astro.props;
const t = ui[lang];
const homeUrl = lang === 'es' ? '/' : '/en/';
const pfx = lang === 'es' ? '' : '/en';
const otherLang = lang === 'es' ? { code: 'en', label: 'English' } : { code: 'es', label: 'Español' };
---

<a href="#main" class="skip-link">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
<header class="max-w-3xl mx-auto px-6 pt-10 flex items-center justify-between gap-4 text-sm">
  <a href={homeUrl} class="flex items-center shrink-0" aria-label={`Yala — ${t.home}`}>
    <img src="/images/logo.png" alt="Yala" class="h-7 logo-dark" width="1200" height="400" style="width:auto" />
    <img src="/images/logo-light.png" alt="Yala" class="h-7 logo-light" width="1200" height="400" style="width:auto" />
  </a>
  <nav class="flex flex-wrap items-center justify-end gap-x-5 gap-y-1" aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
    <a href={seoPaths.features[lang]} class="text-neutral-300 hover:text-yala-cyan transition-colors">{t.features}</a>
    <a href={seoPaths.faq[lang]} class="text-neutral-300 hover:text-yala-cyan transition-colors">{t.faq}</a>
    <a href={otherLangHref} lang={otherLang.code} hreflang={otherLang.code} class="text-neutral-400 hover:text-yala-cyan transition-colors">{otherLang.label}</a>
  </nav>
</header>

<main id="main" class="min-h-screen">
  <div class="max-w-3xl mx-auto px-6 pt-8 pb-24">
    <nav aria-label={lang === 'es' ? 'Ruta' : 'Breadcrumb'} class="text-sm text-neutral-400 mb-6">
      <ol class="flex flex-wrap items-center gap-2">
        {crumbs.map((c, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true">/</span>}
            {c.href
              ? <a href={c.href} class="hover:text-yala-cyan transition-colors">{c.label}</a>
              : <span aria-current="page" class="text-neutral-300">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
    <slot />
  </div>
</main>

<footer class="border-t border-neutral-700 py-8">
  <div class="max-w-3xl mx-auto px-6 flex flex-wrap gap-5 text-sm text-neutral-400">
    <span>© 2026 Yala</span>
    <a href={`${pfx}/privacy/`} class="hover:text-yala-cyan transition-colors">{t.privacy}</a>
    <a href={`${pfx}/terms/`} class="hover:text-yala-cyan transition-colors">{t.terms}</a>
    <a href={`${pfx}/support/`} class="hover:text-yala-cyan transition-colors">{t.help}</a>
    <a href="mailto:admin@yala-app.pe" class="hover:text-yala-cyan transition-colors">admin@yala-app.pe</a>
  </div>
</footer>

<style is:global>
  .seo-card {
    background: rgba(28, 41, 71, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 18px 50px -20px rgba(0, 0, 0, 0.55);
  }
  body.light .seo-card {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.1);
    box-shadow: 0 10px 30px -18px rgba(15, 23, 42, 0.25);
  }
</style>
