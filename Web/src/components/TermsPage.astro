---
import type { Language } from '../i18n/translations';
import { getTranslation } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslation(lang);
const homeUrl = lang === 'es' ? '/' : `/${lang}/`;
const privacyUrl = lang === 'es' ? '/privacy' : `/${lang}/privacy`;
---

<main class="min-h-screen bg-yala-slate">
  <div class="max-w-3xl mx-auto px-6 py-24">
    <a href={homeUrl} class="text-yala-indigo hover:text-yala-cyan transition-colors mb-8 inline-flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      {t.termsBackHome}
    </a>

    <div class="prose-container p-8 rounded-3xl mt-8">
      <p class="text-neutral-500 text-sm mb-6">{t.termsLastUpdate}</p>

      <h1 class="text-3xl font-bold text-white mb-8">{t.termsH1}</h1>

      <!-- 1. Acceptance -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsIntroTitle}</h2>
        <p class="text-neutral-300 leading-relaxed" set:html={t.termsIntroText.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white">$1</strong>')} />
      </section>

      <!-- 2. Service Description -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsServiceTitle}</h2>
        <p class="text-neutral-300 leading-relaxed" set:html={t.termsServiceText.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white">$1</strong>')} />
      </section>

      <!-- 3. Account and Access -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsAccountTitle}</h2>
        <p class="text-neutral-300 leading-relaxed" set:html={t.termsAccountText.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white">$1</strong>')} />
      </section>

      <!-- 4. Acceptable Use (with bullets) -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsUsageTitle}</h2>
        <p class="text-neutral-300 leading-relaxed mb-4">{t.termsUsageIntro}</p>
        <ul class="space-y-3 text-neutral-300">
          <li class="flex items-start gap-3">
            <span class="text-yala-cyan mt-1">●</span>
            <span>{t.termsUsageBullet1}</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-yala-cyan mt-1">●</span>
            <span>{t.termsUsageBullet2}</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-yala-cyan mt-1">●</span>
            <span>{t.termsUsageBullet3}</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-yala-cyan mt-1">●</span>
            <span>{t.termsUsageBullet4}</span>
          </li>
        </ul>
      </section>

      <!-- 5. Your Data -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsDataTitle}</h2>
        <p class="text-neutral-300 leading-relaxed" set:html={t.termsDataText.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white">$1</strong>').replace(/Política de Privacidad|Privacy Policy|Datenschutzrichtlinie|Politique de Confidentialité|Informativa sulla Privacy|Política de Privacidade/, `<a href="${privacyUrl}" class="text-yala-cyan hover:text-yala-indigo transition-colors">$&</a>`)} />
      </section>

      <!-- 6. IP -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsIpTitle}</h2>
        <p class="text-neutral-300 leading-relaxed">{t.termsIpText}</p>
      </section>

      <!-- 7. Subscriptions -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsSubscriptionTitle}</h2>
        <p class="text-neutral-300 leading-relaxed">{t.termsSubscriptionText}</p>
      </section>

      <!-- 8. Disclaimer -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsDisclaimerTitle}</h2>
        <p class="text-neutral-300 leading-relaxed" set:html={t.termsDisclaimerText.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white">$1</strong>')} />
      </section>

      <!-- 9. Termination -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsTerminationTitle}</h2>
        <p class="text-neutral-300 leading-relaxed">{t.termsTerminationText}</p>
      </section>

      <!-- 10. Changes -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsChangesTitle}</h2>
        <p class="text-neutral-300 leading-relaxed">{t.termsChangesText}</p>
      </section>

      <!-- 11. Governing Law -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsLawTitle}</h2>
        <p class="text-neutral-300 leading-relaxed">{t.termsLawText}</p>
      </section>

      <!-- 12. Contact -->
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-white mb-3">{t.termsContactTitle}</h2>
        <p class="text-neutral-300 leading-relaxed">
          {t.termsContactText} <a href="mailto:admin@yala-app.pe" class="text-yala-cyan hover:text-yala-indigo transition-colors">admin@yala-app.pe</a>
        </p>
      </section>

      <!-- Trust badges -->
      <div class="mt-12 pt-8 border-t border-neutral-700">
        <div class="flex flex-wrap gap-6 justify-center text-neutral-400 text-sm">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-yala-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>100% Local</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-yala-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Privacy First</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-yala-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>App Store</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<style>
  .prose-container {
    background: rgba(28, 41, 71, 0.6);
    border: 1px solid rgba(51, 65, 85, 0.6);
  }

  .prose-container:hover {
    border-color: rgba(71, 85, 105, 1);
  }
</style>
