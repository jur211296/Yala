---
import type { Language } from '../i18n/translations';
import { getTranslations, languages } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// Build language URLs
const langUrls = Object.keys(languages).map(l => ({
  code: l,
  name: languages[l as Language],
  url: l === 'es' ? '/' : `/${l}/`,
  active: l === lang,
}));
---

<!-- Header -->
<header class="fixed top-0 left-0 right-0 z-50 header-bg border-b border-theme">
  <div class="container-wide">
    <nav class="flex items-center justify-between h-16">
      <a href={lang === 'es' ? '/' : `/${lang}/`} class="flex items-center">
        <img src="/images/logo.png" alt="Neto" class="h-7 logo-dark" />
        <img src="/images/logo-light.png" alt="Neto" class="h-7 logo-light" />
      </a>

      <div class="hidden sm:flex items-center gap-8">
        <a href="#features" class="text-sm text-secondary hover:text-primary transition-colors">{t.navFeatures}</a>
        <a href="#analytics" class="text-sm text-secondary hover:text-primary transition-colors">{t.navAnalytics}</a>
        <a href="#privacy" class="text-sm text-secondary hover:text-primary transition-colors">{t.navPrivacy}</a>
      </div>

      <div class="flex items-center gap-3">
        <!-- Language Selector -->
        <div class="relative">
          <button
            id="lang-toggle"
            class="flex items-center gap-1.5 text-sm text-secondary hover:text-primary px-3 py-2 rounded-full border border-theme hover:border-theme-hover transition-colors"
          >
            <span class="uppercase font-medium">{lang}</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="lang-menu" class="hidden absolute right-0 mt-2 py-2 w-36 bg-card border border-theme rounded-xl shadow-xl z-50">
            {langUrls.map(({ code, name, url, active }) => (
              <a
                href={url}
                class={`block px-4 py-2 text-sm transition-colors ${active ? 'text-accent font-medium' : 'text-secondary hover:text-primary hover:bg-card-hover'}`}
              >
                {name}
              </a>
            ))}
          </div>
        </div>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="w-9 h-9 rounded-full flex items-center justify-center bg-card border border-theme hover:border-theme-hover transition-colors"
          aria-label="Toggle theme"
        >
          <svg class="w-4 h-4 text-secondary icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <svg class="w-4 h-4 text-secondary icon-moon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>

        <a
          href="#"
          class="hidden sm:inline-flex text-sm font-medium text-primary bg-card hover:bg-card-hover border border-theme px-4 py-2 rounded-full transition-colors"
        >
          {t.navDownload}
        </a>
      </div>
    </nav>
  </div>
</header>

<main class="pt-16">

  <!-- Hero: 2 columns -->
  <section class="container-wide py-20 md:py-28">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div class="space-y-6 animate-on-scroll">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tighter text-primary leading-[1.08]">
          {t.heroTitle}
        </h1>
        <p class="text-lg text-secondary max-w-md leading-relaxed">
          {t.heroSubtitle}
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href="#"
            class="inline-flex items-center justify-center gap-2 btn-primary px-5 py-3 rounded-full font-medium transition-colors text-sm"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            {t.heroAppStore}
          </a>
          <a
            href="#features"
            class="inline-flex items-center justify-center gap-2 btn-secondary px-5 py-3 rounded-full font-medium transition-colors text-sm"
          >
            {t.heroLearnMore}
          </a>
        </div>
      </div>

      <div class="animate-on-scroll flex justify-center md:justify-end">
        <div class="relative">
          <img
            src="/images/screenshots/dark/dashboard.png"
            alt="Neto App Dashboard"
            class="screenshot-dark w-[280px] lg:w-[320px] rounded-[2.5rem] shadow-2xl shadow-black/60"
          />
          <img
            src="/images/screenshots/light/dashboard.png"
            alt="Neto App Dashboard"
            class="screenshot-light w-[280px] lg:w-[320px] rounded-[2.5rem] shadow-2xl shadow-black/30"
          />
          <div class="absolute -inset-8 bg-accent/10 blur-3xl -z-10 rounded-full"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section id="features" class="container-wide py-16 scroll-mt-20">
    <div class="animate-on-scroll mb-10">
      <h2 class="text-2xl sm:text-3xl font-semibold text-primary tracking-tight">
        {t.featuresTitle}
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="animate-on-scroll stagger-1 group p-5 rounded-2xl bg-card border border-theme hover:border-theme-hover transition-all">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-600 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-primary mb-1.5">{t.feature1Title}</h3>
        <p class="text-sm text-secondary leading-relaxed">{t.feature1Desc}</p>
      </div>

      <div class="animate-on-scroll stagger-2 group p-5 rounded-2xl bg-card border border-theme hover:border-theme-hover transition-all">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-primary mb-1.5">{t.feature2Title}</h3>
        <p class="text-sm text-secondary leading-relaxed">{t.feature2Desc}</p>
      </div>

      <div class="animate-on-scroll stagger-3 group p-5 rounded-2xl bg-card border border-theme hover:border-theme-hover transition-all">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-primary mb-1.5">{t.feature3Title}</h3>
        <p class="text-sm text-secondary leading-relaxed">{t.feature3Desc}</p>
      </div>

      <div class="animate-on-scroll group p-5 rounded-2xl bg-card border border-theme hover:border-theme-hover transition-all">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-pink-500 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-primary mb-1.5">{t.feature4Title}</h3>
        <p class="text-sm text-secondary leading-relaxed">{t.feature4Desc}</p>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="container-wide py-12">
    <div class="animate-on-scroll flex flex-wrap justify-center gap-8 md:gap-16 text-center">
      <div>
        <div class="text-3xl font-bold text-primary">100%</div>
        <div class="text-sm text-muted mt-1">{t.stat1}</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-primary">∞</div>
        <div class="text-sm text-muted mt-1">{t.stat2}</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-primary">50+</div>
        <div class="text-sm text-muted mt-1">{t.stat3}</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-primary">0</div>
        <div class="text-sm text-muted mt-1">{t.stat4}</div>
      </div>
    </div>
  </section>

  <!-- Screenshots -->
  <section class="container-wide py-16 overflow-hidden">
    <div class="animate-on-scroll mb-10">
      <h2 class="text-2xl sm:text-3xl font-semibold text-primary tracking-tight text-center">
        {t.screenshotsTitle}
      </h2>
      <p class="text-secondary text-center mt-3 max-w-lg mx-auto">
        {t.screenshotsSubtitle}
      </p>
    </div>

    <div class="animate-on-scroll">
      <!-- Dark mode screenshots -->
      <div class="screenshots-dark flex justify-center gap-4 md:gap-6">
        <div class="w-[160px] sm:w-[200px] md:w-[240px] shrink-0">
          <img src="/images/screenshots/dark/dashboard.png" alt="Panel" class="rounded-[1.5rem] sm:rounded-[2rem] shadow-2xl shadow-black/50" />
        </div>
        <div class="w-[160px] sm:w-[200px] md:w-[240px] shrink-0 mt-8">
          <img src="/images/screenshots/dark/stats.png" alt="Stats" class="rounded-[1.5rem] sm:rounded-[2rem] shadow-2xl shadow-black/50" />
        </div>
        <div class="hidden sm:block w-[200px] md:w-[240px] shrink-0 mt-16">
          <img src="/images/screenshots/dark/categories.png" alt="Categories" class="rounded-[1.5rem] sm:rounded-[2rem] shadow-2xl shadow-black/50" />
        </div>
      </div>
      <!-- Light mode screenshots -->
      <div class="screenshots-light flex justify-center gap-4 md:gap-6">
        <div class="w-[160px] sm:w-[200px] md:w-[240px] shrink-0">
          <img src="/images/screenshots/light/dashboard.png" alt="Panel" class="rounded-[1.5rem] sm:rounded-[2rem] shadow-2xl shadow-black/30" />
        </div>
        <div class="w-[160px] sm:w-[200px] md:w-[240px] shrink-0 mt-8">
          <img src="/images/screenshots/light/stats.png" alt="Stats" class="rounded-[1.5rem] sm:rounded-[2rem] shadow-2xl shadow-black/30" />
        </div>
        <div class="hidden sm:block w-[200px] md:w-[240px] shrink-0 mt-16">
          <img src="/images/screenshots/light/categories.png" alt="Categories" class="rounded-[1.5rem] sm:rounded-[2rem] shadow-2xl shadow-black/30" />
        </div>
      </div>
    </div>
  </section>

  <!-- Analytics Section -->
  <section id="analytics" class="container-wide py-16 scroll-mt-20">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="animate-on-scroll order-2 md:order-1 flex justify-center">
        <img src="/images/screenshots/dark/stats.png" alt="Analytics" class="screenshot-dark w-[260px] rounded-[2rem] shadow-2xl shadow-black/50" />
        <img src="/images/screenshots/light/stats.png" alt="Analytics" class="screenshot-light w-[260px] rounded-[2rem] shadow-2xl shadow-black/30" />
      </div>
      <div class="animate-on-scroll order-1 md:order-2 space-y-5">
        <h2 class="text-2xl sm:text-3xl font-semibold text-primary tracking-tight">
          {t.analyticsTitle}
        </h2>
        <p class="text-secondary leading-relaxed">
          {t.analyticsDesc}
        </p>
        <ul class="space-y-3 text-secondary text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {t.analyticsBullet1}
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {t.analyticsBullet2}
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {t.analyticsBullet3}
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Privacy -->
  <section id="privacy" class="container-wide py-16 scroll-mt-20">
    <div class="animate-on-scroll max-w-2xl mx-auto text-center">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-neutral-600 to-neutral-700 flex items-center justify-center mx-auto mb-5">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold text-primary tracking-tight mb-3">
        {t.privacyTitle}
      </h2>
      <p class="text-secondary leading-relaxed">
        {t.privacyDesc}
      </p>
      <a href={lang === 'es' ? '/privacy' : `/${lang}/privacy`} class="inline-block mt-5 text-sm text-accent hover:text-accent-light transition-colors">
        {t.privacyLink} →
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-wide py-20">
    <div class="animate-on-scroll bg-card-cta border border-theme rounded-3xl p-10 md:p-14 text-center">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-primary tracking-tight mb-4">
        {t.ctaTitle}
      </h2>
      <p class="text-secondary mb-8 max-w-md mx-auto">
        {t.ctaSubtitle}
      </p>
      <a
        href="#"
        class="inline-flex items-center justify-center gap-2 btn-primary px-7 py-3.5 rounded-full font-medium transition-colors"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        {t.heroAppStore}
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="container-wide py-10 border-t border-theme">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-6">
        <img src="/images/logo.png" alt="Neto" class="h-5 logo-dark" />
        <img src="/images/logo-light.png" alt="Neto" class="h-5 logo-light" />
        <span class="text-muted text-sm">© 2026</span>
      </div>
      <div class="flex gap-6 text-sm text-muted">
        <a href={lang === 'es' ? '/privacy' : `/${lang}/privacy`} class="hover:text-secondary transition-colors">{t.footerPrivacy}</a>
        <a href="#" class="hover:text-secondary transition-colors">{t.footerTerms}</a>
        <a href="mailto:admin@neto.com.pe" class="hover:text-secondary transition-colors">{t.footerContact}</a>
      </div>
    </div>
  </footer>

</main>

<!-- Scripts -->
<script>
  // Language menu toggle
  const langToggle = document.getElementById('lang-toggle');
  const langMenu = document.getElementById('lang-menu');

  langToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    langMenu?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    langMenu?.classList.add('hidden');
  });

  // Save language preference when user clicks a language link
  document.querySelectorAll('#lang-menu a').forEach(link => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href');
      if (href) {
        const lang = href === '/' ? 'es' : href.replace(/\//g, '');
        document.cookie = `lang=${lang}; path=/; max-age=31536000`; // 1 year
      }
    });
  });

  // Theme toggle
  const toggle = document.getElementById('theme-toggle');
  const iconSun = document.querySelector('.icon-sun');
  const iconMoon = document.querySelector('.icon-moon');

  function setTheme(isDark: boolean) {
    if (isDark) {
      document.body.classList.remove('light');
      iconSun?.classList.remove('hidden');
      iconMoon?.classList.add('hidden');
    } else {
      document.body.classList.add('light');
      iconSun?.classList.add('hidden');
      iconMoon?.classList.remove('hidden');
    }
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  const savedTheme = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

  if (savedTheme) {
    setTheme(savedTheme === 'dark');
  } else {
    setTheme(prefersDark);
  }

  toggle?.addEventListener('click', () => {
    const isDark = !document.body.classList.contains('light');
    setTheme(!isDark);
  });

  // Scroll animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.animate-on-scroll').forEach(el => {
    observer.observe(el);
  });
</script>

<style>
  .text-primary { color: var(--text-primary); }
  .text-secondary { color: var(--text-secondary); }
  .text-muted { color: var(--text-muted); }
  .bg-card { background-color: var(--bg-card); }
  .bg-card-cta { background: linear-gradient(to bottom right, var(--bg-card), var(--bg-secondary)); }
  .bg-card-hover { background-color: var(--bg-secondary); }
  .border-theme { border-color: var(--border-color); }
  .border-theme-hover { border-color: var(--border-hover); }
  .header-bg { background-color: var(--header-bg); backdrop-filter: blur(12px); }

  .btn-primary {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
  }
  .btn-primary:hover {
    background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
  }
  .btn-secondary {
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }
  .btn-secondary:hover {
    background-color: var(--bg-card);
  }

  .text-accent { color: #6366f1; }
  .text-accent-light { color: #818cf8; }

  /* Screenshot theme switching */
  .screenshot-dark { display: block; }
  .screenshots-dark { display: flex; }
  .screenshot-light,
  .screenshots-light { display: none; }

  :global(body.light) .screenshot-dark,
  :global(body.light) .screenshots-dark { display: none; }
  :global(body.light) .screenshot-light { display: block; }
  :global(body.light) .screenshots-light { display: flex; }
</style>
