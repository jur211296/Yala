---
import type { Language } from '../i18n/translations';
import { getTranslation, languages } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslation(lang);

const langUrls = Object.keys(languages).map(l => ({
  code: l,
  name: languages[l as Language],
  url: l === 'es' ? '/' : `/${l}/`,
  active: l === lang,
}));

const privacyUrl = lang === 'es' ? '/privacy' : `/${lang}/privacy`;
---

<!-- Header -->
<header class="fixed top-0 left-0 right-0 z-50 header-blur" style="background: var(--header-bg); border-bottom: 1px solid var(--border-color);">
  <div class="container-wide">
    <nav class="flex items-center justify-between h-16">
      <a href={lang === 'es' ? '/' : `/${lang}/`} class="flex items-center">
        <img src="/images/logo.png" alt="Yala" class="h-7 logo-dark" />
        <img src="/images/logo-light.png" alt="Yala" class="h-7 logo-light" />
      </a>

      <div class="hidden md:flex items-center gap-8">
        <a href="#features" class="text-sm text-neutral-400 hover:text-white transition-colors">{t.navFeatures}</a>
        <a href="#how" class="text-sm text-neutral-400 hover:text-white transition-colors">{t.navHow}</a>
        <a href="#pricing" class="text-sm text-neutral-400 hover:text-white transition-colors">{t.navPricing}</a>
        <a href="#privacy" class="text-sm text-neutral-400 hover:text-white transition-colors">{t.navPrivacy}</a>
      </div>

      <div class="flex items-center gap-3">
        <!-- Language Selector -->
        <div class="relative">
          <button id="lang-toggle" class="flex items-center gap-1.5 text-sm text-neutral-400 hover:text-white px-3 py-2 rounded-full border border-neutral-700 hover:border-neutral-500 transition-colors">
            <span class="uppercase font-medium">{lang}</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="lang-menu" class="hidden absolute right-0 mt-2 py-2 w-36 rounded-xl shadow-xl z-50" style="background: var(--bg-card); border: 1px solid var(--border-color);">
            {langUrls.map(({ code, name, url, active }) => (
              <a href={url} class={`block px-4 py-2 text-sm transition-colors ${active ? 'text-yala-cyan font-medium' : 'text-neutral-400 hover:text-white hover:bg-neutral-800/50'}`}>
                {name}
              </a>
            ))}
          </div>
        </div>

        <!-- Theme Toggle -->
        <button id="theme-toggle" class="w-9 h-9 rounded-full flex items-center justify-center border border-neutral-700 hover:border-neutral-500 transition-colors" style="background: var(--bg-card);" aria-label="Toggle theme">
          <svg class="w-4 h-4 text-neutral-400 icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <svg class="w-4 h-4 text-neutral-400 icon-moon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>

        <a href="https://apps.apple.com/app/yala" target="_blank" rel="noopener" class="hidden sm:inline-flex btn-primary text-sm">
          {t.navDownload}
        </a>
      </div>
    </nav>
  </div>
</header>

<main class="pt-16">

  <!-- HERO SECTION -->
  <section class="container-wide py-20 md:py-32">
    <div class="max-w-4xl mx-auto text-center space-y-8 animate-on-scroll">
      <!-- Tagline -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-yala-cyan/30 bg-yala-cyan/5">
        <span class="w-2 h-2 rounded-full bg-yala-cyan animate-pulse"></span>
        <span class="text-sm font-medium text-yala-cyan">{t.heroTagline}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tighter leading-[1.1]">
        <span class="text-white">{t.heroTitle}</span>
        <br />
        <span class="text-gradient">{t.heroTitleAccent}</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        {t.heroSubtitle}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
        <a href="https://apps.apple.com/app/yala" target="_blank" rel="noopener" class="btn-primary inline-flex items-center justify-center gap-2">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          {t.heroAppStore}
        </a>
        <a href="#how" class="btn-secondary inline-flex items-center justify-center gap-2">
          {t.heroLearnMore}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
      </div>

      <!-- Trust Badges -->
      <p class="text-sm text-neutral-500 pt-4">{t.heroTrust}</p>
    </div>

    <!-- App Screenshot Placeholder -->
    <div class="mt-16 max-w-sm mx-auto">
      <div class="aspect-[9/19] rounded-[3rem] border-4 border-neutral-700 bg-gradient-to-b from-yala-slate to-neutral-900 p-3 shadow-2xl shadow-yala-indigo/20">
        <div class="w-full h-full rounded-[2.5rem] bg-neutral-800 flex items-center justify-center">
          <div class="text-center space-y-3">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-yala-indigo to-yala-pink flex items-center justify-center">
              <span class="text-2xl font-bold text-white">Y</span>
            </div>
            <p class="text-neutral-500 text-sm">Screenshot placeholder</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM SECTION -->
  <section class="py-20 md:py-28" style="background: var(--bg-secondary);">
    <div class="container-wide">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-16 animate-on-scroll">{t.problemTitle}</h2>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <!-- Problem Card 1 -->
        <div class="card p-8 animate-on-scroll stagger-1">
          <div class="w-14 h-14 rounded-2xl bg-nature-essential/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-nature-essential" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">{t.problemCard1Title}</h3>
          <p class="text-neutral-400 leading-relaxed">{t.problemCard1Desc}</p>
        </div>

        <!-- Problem Card 2 -->
        <div class="card p-8 animate-on-scroll stagger-2">
          <div class="w-14 h-14 rounded-2xl bg-yala-pink/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-yala-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">{t.problemCard2Title}</h3>
          <p class="text-neutral-400 leading-relaxed">{t.problemCard2Desc}</p>
        </div>

        <!-- Problem Card 3 -->
        <div class="card p-8 animate-on-scroll stagger-3">
          <div class="w-14 h-14 rounded-2xl bg-nature-priority/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-nature-priority" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">{t.problemCard3Title}</h3>
          <p class="text-neutral-400 leading-relaxed">{t.problemCard3Desc}</p>
        </div>
      </div>

      <p class="text-center text-neutral-500 mt-12 text-lg animate-on-scroll">{t.problemConclusion}</p>
    </div>
  </section>

  <!-- DIFFERENCE SECTION -->
  <section class="container-wide py-20 md:py-28">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-16 animate-on-scroll">{t.differenceTitle}</h2>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Other Apps -->
      <div class="card p-8 border-neutral-700/50 animate-on-scroll stagger-1">
        <h3 class="text-lg font-semibold text-neutral-500 mb-6">{t.differenceOthers}</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-neutral-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <span class="text-neutral-500">{t.differenceOther1}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-neutral-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <span class="text-neutral-500">{t.differenceOther2}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-neutral-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <span class="text-neutral-500">{t.differenceOther3}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-neutral-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <span class="text-neutral-500">{t.differenceOther4}</span>
          </li>
        </ul>
      </div>

      <!-- With Yala -->
      <div class="card-glow p-8 border-yala-indigo/30 animate-on-scroll stagger-2">
        <h3 class="text-lg font-semibold text-yala-cyan mb-6">{t.differenceYala}</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-yala-teal mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-neutral-200">{t.differenceYala1}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-yala-teal mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-neutral-200">{t.differenceYala2}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-yala-teal mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-neutral-200">{t.differenceYala3}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-yala-teal mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-neutral-200">{t.differenceYala4}</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FEATURES SECTION (Bento Grid) -->
  <section id="features" class="py-20 md:py-28" style="background: var(--bg-secondary);">
    <div class="container-wide">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">{t.featuresTitle}</h2>
        <p class="text-neutral-400 text-lg max-w-2xl mx-auto">{t.featuresSubtitle}</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-6xl mx-auto">
        <!-- Feature 1 - Large -->
        <div class="col-span-2 row-span-2 card-glow p-8 flex flex-col justify-between min-h-[320px] animate-on-scroll stagger-1">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-yala-indigo/20 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-yala-indigo" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-semibold mb-3">{t.feature1Title}</h3>
            <p class="text-neutral-400 leading-relaxed">{t.feature1Desc}</p>
          </div>
          <div class="mt-6 h-32 rounded-xl bg-gradient-to-br from-yala-indigo/10 to-transparent border border-yala-indigo/20 flex items-center justify-center">
            <span class="text-neutral-600 text-sm">Screenshot placeholder</span>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="col-span-2 card p-6 animate-on-scroll stagger-2">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-yala-cyan/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-yala-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold mb-2">{t.feature2Title}</h3>
              <p class="text-neutral-400 text-sm">{t.feature2Desc}</p>
            </div>
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="card p-6 animate-on-scroll stagger-3">
          <div class="w-12 h-12 rounded-xl bg-yala-teal/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-yala-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
            </svg>
          </div>
          <h3 class="font-semibold mb-1">{t.feature3Title}</h3>
          <p class="text-neutral-400 text-sm">{t.feature3Desc}</p>
        </div>

        <!-- Feature 4 -->
        <div class="card p-6 animate-on-scroll stagger-4">
          <div class="w-12 h-12 rounded-xl bg-nature-priority/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-nature-priority" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="font-semibold mb-1">{t.feature4Title}</h3>
          <p class="text-neutral-400 text-sm">{t.feature4Desc}</p>
        </div>

        <!-- Feature 5 -->
        <div class="card p-6 animate-on-scroll stagger-5">
          <div class="w-12 h-12 rounded-xl bg-yala-pink/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-yala-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
          </div>
          <h3 class="font-semibold mb-1">{t.feature5Title}</h3>
          <p class="text-neutral-400 text-sm">{t.feature5Desc}</p>
        </div>

        <!-- Feature 6 -->
        <div class="card p-6 animate-on-scroll stagger-5">
          <div class="w-12 h-12 rounded-xl bg-nature-essential/20 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-nature-essential" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold mb-1">{t.feature6Title}</h3>
          <p class="text-neutral-400 text-sm">{t.feature6Desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="container-wide py-20 md:py-28">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">{t.howTitle}</h2>
      <p class="text-neutral-400 text-lg">{t.howSubtitle}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <!-- Step 1 -->
      <div class="text-center animate-on-scroll stagger-1">
        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-yala-indigo to-yala-cyan flex items-center justify-center mx-auto mb-6 text-2xl font-bold text-white">1</div>
        <h3 class="text-xl font-semibold mb-3">{t.howStep1Title}</h3>
        <p class="text-neutral-400">{t.howStep1Desc}</p>
      </div>

      <!-- Step 2 -->
      <div class="text-center animate-on-scroll stagger-2">
        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-yala-cyan to-yala-teal flex items-center justify-center mx-auto mb-6 text-2xl font-bold text-white">2</div>
        <h3 class="text-xl font-semibold mb-3">{t.howStep2Title}</h3>
        <p class="text-neutral-400">{t.howStep2Desc}</p>
      </div>

      <!-- Step 3 -->
      <div class="text-center animate-on-scroll stagger-3">
        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-yala-teal to-yala-pink flex items-center justify-center mx-auto mb-6 text-2xl font-bold text-white">3</div>
        <h3 class="text-xl font-semibold mb-3">{t.howStep3Title}</h3>
        <p class="text-neutral-400">{t.howStep3Desc}</p>
      </div>
    </div>
  </section>

  <!-- ANALYTICS SECTION -->
  <section class="py-20 md:py-28" style="background: var(--bg-secondary);">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
        <div class="animate-on-scroll">
          <h2 class="text-3xl sm:text-4xl font-bold mb-2">{t.analyticsTitle}</h2>
          <p class="text-2xl sm:text-3xl font-bold text-gradient mb-8">{t.analyticsSubtitle}</p>

          <ul class="space-y-4">
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-yala-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-neutral-300">{t.analyticsBullet1}</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-yala-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-neutral-300">{t.analyticsBullet2}</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-yala-teal flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
