---
import type { Language } from '../i18n/translations';
import { getTranslation, languages } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslation(lang);

const langUrls = Object.keys(languages).map(l => ({
  code: l,
  name: languages[l as Language],
  url: l === 'es' ? '/' : `/${l}/`,
  active: l === lang,
}));

const homeUrl = lang === 'es' ? '/' : `/${lang}/`;
const privacyUrl = lang === 'es' ? '/privacy' : `/${lang}/privacy`;
const termsUrl = lang === 'es' ? '/terms' : `/${lang}/terms`;
const supportUrl = lang === 'es' ? '/support' : `/${lang}/support`;
const APP_STORE = 'https://apps.apple.com/pe/app/yala-finanzas-sin-esfuerzo/id6758253109';

// Capturas 2.0 — idioma-aware con fallback a ES (raw en/ no tiene panel-hero)
const imgLang = lang === 'es' ? 'es' : 'en';
// Capturas v3 (simulador, 2026-09-04): 620×1348, una por idioma. Ver Web/Screenshots/v3-2026-09-04/.
const SS = '/images/screenshots/v3';
const mock = (name: string) => `${SS}/${name}-${imgLang}.jpg`;

const navLinks = [
  { href: '#anota', label: t.v3NavAnota },
  { href: '#yala-ia', label: t.navYalaAI },
  { href: '#grupos', label: t.navGroups },
  { href: '#privacy', label: t.navPrivacy },
  { href: '#pricing', label: t.navPricing },
];
---

<a href="#main" class="skip-link">{t.a11ySkip}</a>

<!-- Header -->
<header class="fixed top-0 left-0 right-0 z-50 header-blur" style="background: var(--header-bg); border-bottom: 1px solid var(--border-color);">
  <div class="v3-wrap">
    <nav class="flex items-center justify-between h-16">
      <a href={homeUrl} class="flex items-center">
        <img src="/images/logo.png" alt="Yala" class="h-9 logo-dark" width="1200" height="400" style="width:auto" />
        <img src="/images/logo-light.png" alt="Yala" class="h-9 logo-light" width="1200" height="400" style="width:auto" />
      </a>

      <div class="hidden md:flex items-center gap-7">
        {navLinks.map(({ href, label }) => (
          <a href={href} class="text-sm v3-navlink transition-colors">{label}</a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <button id="mobile-menu-toggle" class="md:hidden w-9 h-9 rounded-full flex items-center justify-center border border-neutral-700 hover:border-neutral-500 transition-colors" style="background: var(--bg-card);" aria-label={t.a11yMenu} aria-expanded="false" aria-controls="mobile-menu">
          <svg aria-hidden="true" class="w-4 h-4 text-neutral-400 hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg aria-hidden="true" class="w-4 h-4 text-neutral-400 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>

        <div class="relative">
          <button id="lang-toggle" class="flex items-center gap-1.5 text-sm text-neutral-400 hover:text-white px-3 py-2 rounded-full border border-neutral-700 hover:border-neutral-500 transition-colors" aria-haspopup="true" aria-expanded="false" aria-controls="lang-menu">
            <span class="sr-only">{t.a11yLanguage}: </span><span class="uppercase font-medium">{lang}</span>
            <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="lang-menu" class="hidden absolute right-0 mt-2 py-2 w-36 rounded-xl shadow-xl z-50" style="background: var(--bg-card); border: 1px solid var(--border-color);">
            {langUrls.map(({ code, name, url, active }) => (
              <a href={url} lang={code} hreflang={code} data-lang={code} aria-current={active ? 'true' : undefined} class={`lang-option block px-4 py-2 text-sm transition-colors ${active ? 'text-accent-teal font-medium' : 'text-neutral-400 hover:text-white hover:bg-neutral-800/50'}`}>
                {name}
              </a>
            ))}
          </div>
        </div>

        <button id="theme-toggle" class="w-9 h-9 rounded-full flex items-center justify-center border border-neutral-700 hover:border-neutral-500 transition-colors" style="background: var(--bg-card);" aria-label={t.a11yTheme} aria-pressed="false">
          <svg aria-hidden="true" class="w-4 h-4 text-neutral-400 icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <svg aria-hidden="true" class="w-4 h-4 text-neutral-400 icon-moon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>

        <a href={APP_STORE} target="_blank" rel="noopener" class="hidden sm:inline-flex btn-primary text-sm">
          {t.navDownload}<span class="sr-only"> ({t.a11yNewTab})</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile Navigation Menu -->
<div id="mobile-menu" class="fixed inset-x-0 top-16 z-40 hidden md:hidden" style="background: var(--header-bg); border-bottom: 1px solid var(--border-color); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);">
  <div class="v3-wrap py-4 flex flex-col gap-3">
    {navLinks.map(({ href, label }) => (
      <a href={href} class="text-sm v3-navlink transition-colors py-2 mobile-nav-link">{label}</a>
    ))}
    <a href={APP_STORE} target="_blank" rel="noopener" class="btn-primary text-sm text-center mt-2">{t.navDownload}<span class="sr-only"> ({t.a11yNewTab})</span></a>
  </div>
</div>

<main id="main" class="pt-16">

  <!-- HERO -->
  <section class="v3-wrap pt-14 pb-16 md:pt-16 md:pb-24">
    <p class="v3-kicker">{t.v3Kicker}</p>
    <h1 class="v3-disp v3-h1 mt-4">{t.v3H1a} <span class="v3-pink">{t.v3H1b}</span></h1>

    <div class="grid md:grid-cols-[1fr_360px] gap-10 md:gap-16 items-start mt-8 md:mt-10">
      <div class="flex flex-col gap-6 max-w-2xl">
        <p class="v3-lede text-xl md:text-2xl">{t.v3Sub}</p>

        <!-- Prueba en vivo: el visitante escribe un gasto y ve cómo lo entiende Yala -->
        <div class="flex flex-col gap-3">
          <label for="demo-input" class="sr-only">{t.v3DemoPlaceholder}</label>
          <input id="demo-input" class="v3-input" type="text" autocomplete="off" spellcheck="false"
            placeholder={t.v3DemoPlaceholder} value={t.v3DemoStart}
            data-currency={t.v3DemoCurrency} data-account={t.v3DemoAccount} data-today={t.v3DemoToday} data-fallback={t.v3DemoFallback} data-lang={lang} />
          <div class="flex flex-wrap gap-2">
            <button type="button" class="v3-chip demo-example">{t.v3DemoEx1}</button>
            <button type="button" class="v3-chip demo-example">{t.v3DemoEx2}</button>
            <button type="button" class="v3-chip demo-example">{t.v3DemoEx3}</button>
          </div>
          <div id="demo-card" class="v3-card flex items-center justify-between gap-4" role="status" aria-live="polite">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-10 h-10 rounded-xl flex-shrink-0 flex items-center justify-center v3-card-icon">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
              </div>
              <div class="min-w-0">
                <div id="demo-note" class="font-semibold truncate"></div>
                <div id="demo-meta" class="text-sm v3-card-meta mt-0.5"></div>
              </div>
            </div>
            <div id="demo-amount" class="v3-disp text-2xl flex-shrink-0"></div>
          </div>
          <p class="text-sm v3-muted">{t.v3DemoNote}</p>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4 mt-1" id="hero-cta">
          <a href={APP_STORE} target="_blank" rel="noopener" class="btn-primary inline-flex items-center justify-center gap-2 text-base">
            <svg aria-hidden="true" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            {t.heroAppStore}<span class="sr-only"> ({t.a11yNewTab})</span>
          </a>
          <p class="text-sm v3-muted leading-relaxed">{t.v3CtaNote}<br />{t.v3Platform}</p>
        </div>
      </div>

      <div class="flex justify-center md:justify-end">
        <div class="v3-phone w-64 sm:w-72">
          <img src={mock('panel-hero')} alt={t.altHero} width="620" height="1348" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- ANOTA -->
  <section id="anota" class="v3-wrap pb-16 md:pb-24 scroll-mt-20">
    <div class="v3-panel v3-panel-teal grid md:grid-cols-[1fr_300px] gap-10 md:gap-14 items-center">
      <div>
        <p class="v3-kicker v3-kicker-onteal">{t.v3AnotaKicker}</p>
        <h2 class="v3-disp v3-h2 mt-3">{t.v3AnotaTitle}</h2>
        <div class="grid sm:grid-cols-3 gap-4 sm:gap-6 mt-7 md:mt-9">
          <div class="v3-item-onteal">
            <h3 class="font-bold text-lg">{t.v3Anota1T}</h3>
            <p class="mt-1.5 leading-relaxed v3-onteal-2">{t.v3Anota1D}</p>
          </div>
          <div class="v3-item-onteal">
            <h3 class="font-bold text-lg">{t.v3Anota2T} <span class="v3-pro-inline">PRO</span></h3>
            <p class="mt-1.5 leading-relaxed v3-onteal-2">{t.v3Anota2D}</p>
          </div>
          <div class="v3-item-onteal">
            <h3 class="font-bold text-lg">{t.v3Anota3T} <span class="v3-pro-inline">PRO</span></h3>
            <p class="mt-1.5 leading-relaxed v3-onteal-2">{t.v3Anota3D}</p>
          </div>
        </div>
        <p class="mt-8 text-sm v3-onteal-2">{t.v3AnotaImport}</p>
      </div>
      <div class="flex justify-center md:justify-end">
        <div class="v3-phone w-44 sm:w-56 md:w-64 md:-my-24">
          <img src={mock('nuevo-registro')} alt={t.altStep1} width="620" height="1348" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- ENTIENDE — sección abierta: alterna con el bloque teal de arriba -->
  <section id="entiende" class="v3-wrap pb-16 md:pb-24 scroll-mt-20">
    <div class="grid md:grid-cols-[1fr_300px] gap-10 md:gap-16 items-center">
      <div>
        <p class="v3-kicker">{t.v3EntiendeKicker}</p>
        <h2 class="v3-disp v3-h2 mt-3">{t.v3EntiendeTitle}</h2>
        <p class="v3-lede mt-5">{t.v3EntiendeLede}</p>
        <dl class="grid grid-cols-3 gap-4 sm:gap-6 mt-9">
          <div><dd class="v3-disp text-3xl sm:text-4xl md:text-5xl">{t.v3Stat1}</dd><dt class="text-sm v3-muted mt-1">{t.v3Stat1L}</dt></div>
          <div><dd class="v3-disp text-3xl sm:text-4xl md:text-5xl">{t.v3Stat2}</dd><dt class="text-sm v3-muted mt-1">{t.v3Stat2L}</dt></div>
          <div><dd class="v3-disp text-3xl sm:text-4xl md:text-5xl">{t.v3Stat3}</dd><dt class="text-sm v3-muted mt-1">{t.v3Stat3L}</dt></div>
        </dl>
        <p class="mt-6 text-xs v3-muted">{t.v3StatsCaption}</p>
      </div>
      <div class="flex justify-center md:justify-end">
        <div class="v3-phone w-52 sm:w-64 md:w-[280px]">
          <img src={mock('stats-resumen')} alt={t.altAnalytics} width="620" height="1348" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- YALA IA -->
  <section id="yala-ia" class="v3-wrap pb-16 md:pb-24 scroll-mt-20">
    <div class="v3-panel v3-panel-indigo grid md:grid-cols-2 gap-10 md:gap-14 items-start">
      <div>
        <p class="v3-kicker v3-kicker-onindigo">{t.v3IAKicker} <span class="v3-tag v3-tag-onindigo ml-2">PRO</span></p>
        <h2 class="v3-disp v3-h2 mt-3">{t.v3IATitle}</h2>
        <p class="v3-lede v3-onindigo-2 mt-5">{t.v3IALede}</p>
        <p class="mt-7 text-sm v3-onindigo-2 leading-relaxed max-w-md">{t.v3IANote} <a href={privacyUrl} class="v3-link-onindigo">{t.v3IALink}</a>.</p>
      </div>
      <div class="flex flex-col gap-3 md:pt-2">
        <p class="v3-bubble-u">{t.v3ChatU1}</p>
        <p class="v3-bubble-a">{t.v3ChatA1}</p>
        <p class="v3-bubble-u">{t.v3ChatU2}</p>
        <p class="v3-bubble-a">{t.v3ChatA2}</p>
      </div>
    </div>
  </section>

  <!-- GRUPOS -->
  <section id="grupos" class="v3-wrap pb-16 md:pb-24 scroll-mt-20">
    <div class="grid md:grid-cols-[300px_1fr] gap-10 md:gap-16 items-center">
      <div class="flex justify-center md:justify-start order-2 md:order-1">
        <div class="v3-phone w-60 sm:w-64 md:w-[280px]">
          <img src={mock('grupos')} alt={t.altGroups} width="620" height="1348" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="order-1 md:order-2">
        <p class="v3-kicker">{t.v3GruposKicker} <span class="v3-tag ml-2">BETA</span></p>
        <h2 class="v3-disp v3-h2 mt-3">{t.v3GruposTitle}</h2>
        <p class="v3-lede mt-5">{t.v3GruposLede}</p>
        <ul class="mt-8 max-w-xl v3-rows">
          <li class="v3-row"><span>{t.v3Grupo1}</span><span class="font-semibold v3-strong">{t.v3Grupo1A}</span></li>
          <li class="v3-row"><span>{t.v3Grupo2}</span><span class="font-semibold v3-strong">{t.v3Grupo2A}</span></li>
          <li class="v3-row v3-row-teal"><span>{t.v3Grupo3}</span><span class="font-semibold">{t.v3Grupo3A}</span></li>
        </ul>
        <p class="mt-3.5 text-sm v3-muted">{t.v3GruposNote}</p>
      </div>
    </div>
  </section>

  <!-- PRIVACIDAD -->
  <section id="privacy" class="v3-wrap pb-16 md:pb-24 scroll-mt-20">
    <div class="grid md:grid-cols-2 gap-8 md:gap-16">
      <div>
        <p class="v3-kicker">{t.v3PrivKicker}</p>
        <h2 class="v3-disp v3-h2 mt-3">{t.v3PrivTitle}</h2>
      </div>
      <div class="flex flex-col gap-5 text-lg leading-relaxed md:pt-10">
        <p>{t.v3Priv1}</p>
        <p>{t.v3Priv2}</p>
        <p>{t.v3Priv3} <a href={privacyUrl} class="v3-link">{t.footerPrivacy}</a>.</p>
      </div>
    </div>
  </section>

  <!-- POR QUÉ YALA -->
  <section class="v3-wrap pb-16 md:pb-24">
    <div class="v3-panel v3-panel-surface max-w-3xl">
      <p class="v3-kicker">{t.v3WhyKicker}</p>
      <blockquote class="v3-disp v3-quote mt-5">{t.v3WhyText}</blockquote>
      <div class="flex items-center gap-3.5 mt-7">
        <div class="w-11 h-11 rounded-full flex items-center justify-center font-bold v3-avatar" aria-hidden="true">J</div>
        <div>
          <div class="font-semibold">{t.v3WhyName}</div>
          <div class="text-sm v3-muted">{t.v3WhyRole}</div>
        </div>
      </div>
      <p class="mt-6 text-sm v3-muted">{t.v3Since}</p>
    </div>
  </section>

  <!-- PLANES -->
  <section id="pricing" class="v3-wrap pb-16 md:pb-24 scroll-mt-20">
    <p class="v3-kicker">{t.v3PlansKicker}</p>
    <h2 class="v3-disp v3-h2 mt-3">{t.v3PlansTitle}</h2>
    <div class="grid md:grid-cols-2 gap-5 mt-9">
      <div class="v3-panel v3-panel-surface p-8 md:p-9">
        <div class="flex justify-between items-baseline gap-4">
          <h3 class="text-xl font-semibold">{t.pricingFreeTitle}</h3>
          <span class="v3-disp text-3xl">{t.pricingFreePrice}</span>
        </div>
        <p class="mt-3.5 leading-relaxed v3-muted">{t.v3FreeDesc}</p>
      </div>
      <div class="v3-panel v3-panel-indigo p-8 md:p-9">
        <div class="flex justify-between items-baseline gap-4 flex-wrap">
          <h3 class="text-xl font-semibold">{t.pricingProTitle}</h3>
          <span class="v3-disp text-3xl">{t.pricingProPrice}<span class="text-base font-medium tracking-normal v3-onindigo-2" style="font-family: Inter, sans-serif;"> {t.pricingProPeriod}</span></span>
        </div>
        <p class="text-sm v3-onindigo-2 mt-1">{t.pricingProAnnual}</p>
        <p class="mt-3.5 leading-relaxed v3-onindigo-2">{t.v3ProDesc}</p>
        <p class="mt-5 text-sm v3-onindigo-2 leading-relaxed border-t border-white/20 pt-4">{t.v3Trial}</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="v3-wrap pb-16 md:pb-24">
    <p class="v3-kicker mb-5">{t.v3FaqKicker}</p>
    <dl class="v3-faq-list">
      <div class="v3-faq"><dt class="font-semibold">{t.v3Faq1Q}</dt><dd class="v3-muted leading-relaxed">{t.v3Faq1A}</dd></div>
      <div class="v3-faq"><dt class="font-semibold">{t.v3Faq2Q}</dt><dd class="v3-muted leading-relaxed">{t.v3Faq2A}</dd></div>
      <div class="v3-faq"><dt class="font-semibold">{t.v3Faq3Q}</dt><dd class="v3-muted leading-relaxed">{t.v3Faq3A}</dd></div>
      <div class="v3-faq"><dt class="font-semibold">{t.v3Faq4Q}</dt><dd class="v3-muted leading-relaxed">{t.v3Faq4A}</dd></div>
      <div class="v3-faq"><dt class="font-semibold">{t.v3Faq5Q}</dt><dd class="v3-muted leading-relaxed">{t.v3Faq5A}</dd></div>
      <div class="v3-faq"><dt class="font-semibold">{t.v3Faq6Q}</dt><dd class="v3-muted leading-relaxed">{t.v3Faq6A}</dd></div>
    </dl>
    <p class="mt-6 text-sm v3-muted"><a href={supportUrl} class="v3-link">{t.footerHelp}</a></p>
  </section>

  <!-- CTA -->
  <section class="v3-wrap pb-20 md:pb-28 text-center">
    <h2 class="v3-disp v3-h1">{t.v3H1a} <span class="v3-pink">{t.v3H1b}</span></h2>
    <div class="mt-8 flex flex-col items-center gap-4">
      <a href={APP_STORE} target="_blank" rel="noopener" class="btn-primary inline-flex items-center gap-2 text-lg px-8 py-4">
        <svg aria-hidden="true" class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        {t.ctaCta}<span class="sr-only"> ({t.a11yNewTab})</span>
      </a>
      <p class="text-sm v3-muted">{t.v3CtaNote}</p>
    </div>
  </section>
</main>

<!-- FOOTER -->
<footer class="py-10 border-t" style="border-color: var(--border-color);">
  <div class="v3-wrap flex flex-col md:flex-row items-center justify-between gap-5 text-sm v3-muted">
    <div class="flex items-center gap-5">
      <img src="/images/logo.png" alt="Yala" class="h-6 logo-dark" width="1200" height="400" style="width:auto" />
      <img src="/images/logo-light.png" alt="Yala" class="h-6 logo-light" width="1200" height="400" style="width:auto" />
      <span>© 2026 Yala</span>
    </div>
    <div class="flex flex-wrap justify-center items-center gap-5">
      <a href={privacyUrl} class="v3-navlink">{t.footerPrivacy}</a>
      <a href={termsUrl} class="v3-navlink">{t.footerTerms}</a>
      <a href={supportUrl} class="v3-navlink">{t.footerHelp}</a>
      <a href="mailto:admin@yala-app.pe" class="v3-navlink">{t.footerContact}</a>
    </div>
  </div>
</footer>

<!-- CTA fijo en móvil: aparece cuando el botón del hero sale de la pantalla -->
<div id="sticky-cta" class="v3-sticky md:hidden" hidden>
  <a href={APP_STORE} target="_blank" rel="noopener" class="btn-primary block w-full text-center">{t.v3StickyCta}<span class="sr-only"> ({t.a11yNewTab})</span></a>
</div>

<!-- Scripts -->
<script>
  // Theme Toggle — el estado inicial (body.light) lo pone un script inline en Layout.astro
  // antes del primer pintado; aquí solo se sincronizan icono y botón.
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.querySelector('.icon-sun');
  const moonIcon = document.querySelector('.icon-moon');

  function reflectTheme(isLight: boolean) {
    sunIcon?.classList.toggle('hidden', isLight);
    moonIcon?.classList.toggle('hidden', !isLight);
    themeToggle?.setAttribute('aria-pressed', String(isLight));
  }

  function setTheme(isLight: boolean) {
    document.body.classList.toggle('light', isLight);
    reflectTheme(isLight);
    try { localStorage.setItem('theme', isLight ? 'light' : 'dark'); } catch { /* almacenamiento bloqueado: el tema vive solo en esta visita */ }
  }

  reflectTheme(document.body.classList.contains('light'));
  themeToggle?.addEventListener('click', () => setTheme(!document.body.classList.contains('light')));

  // Language Menu
  const langToggle = document.getElementById('lang-toggle');
  const langMenu = document.getElementById('lang-menu');

  function setLangMenu(open: boolean) {
    langMenu?.classList.toggle('hidden', !open);
    langToggle?.setAttribute('aria-expanded', String(open));
  }

  langToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setLangMenu(langMenu?.classList.contains('hidden') ?? false);
  });

  // Elegir idioma a mano fija la cookie `lang`: la redirección por Accept-Language de vercel.json
  // solo actúa cuando esa cookie falta, así la elección explícita gana al idioma del navegador.
  document.querySelectorAll<HTMLAnchorElement>('.lang-option').forEach(link => {
    link.addEventListener('click', () => {
      const code = link.dataset.lang;
      if (code) document.cookie = `lang=${code}; path=/; max-age=31536000; SameSite=Lax`;
    });
  });

  // Mobile Menu
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.querySelector('.hamburger-icon');
  const closeIcon = document.querySelector('.close-icon');

  function setMobileMenu(open: boolean) {
    mobileMenu?.classList.toggle('hidden', !open);
    hamburgerIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    mobileToggle?.setAttribute('aria-expanded', String(open));
  }

  mobileToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMobileMenu(mobileMenu?.classList.contains('hidden') ?? false);
  });
  document.querySelectorAll('.mobile-nav-link').forEach(link => link.addEventListener('click', () => setMobileMenu(false)));
  document.addEventListener('click', (e) => {
    setLangMenu(false);
    if (!mobileMenu?.contains(e.target as Node) && !mobileToggle?.contains(e.target as Node)) setMobileMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (langMenu && !langMenu.classList.contains('hidden')) { setLangMenu(false); langToggle?.focus(); }
    if (mobileMenu && !mobileMenu.classList.contains('hidden')) { setMobileMenu(false); mobileToggle?.focus(); }
  });

  // Prueba en vivo del hero: un parser mínimo, sin red, que imita cómo Yala entiende una frase.
  // Es una demostración: la app real usa su propio motor (y con Pro, IA). Nada de esto sale del navegador.
  const demoInput = document.getElementById('demo-input') as HTMLInputElement | null;
  const demoCard = document.getElementById('demo-card');
  const demoNote = document.getElementById('demo-note');
  const demoMeta = document.getElementById('demo-meta');
  const demoAmount = document.getElementById('demo-amount');

  const CATEGORY_LABELS: Record<string, Record<string, string>> = {
    es: { food: 'Restaurantes', transport: 'Transporte', grocery: 'Supermercado', utilities: 'Servicios', subs: 'Suscripciones', health: 'Salud', shopping: 'Compras', home: 'Hogar', other: 'Otros' },
    en: { food: 'Restaurants', transport: 'Transport', grocery: 'Groceries', utilities: 'Utilities', subs: 'Subscriptions', health: 'Health', shopping: 'Shopping', home: 'Home', other: 'Other' },
    de: { food: 'Restaurants', transport: 'Verkehr', grocery: 'Supermarkt', utilities: 'Nebenkosten', subs: 'Abos', health: 'Gesundheit', shopping: 'Einkäufe', home: 'Wohnen', other: 'Sonstiges' },
    fr: { food: 'Restaurants', transport: 'Transport', grocery: 'Courses', utilities: 'Factures', subs: 'Abonnements', health: 'Santé', shopping: 'Achats', home: 'Logement', other: 'Autres' },
    it: { food: 'Ristoranti', transport: 'Trasporti', grocery: 'Spesa', utilities: 'Bollette', subs: 'Abbonamenti', health: 'Salute', shopping: 'Acquisti', home: 'Casa', other: 'Altro' },
    pt: { food: 'Restaurantes', transport: 'Transporte', grocery: 'Supermercado', utilities: 'Contas', subs: 'Assinaturas', health: 'Saúde', shopping: 'Compras', home: 'Casa', other: 'Outros' },
  };
  const CATEGORY_RULES: Array<[RegExp, string]> = [
    [/pizza|restaur|almuerzo|cena|desayuno|comida|pollo|chifa|caf[eé]|men[uú]|lunch|dinner|burger|sushi|essen|d[ée]jeuner|d[îi]ner|pranzo|jantar|almo[cç]o/i, 'food'],
    [/taxi|uber|cabify|bus|combi|gasolina|pasaje|aeropuerto|airport|flughafen|a[eé]roport|aeroporto|train|tren|zug|metro|didi/i, 'transport'],
    [/s[uú]per|mercado|plaza vea|wong|tottus|bodega|verdura|fruta|grocer|supermar|courses|spesa|mercadona|lidl|aldi|rewe/i, 'grocery'],
    [/luz|agua|internet|recibo|celular|claro|movistar|electric|strom|facture|bolletta|conta de|gas\b|wifi/i, 'utilities'],
    [/netflix|spotify|suscrip|subscri|abo\b|abbonam|assinat|disney|youtube|icloud/i, 'subs'],
    [/farmacia|m[eé]dic|doctor|cl[ií]nica|dentist|pharma|apotheke|arzt|sant[eé]|salute/i, 'health'],
    [/ropa|zapat|tienda|regalo|amazon|shop|kleidung|v[êe]tement|scarpe|roupa|presente/i, 'shopping'],
    [/alquiler|arriendo|rent\b|miete|loyer|affitto|aluguel|hogar|casa\b/i, 'home'],
  ];

  function parseExpense(text: string) {
    const m = text.match(/(\d+(?:[.,]\d{1,2})?)/);
    if (!m) return null;
    const amount = parseFloat(m[1].replace(',', '.'));
    const lang = demoInput?.dataset.lang ?? 'es';
    const labels = CATEGORY_LABELS[lang] ?? CATEGORY_LABELS.es;
    let currency = demoInput?.dataset.currency ?? 'S/';
    if (/d[oó]lar|dollar|\$|usd/i.test(text)) currency = '$';
    else if (/euro|€/i.test(text)) currency = '€';
    else if (/soles?\b|\bS\//i.test(text)) currency = 'S/';
    const category = labels[(CATEGORY_RULES.find(([re]) => re.test(text)) ?? [null, 'other'])[1]];
    let note = text
      .replace(/^\s*(gast[eé]|pagu[eé]|compr[eé]|spent|paid|ausgegeben|d[ée]pens[ée]|speso|pagato|gastei|paguei)\s+/i, '')
      .replace(m[0], '')
      .replace(/\s*(soles?|d[oó]lares?|dollars?|euros?|usd|\$|€|eur)\s*/i, ' ')
      .replace(/\s+(ausgegeben|dépensé)\s*$/i, '')
      .replace(/^\s*(en|de|por|un|una|el|la|al|on|for|at|f[üu]r|pour|di|per|na|no|em)\s+/i, '')
      .replace(/\s+/g, ' ').trim();
    note = note ? note.charAt(0).toUpperCase() + note.slice(1) : (demoInput?.dataset.fallback ?? '');
    const formatted = amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    return { amount: `${currency} ${formatted}`, category, note };
  }

  function renderDemo() {
    if (!demoInput || !demoCard || !demoNote || !demoMeta || !demoAmount) return;
    const r = parseExpense(demoInput.value);
    demoCard.hidden = !r;
    if (!r) return;
    demoNote.textContent = r.note;
    demoMeta.textContent = `${r.category} · ${demoInput.dataset.account} · ${demoInput.dataset.today}`;
    demoAmount.textContent = r.amount;
  }

  demoInput?.addEventListener('input', renderDemo);
  document.querySelectorAll<HTMLButtonElement>('.demo-example').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!demoInput) return;
      demoInput.value = btn.textContent?.trim() ?? '';
      renderDemo();
      demoInput.focus();
    });
  });
  renderDemo();

  // CTA fijo en móvil: solo cuando el botón del hero ya no se ve
  const heroCta = document.getElementById('hero-cta');
  const stickyCta = document.getElementById('sticky-cta');
  if (heroCta && stickyCta && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      const heroVisible = entries.some(e => e.isIntersecting);
      stickyCta.hidden = heroVisible || window.scrollY < 200;
    }, { threshold: 0 });
    io.observe(heroCta);
  }
</script>
