---
import '../styles/global.css';
import type { Language } from '../i18n/translations';
import { languages } from '../i18n/translations';

interface Props {
	title: string;
	description?: string;
	lang?: Language;
	/** Páginas que no existen en los seis idiomas (funciones, preguntas frecuentes): sus gemelas
	 *  explícitas. Si se pasa, sustituye al cálculo por ruta base. */
	alternates?: { l: string; href: string }[];
	/** Nodos schema.org extra para el @graph de la página (FAQPage, BreadcrumbList…). */
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description = "Tu centro de control financiero con Yala IA y gastos compartidos. Registra en segundos, entiende en minutos.",
	lang = 'es',
	alternates: alternatesOverride,
	jsonLd = []
} = Astro.props;

const site = 'https://yala-app.pe';
const APP_STORE_ID = '6758253109';
const appStoreUrl = `https://apps.apple.com/pe/app/yala-finanzas-sin-esfuerzo/id${APP_STORE_ID}`;

// hreflang: cada página tiene una gemela por idioma con la misma ruta base
// (`/`, `/privacy`, `/terms`, `/support`). ES vive en la raíz; el resto bajo `/xx/`.
const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const langCodes = Object.keys(languages) as Language[];
const basePath = rawPath.replace(new RegExp(`^/(${langCodes.join('|')})(?=/|$)`), '') || '/';
const knownBases = ['/', '/privacy', '/terms', '/support'];
// Con barra final, igual que las URLs del sitemap (Astro las emite así): canonical y sitemap deben coincidir.
const localizedUrl = (l: Language) =>
	site + (l === 'es' ? basePath : `/${l}${basePath === '/' ? '' : basePath}`) + (basePath === '/' && l === 'es' ? '' : '/');
const alternates = alternatesOverride
	?? (knownBases.includes(basePath) ? langCodes.map((l) => ({ l, href: localizedUrl(l) })) : []);
const canonical = alternatesOverride
	? (alternatesOverride.find((a) => a.l === lang)?.href ?? site + rawPath + '/')
	: knownBases.includes(basePath) ? localizedUrl(lang) : site + rawPath;
const xDefault = alternatesOverride
	? (alternatesOverride.find((a) => a.l === 'es')?.href ?? canonical)
	: localizedUrl('es');
// Descripción y funciones de la app para los datos estructurados: fijas por idioma, no la de la página
// (una página de privacidad o de una función no describe la app). de/fr/it/pt conservan la de su página,
// como hasta ahora, y la lista de funciones en inglés.
const appTexts = {
	es: {
		description: 'Yala es una app de finanzas personales para iPhone: anota gastos en segundos, arma presupuestos con alertas, divide gastos en grupo y pregúntale a Yala IA cómo vas.',
		features: [
			'Anotar gastos e ingresos en segundos, a mano o con atajos de Siri',
			'Leer capturas de comprobantes y estados de cuenta (Yala Pro)',
			'Dictado por voz y foto del recibo (Yala Pro)',
			'Yala IA, asistente que responde con tus datos y anota por ti (Yala Pro)',
			'Presupuestos con alertas y pagos planificados',
			'Grupos para dividir gastos y simplificar deudas',
			'Más de 50 divisas',
			'Importar y exportar en CSV o Excel',
			'Widgets de pantalla de inicio',
			'Sin conexión a bancos ni claves bancarias',
		],
	},
	en: {
		description: 'Yala is a personal finance app for iPhone: log expenses in seconds, set budgets with alerts, split expenses with a group and ask Yala AI how you are doing.',
		features: [
			'Log expenses and income in seconds, by hand or with Siri shortcuts',
			'Read screenshots of payment receipts and bank statements (Yala Pro)',
			'Voice dictation and receipt photos (Yala Pro)',
			'Yala AI, an assistant that answers with your data and logs for you (Yala Pro)',
			'Budgets with alerts and planned payments',
			'Groups to split expenses and simplify debts',
			'More than 50 currencies',
			'CSV and Excel import and export',
			'Home Screen widgets',
			'No bank connection or bank credentials',
		],
	},
};
const appText = lang === 'es' ? appTexts.es : lang === 'en' ? appTexts.en : { ...appTexts.en, description };
const ogLocale = ({ es: 'es_PE', en: 'en_US', de: 'de_DE', fr: 'fr_FR', it: 'it_IT', pt: 'pt_BR' } as const)[lang];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0F172A" />
		<link rel="canonical" href={canonical} />
		{alternates.map(({ l, href }) => <link rel="alternate" hreflang={l} href={href} />)}
		{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={xDefault} />}

		<!-- Smart App Banner (Safari iOS): abre o descarga la app sin salir de la web -->
		<meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

		<!-- Open Graph / Twitter: las URLs de imagen deben ser absolutas para que WhatsApp, iMessage y X las rendericen -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Yala" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${site}/og-image.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site}/og-image.png`} />

		<!-- Favicon -->
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />

		<!-- Marca `js` cuanto antes: el scroll-reveal solo oculta contenido si hay JS que luego lo muestre -->
		<script is:inline>document.documentElement.classList.add('js');</script>

		<!-- Fuentes propias, servidas desde este dominio (`public/fonts/`). La hoja entra como `print` y se
		     activa al cargar: así las caras se piden DESPUÉS del primer pintado y no le quitan ancho de
		     banda a la imagen del hero — medido el 2026-09-04, meterlas en el CSS principal subía el LCP
		     de 2,9 s a 5,2 s. Con `font-display: swap` el texto se lee desde el primer momento. -->
		<link rel="preload" href="/fonts/bricolage-800-latin.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="stylesheet" href="/fonts/fonts.css" media="print" onload="this.media='all'">
		<noscript><link rel="stylesheet" href="/fonts/fonts.css"></noscript>

		<slot name="head" />

		<!-- Datos estructurados: qué es Yala, quién la hace y cuánto cuesta, en el formato que leen
		     Google y los lectores de IA. Sin `aggregateRating`: la nota es real pero se apoya en muy
		     pocas valoraciones (decisión del owner, 2026-09-04); se añade cuando haya volumen. -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'Organization',
					'@id': `${site}/#organization`,
					name: 'Yala',
					url: site,
					logo: `${site}/icon-192.png`,
					email: 'admin@yala-app.pe',
					foundingLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Lima', addressCountry: 'PE' } },
				},
				{
					'@type': 'WebSite',
					'@id': `${site}/#website`,
					url: site,
					name: 'Yala',
					inLanguage: langCodes,
					publisher: { '@id': `${site}/#organization` },
				},
				{
					'@type': 'MobileApplication',
					'@id': `${site}/#app`,
					name: 'Yala',
					applicationCategory: 'FinanceApplication',
					operatingSystem: 'iOS 26.0 or later',
					url: appStoreUrl,
					installUrl: appStoreUrl,
					publisher: { '@id': `${site}/#organization` },
					inLanguage: langCodes,
					datePublished: '2026-03-03',
					description: appText.description,
					// Lo que hace, en frases cortas: es lo que citan los buscadores y las IA. Detalle por función en /funciones/.
					featureList: appText.features,
					offers: [
						{ '@type': 'Offer', name: 'Yala Gratis', price: '0', priceCurrency: 'PEN', category: 'free' },
						{ '@type': 'Offer', name: 'Yala Pro', price: '12.90', priceCurrency: 'PEN', category: 'subscription' },
					],
				},
				...jsonLd,
			],
		})} />

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<!-- Tema antes del primer pintado: oscuro por defecto (decisión del owner), claro solo si el
		     visitante lo eligió aquí. Va antes del contenido para que no haya flash. -->
		<script is:inline>
			try {
				if (localStorage.getItem('theme') === 'light') document.body.classList.add('light');
			} catch (e) {}
		</script>
		<slot />
	</body>
</html>
