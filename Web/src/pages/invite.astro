const iconSVG = sfSymbolSVGs[iconParam] || sfSymbolSVGs['person.2.fill'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />

    <!-- Open Graph (WhatsApp, iMessage, Telegram previews) -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://yala-app.pe/icon-192.png" />
    <meta property="og:url" content={url.href} />
    <meta property="og:site_name" content="Yala" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : lang} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://yala-app.pe/icon-192.png" />

    <!-- Smart App Banner -->
    <meta name="apple-itunes-app" content="app-id=6758253109" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <title>{pageTitle} — Yala</title>
  </head>

  <body class="bg-yala-slate text-neutral-100 font-sans min-h-screen flex flex-col items-center justify-center px-4 py-8">
  <main class="w-full flex flex-col items-center">

    <!-- Logo -->
    <div class="mb-8">
      <img src="/images/logo.png" alt="Yala" class="h-12" width="1200" height="400" style="width:auto" />
    </div>

    <!-- Invite Card -->
    <div class="w-full max-w-sm rounded-2xl border p-6 text-center"
         style={`background: rgba(28, 41, 71, 0.6); border-color: rgba(51, 65, 85, 0.6);`}>

      <!-- Group Icon -->
      <div class="mx-auto mb-4 w-16 h-16 rounded-full flex items-center justify-center"
           style={`background: ${groupColor}20; border: 2px solid ${groupColor};`}>
        <svg class="w-7 h-7" aria-hidden="true" fill={groupColor} viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <Fragment set:html={iconSVG} />
        </svg>
      </div>

      <!-- Group Name -->
      <h1 class="text-xl font-bold text-white mb-1">{groupName}</h1>

      <!-- Members -->
      {members.length > 0 && (
        <div class="mb-5">
          <p class="text-sm text-neutral-400 mb-2">{t.inviteMembers}</p>
          <div class="flex flex-wrap justify-center gap-2">
            {members.map((name: string) => (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium border text-neutral-100"
                    style={`background: ${groupColor}22; border-color: ${groupColor}66;`}>
                {name}
              </span>
            ))}
          </div>
        </div>
      )}

      {members.length === 0 && (
        <p class="text-sm text-neutral-400 mb-5">{t.inviteInvitedFallback}</p>
      )}

      <!-- CTA Buttons -->
      <div class="space-y-3">
        {appDeepLink && (
          <a href={appDeepLink}
             class="block w-full px-6 py-3 rounded-xl font-semibold bg-yala-indigo text-white text-center transition-all duration-300 hover:shadow-yala hover:scale-[1.02] active:scale-[0.98]">
            {t.inviteOpenInYala}
          </a>
        )}

        <a href={appStoreURL} target="_blank" rel="noopener"
           class="block w-full text-center btn-secondary">
          {t.inviteDownloadAppStore}
        </a>
      </div>
    </div>

    <!-- Footer -->
    <p class="mt-8 text-xs text-neutral-500">
      {t.inviteFooter}
    </p>

  </main>
  </body>
</html>
