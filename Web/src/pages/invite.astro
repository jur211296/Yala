---
export const prerender = false;

import '../styles/global.css';

// Parse query params server-side for OG tags
const url = Astro.url;
const groupName = url.searchParams.get('n') || 'Grupo';
const colorHex = url.searchParams.get('c') || '8B5CF6';
const membersParam = url.searchParams.get('m') || '';
const shareParam = url.searchParams.get('s') || '';
const members = membersParam ? membersParam.split(',').map((m: string) => decodeURIComponent(m.trim())).filter(Boolean) : [];

const pageTitle = `Unirse a "${groupName}"`;
const pageDescription = members.length > 0
  ? `${members.slice(0, 3).join(', ')}${members.length > 3 ? '...' : ''} ya están en ${groupName}. Descarga Yala para unirte.`
  : `Te invitaron al grupo ${groupName} en Yala.`;

const appStoreURL = 'https://apps.apple.com/pe/app/yala-finanzas-sin-esfuerzo/id6758253109';
const groupColor = `#${colorHex}`;

// Build app deep link for "Open in Yala" button
const appDeepLink = shareParam ? `yala://invite?s=${shareParam}` : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />

    <!-- Open Graph (WhatsApp, iMessage, Telegram previews) -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://yala-app.pe/og-image.png" />
    <meta property="og:url" content={url.href} />
    <meta property="og:site_name" content="Yala" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://yala-app.pe/og-image.png" />

    <!-- Smart App Banner -->
    <meta name="apple-itunes-app" content="app-id=6758253109" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <title>{pageTitle} — Yala</title>
  </head>

  <body class="bg-yala-slate text-neutral-100 font-sans min-h-screen flex flex-col items-center justify-center px-4 py-8">

    <!-- Logo -->
    <div class="mb-8">
      <img src="/logo.svg" alt="Yala" class="h-8" />
    </div>

    <!-- Invite Card -->
    <div class="w-full max-w-sm rounded-2xl border p-6 text-center"
         style={`background: rgba(28, 41, 71, 0.6); border-color: rgba(51, 65, 85, 0.6);`}>

      <!-- Group Icon -->
      <div class="mx-auto mb-4 w-16 h-16 rounded-full flex items-center justify-center"
           style={`background: ${groupColor}20; border: 2px solid ${groupColor};`}>
        <svg class="w-7 h-7" fill={groupColor} viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M16.5 13c1.2 0 2.3.3 3.3.8A5.5 5.5 0 0 1 22 18.5V20h-4v-1.5c0-1.4-.5-2.7-1.4-3.7.6-.2 1.2-.3 1.9-.3h-2ZM8 13c2.7 0 8 1.3 8 4v3H0v-3c0-2.7 5.3-4 8-4Zm0-2a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm8 0a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z"/>
        </svg>
      </div>

      <!-- Group Name -->
      <h1 class="text-xl font-bold text-white mb-1">{groupName}</h1>

      <!-- Members -->
      {members.length > 0 && (
        <div class="mb-5">
          <p class="text-sm text-neutral-400 mb-2">Miembros</p>
          <div class="flex flex-wrap justify-center gap-2">
            {members.map((name: string) => (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium border"
                    style={`background: ${groupColor}10; border-color: ${groupColor}40; color: ${groupColor};`}>
                {name}
              </span>
            ))}
          </div>
        </div>
      )}

      {members.length === 0 && (
        <p class="text-sm text-neutral-400 mb-5">Te invitaron a este grupo en Yala</p>
      )}

      <!-- CTA Buttons -->
      <div class="space-y-3">
        {appDeepLink && (
          <a href={appDeepLink}
             class="block w-full px-6 py-3 rounded-xl font-semibold bg-yala-indigo text-white text-center transition-all duration-300 hover:shadow-yala hover:scale-[1.02] active:scale-[0.98]">
            Abrir en Yala
          </a>
        )}

        <a href={appStoreURL} target="_blank" rel="noopener"
           class="block w-full px-6 py-3 rounded-xl font-semibold border-2 border-yala-indigo text-yala-indigo text-center transition-all duration-300 hover:bg-yala-indigo hover:text-white">
          Descargar en App Store
        </a>
      </div>
    </div>

    <!-- Footer -->
    <p class="mt-8 text-xs text-neutral-500">
      Yala — Finanzas personales, sin esfuerzo
    </p>

  </body>
</html>
