---
export const prerender = false;

import '../styles/global.css';
import { detectLanguage, getTranslations } from '../i18n/translations';

// i18n: detect locale via Accept-Language (SSR), fallback handled by detectLanguage
const lang = detectLanguage(Astro.request.headers.get('accept-language'));
const t = getTranslations(lang);
Astro.response.headers.set('Vary', 'Accept-Language');

// Parse query params server-side for OG tags
const url = Astro.url;
const groupName = url.searchParams.get('n') || t.inviteFallbackGroupName;
// `c` va directo a un atributo style: solo se acepta un hex de 6 dígitos (evita inyección CSS por query).
const rawColor = url.searchParams.get('c') || '';
const colorHex = /^[0-9A-Fa-f]{6}$/.test(rawColor) ? rawColor : '8B5CF6';
const membersParam = url.searchParams.get('m') || '';
const shareParam = url.searchParams.get('s') || '';
const inviterName = url.searchParams.get('u') || '';
const iconParam = url.searchParams.get('i') || 'person.2.fill';
// `searchParams` ya decodifica; el segundo decode solo cubre enlaces doblemente codificados.
// Un `%` suelto lanzaba URIError y la página devolvía 500: se cae al valor tal cual.
const safeDecode = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};
const members = membersParam ? membersParam.split(',').map((m: string) => safeDecode(m.trim())).filter(Boolean) : [];

const pageTitle = inviterName
  ? t.invitePageTitleWithInviter.replace('{inviter}', inviterName).replace('{group}', groupName)
  : t.invitePageTitle.replace('{group}', groupName);
const pageDescription = t.invitePageDescription.replace('{group}', groupName);

const appStoreURL = 'https://apps.apple.com/pe/app/yala-finanzas-sin-esfuerzo/id6758253109';
const groupColor = `#${colorHex}`;

// Deep link scheme parametrized via env var (yaladev for dev/preview, yala for production).
const scheme = import.meta.env.PUBLIC_DEEP_LINK_SCHEME || 'yala';
const appDeepLink = shareParam ? `${scheme}://invite?s=${shareParam}` : null;

// SF Symbol → SVG path mapping (Lucide-inspired, 24x24 viewBox)
const sfSymbolSVGs: Record<string, string> = {
  // People
  'person.fill': '<path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4 0-8 1.8-8 4v2h16v-2c0-2.2-4-4-8-4Z"/>',
  'person.2.fill': '<path d="M16 14c2.5 0 7 1.3 7 3.5V20H9v-2.5c0-2.2 4.5-3.5 7-3.5Zm-8 0c-.3 0-.7 0-1 .1C8.9 15 10 16.2 10 17.5V20H2v-2.5C2 15.3 5.5 14 8 14Zm8-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM8 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>',
  'person.3.fill': '<path d="M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-7 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm14 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM12 14c-3.5 0-7 1.5-7 3.5V20h14v-2.5c0-2-3.5-3.5-7-3.5Zm-7.5.5c-.2 0-.3 0-.5.1C2 15 1 16 1 17v2h4v-2.5c0-.8.3-1.5.7-2Zm15 .1c-.2-.1-.3-.1-.5-.1.4.5.7 1.2.7 2V20h4v-3c0-1-1-2-3-2.4Z"/>',

  // Transport
  'airplane': '<path d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z"/>',
  'car.fill': '<path d="M18.9 6c-.2-.6-.8-1-1.4-1h-12c-.7 0-1.2.4-1.4 1L2 12v8a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-1h14v1a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-8l-2.1-6ZM6.5 16A1.5 1.5 0 1 1 8 14.5 1.5 1.5 0 0 1 6.5 16Zm10 0a1.5 1.5 0 1 1 1.5-1.5 1.5 1.5 0 0 1-1.5 1.5ZM5 11l1.5-4.5h10L18 11H5Z"/>',
  'bus.fill': '<path d="M4 16c0 .9.4 1.7 1 2.2V20a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-1h8v1a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-1.8c.6-.5 1-1.3 1-2.2V6c0-3.5-3.6-4-8-4S4 2.5 4 6v10Zm3.5 1a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm9 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3ZM5 10V6h14v4H5Z"/>',

