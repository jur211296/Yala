  'creditcard.fill': '<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 14H4v-6h16v6Zm0-10H4V6h16v2Z"/>',

  // Food
