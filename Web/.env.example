# Astro public env vars (PUBLIC_ prefix → exposed to client/SSR HTML).
# Copy to .env (or set in Vercel project) before build.

# Deep link scheme used by invite.astro for the "Open in Yala" CTA.
# - Use "yaladev" for Vercel preview deployments and dev (matches Yala Dev custom URL scheme).
# - Use "yala" for production releases (matches Yala App Store custom URL scheme).
# Universal links (https://yala-app.pe/invite?s=...) ignore this var — handled by AASA.
PUBLIC_DEEP_LINK_SCHEME=yala
