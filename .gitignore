# Xcode
DerivedData/
.deriveddata/
# `.ddp` es el `-derivedDataPath` que usan los pasos de build y test de
# .github/workflows/qa.yml, y toda corrida local que copie esos comandos. En el runner es
# efimero; en local son GB sin ignorar que un `git add -A` metia enteros en el repo.
.ddp/
build/
build_output.txt
build_output_*.txt
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
# SwiftPM
.swiftpm/
.spm/
.spm-cache/
# User-specific
.DS_Store
# Fastlane (si lo usas luego)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
# Logs
*.log

# Secrets (API keys)
Secrets.xcconfig
AuthKey_*.p8
AuthKey_*.p8.txt
.claude/sessions/*.log
.vercel
# App Store Connect API keys (never commit private keys)
AuthKey_*.p8
AuthKey_*.p8.txt
*.p8
# Private asc/ directory (App Store Connect local state)
.asc/

# ASC build artifacts
.asc/artifacts/

# Python caches
__pycache__/
*.pyc

# QA automation results (generated at runtime)
qa/results/

# Local scratch only (process + tickets live in docs/ and tickets/)
.planning/

# Agent skills (third-party, reinstall via: npx skills add)
.agents/
.claude/sessions/tests-passed
docs/modo-nube/briefs/
