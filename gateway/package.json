{
  "name": "yala-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gateway seguro de Yala: proxy a OpenAI + tasas de cambio con App Attest, entitlement Pro y rate-limit server-side.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@levischuck/tiny-cbor": "^0.2.11",
    "@peculiar/asn1-schema": "^2.8.0",
    "@peculiar/x509": "^1.14.3",
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "wrangler": "^4"
  }
}
