    { "id": "es-PE-03", "locale": "es-PE", "today": "2026-10-07", "defaultCurrency": "PEN", "text": "almuerzo 18 lucas en el menú de la esquina, con la etiqueta chamba",
      "extraExpense": ["Menús"],
