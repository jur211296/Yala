   "locale": "it-IT",
   "source": "fleurs:it_it",
   "member": "dev/10165734210172752151.wav",
   "text": "Nel giro di due ore sono esplose altre tre bombe nelle vicinanze degli edifici governativi.",
   "license": "CC BY 4.0",
