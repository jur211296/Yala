   "seconds": 12.96
  },
  {
   "clip": "fleurs-de_de-10128878214126221959",
   "locale": "de-DE",
   "source": "fleurs:de_de",
   "member": "dev/10128878214126221959.wav",
   "text": "Laut Polizei wird der Fahrer des Fahrzeugs, das den Fotografen angefahren hat, wahrscheinlich nicht angeklagt werden.",
   "license": "CC BY 4.0",
   "url": "https://huggingface.co/datasets/google/fleurs",
   "file": "real/fleurs-de_de-10128878214126221959.m4a",
   "seconds": 11.34
  },
  {
   "clip": "fleurs-de_de-10249467818655484680",
   "locale": "de-DE",
   "source": "fleurs:de_de",
   "member": "dev/10249467818655484680.wav",
   "text": "Der Amazonas ist auch der breiteste Fluss der Erde, teilweise bis zu sechs Meilen breit.",
   "license": "CC BY 4.0",
   "url": "https://huggingface.co/datasets/google/fleurs",
   "file": "real/fleurs-de_de-10249467818655484680.m4a",
   "seconds": 9.0
  },
  {
   "clip": "fleurs-de_de-10271331673746997728",
   "locale": "de-DE",
   "source": "fleurs:de_de",
   "member": "dev/10271331673746997728.wav",
   "text": "Die Wissenschaft weist nun darauf hin, dass diese massive Kohlenstoffwirtschaft die Biosphäre aus einem ihrer stabilen Zustände, der die menschliche Evolution in den letzten zwei Millionen Jahren getragen hat, herausgebracht hat.",
   "license": "CC BY 4.0",
   "url": "https://huggingface.co/datasets/google/fleurs",
   "file": "real/fleurs-de_de-10271331673746997728.m4a",
   "seconds": 12.36
  },
  {
