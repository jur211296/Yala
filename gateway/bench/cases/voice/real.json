   "locale": "de-DE",
   "source": "fleurs:de_de",
   "member": "dev/10277724703757163249.wav",
   "text": "Ein Kurs deckt alle hier diskutierten Probleme in der Regel viel detaillierter ab, normalerweise in Kombination mit praktischer Erfahrung.",
   "license": "CC BY 4.0",
   "url": "https://huggingface.co/datasets/google/fleurs",
   "file": "real/fleurs-de_de-10277724703757163249.m4a",
   "seconds": 15.48
  },
